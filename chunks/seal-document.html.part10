        a.href = voMakeObjectURL(list[0]);
        a.download = list[0].name || window._voShareName;
      } else {
        var entries = [];
        for (var i = 0; i < list.length; i++) entries.push({ name: list[i].name, bytes: list[i].voBytes });
        var base = String(window._voShareName || 'verum-omnis').replace(/\.[^.]+$/, '');
        a.href = URL.createObjectURL(voZipBundle(entries));
        a.download = base + '-verum-omnis-bundle.zip';
      }
      document.body.appendChild(a); a.click(); a.remove();
    } catch (e) {}
  }

  // Download the whole bundle (all sealed files), not just the document, so the
  // WebView / no-share path still hands over everything.
  function fallbackDownload(msg, files) {
    saveFiles((files && files.length) ? files : voShareFileList());
    if (msg) { hint.style.color = '#D4A843'; hint.textContent = msg; }
  }

  grid.insertBefore(btn, grid.firstChild);
  grid.parentNode.insertBefore(hint, grid.nextSibling);
}

// Page-level byte formatter (the inlined report script has its own fmtBytes
// inside its closure; it is not reachable from here).
function voFmtBytes(n) {
  if (typeof n !== 'number' || !isFinite(n)) return 'n/a';
  if (n < 1024) return n + ' B';
  if (n < 1024 * 1024) return (n / 1024).toFixed(1) + ' KB';
  return (n / 1024 / 1024).toFixed(2) + ' MB';
}
function showResults(sha256, sha512, sealId, otsResult, sealedBytes, meta, password, senderEmail, chain, encryptedBytes, forensicResult) {
  document.getElementById('sha256Display').textContent = sha256;
  document.getElementById('sha512Display').textContent = sha512;
  document.getElementById('sealIdDisplay').textContent = sealId;

  // Protected-input seals: state plainly that the file was sealed as-is, and
  // whether a requested new password was skipped (re-encrypting an encrypted
  // file corrupts it — honesty over silence).
  var asIsNoteEl = document.getElementById('asIsNote');
  if (asIsNoteEl) {
    if (!asIsNoteEl.dataset.baseHtml) asIsNoteEl.dataset.baseHtml = asIsNoteEl.innerHTML;
    asIsNoteEl.innerHTML = asIsNoteEl.dataset.baseHtml + (window._voNewPasswordSkipped
      ? ' <strong>The new password you entered was NOT applied</strong> &mdash; this file already has its own password, and re-encrypting a locked file would corrupt it. The document keeps its existing password.'
      : '');
    asIsNoteEl.style.display = window._voSealedAsIs ? 'block' : 'none';
  }

  // VO-SEAL2: show the sealed-file self-integrity hash when the new scheme
  // was applied (hidden for legacy-fallback seals — no such hash exists).
  var sealedHashRow = document.getElementById('sealedHashRow');
  if (window._voSealedFileHash && sealedHashRow) {
    document.getElementById('sealedHashDisplay').textContent = window._voSealedFileHash;
    sealedHashRow.style.display = 'block';
  } else if (sealedHashRow) { sealedHashRow.style.display = 'none'; }

  // Size, stated: the seal adds a watermark image, a QR and a footer to every
  // page — a few percent of the original. A sealed file far larger than its
  // original was not made so by the seal (the 88 MB annexure EB output came
  // from a 528-page scanned original), and the reader can see that here.
  // The report script's fmtBytes lives inside its own closure and is NOT
  // visible here (the 13 September hotfix: "fmtBytes is not defined" broke
  // every seal's results panel on the Worker for an hour). The page has its
  // own formatter, and nothing about the size line may ever stop the results.
  try {
    var sizeRow = document.getElementById('sizeRow');
    if (sizeRow) {
      var origSize = (typeof selectedFile !== 'undefined' && selectedFile && typeof selectedFile.size === 'number') ? selectedFile.size : null;
      var sealedSize = (sealedBytes && typeof sealedBytes.byteLength === 'number') ? sealedBytes.byteLength : (sealedBytes && sealedBytes.length) || null;
      if (sealedSize) {
        var sizeTxt = 'Sealed ' + voFmtBytes(sealedSize);
        if (origSize) sizeTxt = 'Original ' + voFmtBytes(origSize) + '  →  ' + sizeTxt + ' (' + (sealedSize >= origSize ? '+' : '−') + voFmtBytes(Math.abs(sealedSize - origSize)) + ' for the watermark, QR and footer on every page)';
        document.getElementById('sizeDisplay').textContent = sizeTxt;
        sizeRow.style.display = 'block';
      } else { sizeRow.style.display = 'none'; }
    }
  } catch (sizeErr) { console.warn('[VO] size line skipped:', sizeErr && sizeErr.message ? sizeErr.message : sizeErr); }

  // Show forensic report debug info if report wasn't generated
  if (window._voReportDebug && !window._voReportPack) {
    var debugPanel = document.createElement('div');
    debugPanel.style.cssText = 'background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.35);border-radius:12px;padding:20px;margin:16px 0;';
    var debugHTML = '<div style="color:#FF6B6B;font-weight:bold;margin-bottom:12px;">⚠ Forensic Report Not Generated</div>';
    debugHTML += '<div style="font-size:12px;color:#D5D8DD;font-family:monospace;line-height:1.6;">';
    debugHTML += 'sealMode="' + (window._voReportDebug.sealMode || 'undefined') + '" (expected: "forensic")<br>';
    debugHTML += 'VerumReport.build available: ' + window._voReportDebug.build_fn_available + '<br>';
    debugHTML += 'Findings count: ' + window._voReportDebug.findings_count + '<br>';
    debugHTML += 'AI review info: ' + JSON.stringify(window._voReportDebug.ai_review_info).substring(0,80) + '<br>';
    debugHTML += 'Stage: ' + (window._voReportDebug.stage || 'UNKNOWN') + '<br>';
    debugHTML += 'Timestamp: ' + window._voReportDebug.timestamp;
    debugHTML += '</div>';
    debugPanel.innerHTML = debugHTML;
    document.querySelector('.results') && document.querySelector('.results').appendChild(debugPanel);
  }

  // Forensic indicators panel (forensic analysis mode only) — deliberately
  // de-alarmed: neutral gold/navy presentation, "indicator" language throughout,
  // serial-pattern labels only with corroboration, and a standing disclaimer.
  if (forensicResult && !forensicResult.clean) {
    var findingsPanel = document.createElement('div');
    findingsPanel.id = 'findingsPanel';
    findingsPanel.style.cssText = 'background:rgba(15,52,96,0.12);border:1px solid rgba(212,168,67,0.35);border-radius:12px;padding:20px;margin:16px 0;';

    var findingsHtml = '';
    var categories = forensicResult.findingsByCategory || {};
    // Friendly category labels (raw engine keys like STATEMENTAL read as noise).
    var VO_CAT_LABEL = { STATEMENTAL: 'Conflicting statements & figures', IDENTITY: 'Identity & role conflicts', FINANCIAL: 'Financial conflicts', INTEGRITY: 'Document structure & integrity', CROSS_REF: 'Cross-reference checks', CONTACT: 'Contact & location', EVIDENCE: 'Evidence handling', DIGITAL: 'Digital forensics', FRANCHISE_LEASE: 'Franchise / lease contradictions', UNCATEGORISED: 'Uncategorised' };
    for (var cat in categories) {
      if (categories[cat].length > 0) {
        findingsHtml += '<strong style="color:#D4A843;">' + escapeHtml(VO_CAT_LABEL[cat] || cat) + ':</strong> ' + categories[cat].length + ' finding' + (categories[cat].length === 1 ? '' : 's') + '<br>';
      }
    }

    // Serial-pattern labels: shown only when corroborated (>=2 independent
    // severity>=3 findings); suppressed entirely when the AI classifier says the
    // document is ABOUT fraud; otherwise demoted to a muted weak-signals note.
    var classification = _pipelineClassification;
    var serialInfo = getSerialLabelInfo(forensicResult.findings, !!(classification && classification.aboutFraud === true));
    var classHtml = '';
    if (classification && classification.documentClass) {
      classHtml = '<strong>Document classification (AI):</strong> ' + escapeHtml(classification.documentClass) + '<br>';
    }
    var serialHtml = '';
    if (serialInfo.suppressed && serialInfo.serial.length > 0) {
      serialHtml = '<br><span style="color:#8ea3b5;font-size:12px;">This document discusses fraud or disputed conduct as its subject matter. Pattern labels have been suppressed to avoid mischaracterising the document\'s contents.</span><br>';
    } else {
      if (serialInfo.corroborated.length > 0) {
        serialHtml += '<br><strong style="color:#D4A843;">Patterns consistent with:</strong> ';
        for (var s = 0; s < serialInfo.corroborated.length; s++) {
          serialHtml += (s > 0 ? ', ' : '') + escapeHtml(serialNameOf(serialInfo.corroborated[s]));
        }
        serialHtml += '<br>';
      }
      if (serialInfo.weak.length > 0) {
        serialHtml += '<span style="color:#8ea3b5;font-size:12px;">Weak signals (insufficient corroboration to label): ';
        for (var s2 = 0; s2 < serialInfo.weak.length; s2++) {
          serialHtml += (s2 > 0 ? ', ' : '') + escapeHtml(serialNameOf(serialInfo.weak[s2]));
        }
        serialHtml += '</span><br>';
      }
    }

    findingsPanel.innerHTML = '<h4 style="color:#D4A843;font-size:17px;margin-bottom:10px;">&#128270; ' + (forensicResult.totalFindings || 0) + ' findings — stated as fact, anchored to the record</h4>' +
      '<p style="color:#D5D8DD;font-size:13px;line-height:1.7;">' +
      '<strong>Total findings:</strong> ' + forensicResult.totalFindings + '<br>' +
      '<strong>Contradiction types:</strong> ' + (forensicResult.contradictionTypesUsed || 0) + '/46 triggered<br>' +
      classHtml +
      findingsHtml + serialHtml +
      '<br><em>Each finding is stated as fact, anchored to the record; the verdict on any person is for the court. ' +
      'Your original document has been sealed pristine — no forensic markings were added to its pages. ' +
      'The seal proves integrity and time only. ' +
      'Full detail is presented in the sealed forensic report (download below).</em>' +
      '</p>';
    document.getElementById('results').insertBefore(findingsPanel, document.getElementById('results').firstChild);
  }

  const chainEl = document.getElementById('chainDisplay');
  if (chain && chain.length > 0 && chainEl) {
    const chainIds = chain.map(c => c.sealId).filter(id => id && id !== sealId);
    if (chainIds.length > 0) { chainEl.innerHTML = 'Contains content from: ' + chainIds.join(', '); chainEl.style.display = 'block'; document.getElementById('chainRow').style.display = 'block'; }
    else { document.getElementById('chainRow').style.display = 'none'; }
  } else if (chainEl) { document.getElementById('chainRow').style.display = 'none'; }

  let verifyUrl = 'https://verumglobal.foundation/verify.html?h=' + sha512.substring(0,32);
  try {
    var vChainIds = (chain || []).map(function(c) { return c.sealId; }).filter(function(id) { return id && id !== sealId; });
    verifyUrl += '&m=' + encodeURIComponent(utf8ToBase64(JSON.stringify(buildQrPayload(meta, vChainIds))));
  } catch(e) {}
  document.getElementById('verifyLink').href = verifyUrl;

  const el = document.getElementById('otsStatus');
  if (otsResult && otsResult.success) { el.className = 'ots-status complete'; el.innerHTML = '&#10003; OpenTimestamps proof received — Bitcoin confirmation pending (~1-2 hours)'; }
  else { el.className = 'ots-status error'; el.innerHTML = '&#9888; Calendar servers temporarily unavailable — SHA-256 recorded for retry.'; }

  const base = selectedFile.name.replace(/\.pdf$/i, '');
  const suffix = password ? '-protected' : '';
  // SEAL GUARD (VO-SG): the enforced exit. A document may only leave Verum if
  // it carries a real seal marker — "no seal = Verum Omnis never issued it".
  // This blocks the case where buildSealedPDF() hit its fallback and produced an
  // unmarked file: rather than hand the user a forgeable "-sealed.pdf" with no
  // seal, we refuse and make the failure loud. (Encrypted variants derive from
  // these same bytes, which are asserted here before any encryption ran.)
  const sL = document.getElementById('downloadSealedPdf');
  try {
    window.VoSealGuard.assertSealed(sealedBytes, base + '-sealed.pdf');
    const sU = voMakeObjectURL(new Blob([sealedBytes], {type: 'application/pdf'}));
    sL.href = sU; sL.download = base + suffix + '-sealed.pdf';
  } catch (guardErr) {
    console.error('[SEAL-GUARD] Refused to release an unsealed document:', guardErr && guardErr.message);
    sL.removeAttribute('href');
    sL.removeAttribute('download');
    sL.setAttribute('aria-disabled', 'true');
    sL.style.opacity = '0.5';
    sL.style.pointerEvents = 'none';
    sL.innerHTML = '&#9888; Sealing failed &mdash; download blocked (unsealed)';
    sL.onclick = function (e) { e.preventDefault(); return false; };
  }

  // Sealed forensic report download — only when generation succeeded
  var oldReportBtn = document.getElementById('downloadForensicReport');
  if (oldReportBtn) oldReportBtn.remove();
  var oldReportNote = document.getElementById('reportSealNote');
  if (oldReportNote) oldReportNote.remove();
  var oldShareNote = document.getElementById('patternShareNote');
  if (oldShareNote) oldShareNote.remove();
  if (window._voReportPack && window._voReportPack.bytes && window.VoSealGuard.isSealed(window._voReportPack.bytes)) {
    // SEAL GUARD (VO-SG): only offer the forensic report if it actually carries
    // a seal. An unsealed report is suppressed, never handed over.
    var rp = window._voReportPack;
    var rU = voMakeObjectURL(new Blob([rp.bytes], {type: 'application/pdf'}));
    var rL = document.createElement('a');
    rL.href = rU;
    rL.download = base + '-forensic-report-sealed.pdf';
    rL.className = 'download-btn';
    rL.id = 'downloadForensicReport';
    rL.innerHTML = '&#11015; Download Sealed Forensic Report';
    var dg = document.getElementById('downloadGrid');
    if (sL.nextSibling) dg.insertBefore(rL, sL.nextSibling); else dg.appendChild(rL);
    var rNote = document.createElement('div');
    rNote.id = 'reportSealNote';
    rNote.style.cssText = 'font-size:12px;color:#8ea3b5;margin-top:10px;line-height:1.6;';
    rNote.textContent = 'Forensic report sealed separately: ' + rp.sealId +
      '  |  SHA-512 ' + rp.sha512.substring(0, 16) + '...' +
      '  |  OpenTimestamps: ' + (rp.ots && rp.ots.success ? 'submitted — Bitcoin confirmation pending' : 'offline — hash recorded for retry');
    dg.parentNode.insertBefore(rNote, dg.nextSibling);
    // Court-ready narrative (human report) — same seal guard: only offered sealed.
    // (The separate plain-language narrative PDF was retired 2026-09-07; the
    // forensic report's Part 1 is the plain-language telling.)
    var oldHumanBtn = document.getElementById('downloadHumanReport');
    if (oldHumanBtn) oldHumanBtn.remove();
    if (window._voHumanReportPack && window._voHumanReportPack.bytes && window.VoSealGuard.isSealed(window._voHumanReportPack.bytes)) {
      var hp = window._voHumanReportPack;
      var hU = voMakeObjectURL(new Blob([hp.bytes], {type: 'application/pdf'}));
      var hL = document.createElement('a');
      hL.href = hU;
      hL.download = base + '-court-ready-narrative-sealed.pdf';
      hL.className = 'download-btn';
      hL.id = 'downloadHumanReport';
      hL.innerHTML = '&#11015; Download Court-Ready Narrative (AI-drafted, sealed)';
      var hAnchor = rL;
      if (hAnchor.nextSibling) dg.insertBefore(hL, hAnchor.nextSibling); else dg.appendChild(hL);
    }
  } else if (sealMode === 'forensic') {
    console.warn('Forensic report unavailable for this seal (generation skipped or failed); document seal is unaffected.');
  }

  // Findings JSON download (1verum GHRP contract v1.0.0) — the machine-readable
  // twin of the forensic report, consumable by the Verum Omnis app / G3 narrator.
  var oldFindingsBtn = document.getElementById('downloadFindingsJson');
  if (oldFindingsBtn) oldFindingsBtn.remove();
  if (window._voFindingsJson) {
    var fjU = voMakeObjectURL(new Blob(
      [JSON.stringify(window._voFindingsJson, null, 2)], { type: 'application/json' }));
    var fjL = document.createElement('a');
    fjL.href = fjU;
    fjL.download = base + '-findings.json';
    fjL.className = 'download-btn';
    fjL.id = 'downloadFindingsJson';
    fjL.innerHTML = '&#11015; Download Findings JSON (machine-readable)';
    var dgF = document.getElementById('downloadGrid');
    var after = document.getElementById('downloadForensicReport');
    if (after && after.nextSibling) dgF.insertBefore(fjL, after.nextSibling); else dgF.appendChild(fjL);
  }

  // Seal Certificate download (Seal Only mode) — clean one-page certificate
  var oldCertBtn = document.getElementById('downloadSealCertificate');
  if (oldCertBtn) oldCertBtn.remove();
  var oldCertNote = document.getElementById('sealCertNote');
  if (oldCertNote) oldCertNote.remove();
  var oldCertPrivBtn = document.getElementById('downloadSealCertificatePrivate');
  if (oldCertPrivBtn) oldCertPrivBtn.remove();
  if (window._voSealCert && window._voSealCert.bytes) {
    var cp = window._voSealCert;
    var cU = voMakeObjectURL(new Blob([cp.bytes], {type: 'application/pdf'}));
    var cL = document.createElement('a');
    cL.href = cU;
    cL.download = base + '-seal-certificate.pdf';
    cL.className = 'download-btn';
    cL.id = 'downloadSealCertificate';
    cL.innerHTML = '&#11015; Download Seal Certificate (shareable)';
    var dg2 = document.getElementById('downloadGrid');
    if (sL.nextSibling) dg2.insertBefore(cL, sL.nextSibling); else dg2.appendChild(cL);
    if (window._voSealCertPrivate && window._voSealCertPrivate.bytes) {
      var cpP = window._voSealCertPrivate;
      var cUP = voMakeObjectURL(new Blob([cpP.bytes], {type: 'application/pdf'}));
      var cLP = document.createElement('a');
      cLP.href = cUP;
      cLP.download = base + '-seal-certificate-PRIVATE-do-not-share.pdf';
      cLP.className = 'download-btn';
      cLP.id = 'downloadSealCertificatePrivate';
      cLP.innerHTML = '&#11015; Download PRIVATE Certificate (your records only)';
      if (cL.nextSibling) dg2.insertBefore(cLP, cL.nextSibling); else dg2.appendChild(cLP);
    }
    var cNote = document.createElement('div');
    cNote.id = 'sealCertNote';
    cNote.style.cssText = 'font-size:12px;color:#8ea3b5;margin-top:10px;line-height:1.6;';
    cNote.textContent = window._voSealCertPrivate
      ? 'This seal proves two things only — integrity and time. It is not a verification of the document\'s contents. The shareable certificate carries no personal details and is safe to file or forward. The PRIVATE certificate carries your identity, address and GPS location — keep it for your own records and never place it in a shared folder.'
      : 'This seal proves two things only — integrity and time. It is not a verification of the document\'s contents. Keep the Seal Certificate together with the sealed PDF.';
    dg2.parentNode.insertBefore(cNote, dg2.nextSibling);
    // A failed private build must be VISIBLE, never silently absent: the
    // shareable certificate promises the identity details were "recorded
    // privately by the sealer", and the private certificate IS that record.
    var oldPrivWarn = document.getElementById('sealCertPrivateWarn');
    if (oldPrivWarn) oldPrivWarn.remove();
    if (window._voSealCertPrivateFailed) {
      var pWarn = document.createElement('div');
      pWarn.id = 'sealCertPrivateWarn';
      pWarn.style.cssText = 'font-size:12px;color:#D4A843;margin-top:10px;line-height:1.6;';
      pWarn.textContent = 'Your PRIVATE certificate could not be generated this run — the custody record of your identity, address and GPS is missing. The seal and the shareable certificate are unaffected. Re-seal the document to retry, or keep your own note of the capture details.';
      cNote.parentNode.insertBefore(pWarn, cNote.nextSibling);
    }
  }

  if (password && encryptedBytes && window.VoSealGuard.isSealed(sealedBytes)) {
    // SEAL GUARD (VO-SG): the encrypted file's own marker is (correctly) sealed
    // inside the ciphertext, so we gate on the plaintext sealedBytes it derives
    // from — an unsealed original is never released, protected or not.
    var isPdfEnc = window._voEncFormat === 'pdf';
    if (isPdfEnc) {
      // The protected PDF is the prominent download — it is the copy you send.
      // The plain sealed PDF stays available as "your copy": its seal marker is
      // encrypted inside the protected file, so keeping the unlocked original
      // is what lets you verify the seal later without the password.
      sL.className = 'download-btn';
      sL.innerHTML = '&#11015; Sealed PDF — your copy (keep for verification)';
      var protL = document.createElement('a');
      protL.className = 'download-btn primary';
      protL.href = voMakeObjectURL(new Blob([encryptedBytes], { type: 'application/pdf' }));
      protL.download = base + '-sealed-protected.pdf';
      protL.setAttribute('download', base + '-sealed-protected.pdf');
      protL.innerHTML = '&#128274; Download Password-Protected PDF (send this)';
      sL.parentNode.insertBefore(protL, sL);
      window._voShareBytes = encryptedBytes;
      window._voShareName = base + '-sealed-protected.pdf';
      window._voShareType = 'application/pdf';
      // Message that travels WITH the file (WhatsApp/email/etc.) so the
      // RECIPIENT is told what it is and — critically — how to get the password.
      window._voShareText =
        // Said at sealing time, while the Bitcoin confirmation is pending: the
        // fingerprint is submitted for anchoring, and verify.html checks the
        // unprotected copy (it cannot open a password-protected file).
        'This document is sealed with Verum Omnis — a SHA-512 fingerprint, submitted to OpenTimestamps for anchoring to the Bitcoin blockchain, so any change to it is detectable. Once opened, the unprotected copy can be checked free (no account) at https://verumglobal.foundation/verify.html\n\n' +
        '🔒 This copy is password-protected. To open it, please request the password from the sender' +
        (senderEmail ? ' by emailing ' + senderEmail : '') + ' — the password is sent separately, never with the document.';
    } else {
      // Legacy .voice fallback (standard encryption unavailable).
      const downloadGrid = document.getElementById('downloadGrid');
      const encL = document.createElement('a');
      encL.href = voMakeObjectURL(new Blob([encryptedBytes], { type: 'application/octet-stream' }));
      encL.download = base + suffix + '-sealed.voice';
      encL.className = 'download-btn';
      encL.innerHTML = '&#11015; Download .VOICE (Encrypted)';
      if (sL.nextSibling) downloadGrid.insertBefore(encL, sL.nextSibling); else downloadGrid.appendChild(encL);
      window._voShareBytes = encryptedBytes;
      window._voShareName = base + suffix + '-sealed.voice';
      window._voShareType = 'application/octet-stream';
      window._voShareText =
        'This document is sealed with Verum Omnis (SHA-512 fingerprint + Bitcoin blockchain timestamp) and cannot be altered without detection.\n\n' +
        '🔒 It is password-protected. Open it at https://verumglobal.foundation/verify.html and enter the password — please request the password from the sender' +
        (senderEmail ? ' by emailing ' + senderEmail : '') + '.';
    }

    var banner = document.createElement('div');
    banner.style.cssText = 'background:rgba(212,168,67,0.1);border:1px solid rgba(212,168,67,0.3);border-radius:12px;padding:20px;margin:16px 0;font-size:13px;color:#D5D8DD;line-height:1.7;';
    banner.innerHTML = isPdfEnc
      ? '<strong style="color:#D4A843;font-size:16px;">&#128274; Password protection active — this is your read receipt</strong><br><br>' +
        'The file above is a normal password-protected PDF. Send it however you like — email, WhatsApp, any app. It opens in any PDF reader, but only after the password is entered.<br><br>' +
        '<strong>How the read receipt works:</strong><br>' +
        '1. Send the protected PDF to the recipient.<br>' +
        '2. They try to open it — their reader asks for a password.<br>' +
        '3. To get in, they must email you asking for it.<br>' +
        '<strong>4. That email is your proof a human received and opened it.</strong><br>' +
        '5. You reply with the password. Silence means it was never opened.<br><br>' +
        '<strong>Your password:</strong> <span style="color:#D4A843;font-family:monospace;">' + password + '</span><br>' +
        '<strong style="color:#ef4444;">Send the password in a separate message, never with the document.</strong>'
      : '<strong style="color:#D4A843;font-size:16px;">&#128272; Password protection active (.voice)</strong><br><br>' +
        'Standard PDF encryption was unavailable, so this is a .voice container. The recipient opens it at verumglobal.foundation/verify.html with the password.<br><br>' +
        '<strong>Your password:</strong> <span style="color:#D4A843;font-family:monospace;">' + password + '</span><br>' +
        '<strong style="color:#ef4444;">Send the password separately from the document.</strong>';
    el.parentNode.insertBefore(banner, el.nextSibling);
  } else if (window.VoSealGuard.isSealed(sealedBytes)) {
    // No password: the sealed PDF itself is the thing to share. SEAL GUARD
    // (VO-SG): only ever share a genuinely sealed document.
    window._voShareBytes = sealedBytes;
    window._voShareName = base + '-sealed.pdf';
    window._voShareType = 'application/pdf';
    window._voShareText =
      'This document is cryptographically sealed with Verum Omnis — a SHA-512 fingerprint, submitted to OpenTimestamps for anchoring to the Bitcoin blockchain. Any change to it is detectable, and once Bitcoin confirms the anchor it fixes the latest time by which the document existed. Anyone can check it free, no account needed, at https://verumglobal.foundation/verify.html';
  }

  // The whole bundle in one share. A password-protected forensic seal used to
  // share only the protected document; the founder's direction is that the
  // share sheet carries everything — sealed/protected document, the sealed
  // forensic report, and the machine-readable findings JSON — so nothing has
  // to be hunted down and attached separately.
  window._voShareFiles = [];
  if (window._voShareBytes) {
    window._voShareFiles.push({ bytes: window._voShareBytes, name: window._voShareName, type: window._voShareType });
  }
  if (window._voReportPack && window._voReportPack.bytes && window.VoSealGuard.isSealed(window._voReportPack.bytes)) {
    window._voShareFiles.push({ bytes: window._voReportPack.bytes, name: base + '-forensic-report-sealed.pdf', type: 'application/pdf' });
  }
  if (window._voHumanReportPack && window._voHumanReportPack.bytes && window.VoSealGuard.isSealed(window._voHumanReportPack.bytes)) {
    window._voShareFiles.push({ bytes: window._voHumanReportPack.bytes, name: base + '-court-ready-narrative-sealed.pdf', type: 'application/pdf' });
  }
  if (window._voFindingsJson) {
    try {
      window._voShareFiles.push({
        bytes: new TextEncoder().encode(JSON.stringify(window._voFindingsJson, null, 2)),
        name: base + '-findings.json', type: 'application/json'
      });
    } catch (e) {}
  }

  // Native share (Web Share API) — on a phone this opens the system share
  // sheet (WhatsApp, email, Drive, …); where file sharing is unsupported it
  // hides itself so nothing appears broken.
  addShareButton();

  // Blockchain receipt (.ots) — the "little slip": a VALID OpenTimestamps
  // pending receipt the user keeps and upgrades later on the verify page.
  // Preferred content: the calendar-issued timestamp fragment (byte-identical
  // to what `ots stamp` embeds) wrapped in the detached-file header; fallback:
  // a locally built receipt with a PendingAttestation naming the calendar that
  // accepted the digest. No button at all when the submission failed or the
  // proof module is unavailable — never a broken or fake receipt.
  var otsBtn = document.getElementById('downloadOts');
  var otsNote = document.getElementById('otsReceiptNote');
  var anchorBtn = document.getElementById('downloadAnchorCert');
  if (otsResult && otsResult.success && window.VoOts) {
    var receiptBytes = null;
    try {
      if (otsResult.proof && otsResult.proof.length > 0) {
        var candidate = VoOts.buildFileFromFragment(meta.otsDigest, otsResult.proof);
        var probe = VoOts.parseSummary(candidate);
        if (probe.valid && probe.attestations.some(function(a) { return a.type === 'pending'; })) receiptBytes = candidate;
      }
    } catch (fragErr) { receiptBytes = null; }
    if (!receiptBytes) {
      try { receiptBytes = VoOts.buildPendingReceipt(meta.otsDigest, [otsResult.calendar]); }
      catch (pendErr) { receiptBytes = null; }
    }
    if (receiptBytes) {
      const oU = voMakeObjectURL(new Blob([receiptBytes], {type: 'application/vnd.opentimestamps.v1'}));
      otsBtn.href = oU; otsBtn.download = base + '-' + sealId + '.ots'; otsBtn.style.display = 'block';
      if (otsNote) otsNote.style.display = 'block';
    } else {
      otsBtn.style.display = 'none';
      if (otsNote) otsNote.style.display = 'none';
    }
  } else {
    otsBtn.style.display = 'none';
    if (otsNote) otsNote.style.display = 'none';
  }
  if (anchorBtn) {
    if (window._voAnchorCert && window._voAnchorCert.bytes) {
      const aU = voMakeObjectURL(new Blob([window._voAnchorCert.bytes], {type: 'application/pdf'}));
      anchorBtn.href = aU; anchorBtn.download = base + '-' + sealId + '-anchor-certificate.pdf'; anchorBtn.style.display = 'block';
    } else {
      anchorBtn.style.display = 'none';
    }
  }

  document.getElementById('results').classList.add('visible');
  document.getElementById('results').scrollIntoView({behavior:'smooth'});
}

function resetSealing() {
  document.getElementById('results').classList.remove('visible');
  document.getElementById('pipeline').classList.remove('visible');
  for (let i = 1; i <= 8; i++) updateStep(i, 'pending', '');
  updateStep('Fraud', 'pending', '');
  document.getElementById('sealBtn').disabled = false;
  _pipelineFraudResult = null;
  _pipelinePageCount = 0;
  _pipelineAiAddedFindings = [];
  _pipelineAiNotes = [];
  _pipelineClassification = null;
  _pipelineTextSample = '';
  _pipelineTextBlocks = null;
  _voUnreadPages = null;
  _voOcrRescuedPages = null;
  _voOcrConfidence = null;
  window._voReportPack = null;
  window._voNarrativePack = null;
  window._voHumanReportPack = null;
  window._voSealedFileHash = null;
  var sealedHashRowR = document.getElementById('sealedHashRow');
  if (sealedHashRowR) sealedHashRowR.style.display = 'none';
  window._voSealCert = null;
  window._voSealCertPrivate = null;
  window._voSealCertPrivateFailed = false;
  window._voAnchorCert = null;
  var anchorBtnR = document.getElementById('downloadAnchorCert');
  if (anchorBtnR) anchorBtnR.style.display = 'none';
  var otsNoteR = document.getElementById('otsReceiptNote');
  if (otsNoteR) otsNoteR.style.display = 'none';
  var gkBanner = document.getElementById('gatekeepBanner');
  if (gkBanner) gkBanner.style.display = 'none';
  var oldReportBtn2 = document.getElementById('downloadForensicReport');
  if (oldReportBtn2) oldReportBtn2.remove();
  var oldReportNote2 = document.getElementById('reportSealNote');
  if (oldReportNote2) oldReportNote2.remove();
  var oldHumanBtn2 = document.getElementById('downloadHumanReport');
  if (oldHumanBtn2) oldHumanBtn2.remove();
  var oldShareNote2 = document.getElementById('patternShareNote');
  if (oldShareNote2) oldShareNote2.remove();
  var oldCertBtn2 = document.getElementById('downloadSealCertificate');
  if (oldCertBtn2) oldCertBtn2.remove();
  var oldCertNote2 = document.getElementById('sealCertNote');
  if (oldCertNote2) oldCertNote2.remove();
  var oldPanel = document.getElementById('findingsPanel');
  if (oldPanel) oldPanel.remove();
  // Samsung Browser fix: use var not const
  var banners = document.querySelectorAll('[style*="background:rgba(212,168,67"]');
  banners.forEach(function(b) { if (b.id !== 'gatekeepBanner') b.remove(); });
  // Also remove fraud warning banners on reset
  var fraudBanners = document.querySelectorAll('[style*="background:rgba(239,68,68"]');
  fraudBanners.forEach(function(b) { b.remove(); });
  var downloadGrid = document.getElementById('downloadGrid');
  if (downloadGrid) {
    downloadGrid.style.gridTemplateColumns = '';
    var voiceBtns = downloadGrid.querySelectorAll('a[download$=".voice"]');
    voiceBtns.forEach(function(b) { b.remove(); });
  }
}

function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }
</script>
