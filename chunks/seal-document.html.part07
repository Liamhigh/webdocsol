    var flags = dv.getUint16(p + 8, true), method = dv.getUint16(p + 10, true);
    var dTime = dv.getUint16(p + 12, true), dDate = dv.getUint16(p + 14, true);
    var csize = dv.getUint32(p + 20, true), usize = dv.getUint32(p + 24, true);
    var nlen = dv.getUint16(p + 28, true), xlen = dv.getUint16(p + 30, true), clen = dv.getUint16(p + 32, true);
    var lho = dv.getUint32(p + 42, true);
    var name = dec.decode(u8.subarray(p + 46, p + 46 + nlen));
    p += 46 + nlen + xlen + clen;
    entries.push({ name: name, encrypted: !!(flags & 0x1), method: method, csize: csize, usize: usize, lho: lho, lastModified: voDosDateToMs(dTime, dDate) });
  }
  var out = [];
  for (var k = 0; k < entries.length; k++) {
    var en = entries[k];
    if (en.name.slice(-1) === '/' || /(^|\/)(__MACOSX\/|\.)/.test(en.name)) continue; // folders, macOS cruft, dotfiles
    var base = en.name.split('/').pop();
    if (en.encrypted) { out.push({ name: base, skipped: 'password-protected' }); continue; }
    if (en.usize > VO_ZIP_MAX_ENTRY) { out.push({ name: base, skipped: 'larger than 200 MB' }); continue; }
    if (en.lho + 30 > n || dv.getUint32(en.lho, true) !== 0x04034b50) { out.push({ name: base, skipped: 'damaged entry' }); continue; }
    var lnlen = dv.getUint16(en.lho + 26, true), lxlen = dv.getUint16(en.lho + 28, true);
    var start = en.lho + 30 + lnlen + lxlen;
    if (start + en.csize > n) { out.push({ name: base, skipped: 'truncated entry' }); continue; }
    var raw = u8.subarray(start, start + en.csize), bytes;
    if (en.method === 0) bytes = raw.slice();
    else if (en.method === 8) { try { bytes = await voInflateRaw(raw); } catch (ie) { out.push({ name: base, skipped: ie.message }); continue; } }
    else { out.push({ name: base, skipped: 'unsupported compression' }); continue; }
    if (en.usize && bytes.length !== en.usize) { out.push({ name: base, skipped: 'size mismatch after unpacking' }); continue; }
    out.push({ name: base, path: en.name, bytes: bytes, lastModified: en.lastModified });
  }
  return out;
}
// Expand any .zip in a selection into the files it holds (on-device). Returns
// the flat list plus one plain-language note per archive for the file panel.
async function voExpandZips(fileList) {
  var files = Array.prototype.slice.call(fileList), out = [], notes = [], sawZip = false;
  for (var i = 0; i < files.length; i++) {
    var f = files[i];
    if (!voIsZipFile(f)) { out.push(f); continue; }
    sawZip = true;
    var entries;
    try { entries = await voUnzip(await f.arrayBuffer()); }
    catch (ze) { notes.push(f.name + ': could not be unpacked (' + (ze && ze.message ? ze.message : 'unreadable') + ')'); continue; }
    var kept = 0, unused = [];
    for (var j = 0; j < entries.length; j++) {
      var en = entries[j];
      if (en.skipped) { unused.push(en.name + ' — ' + en.skipped); continue; }
      if (!VO_ZIP_KEEP_RE.test(en.name)) { unused.push(en.name); continue; }
      out.push(new File([en.bytes], en.name, { type: voMimeFor(en.name), lastModified: en.lastModified || f.lastModified || 0 }));
      kept++;
    }
    notes.push(f.name + ': ' + kept + ' file' + (kept === 1 ? '' : 's') + ' unpacked on this device (nothing was uploaded)' +
      (unused.length ? '. Not used: ' + unused.slice(0, 6).join(', ') + (unused.length > 6 ? ' and ' + (unused.length - 6) + ' more' : '') : '') + '.');
  }
  return { files: out, notes: notes, sawZip: sawZip };
}
function voShowZipNote(notes) {
  var el = document.getElementById('zipNote');
  if (!el) return;
  if (!notes || !notes.length) { el.style.display = 'none'; el.textContent = ''; return; }
  el.textContent = notes.join(' ');
  el.style.display = 'block';
}
// Entry point for every selection (picker or drop): archives are expanded
// first; a chat export that holds voice notes AND documents becomes a
// voice-note batch, and its documents are named in the note for a separate
// seal — the intake below refuses to guess at a mixed seal. Selections are
// queued, so a later one never lands before an earlier one still unpacking.
var voIntakeQueue = Promise.resolve();
function voAddFiles(fileList) {
  var files = Array.prototype.slice.call(fileList); // copied now: the picker is cleared right after
  voIntakeQueue = voIntakeQueue.then(function () { return voAddFilesQueued(files); });
}
function voAddFilesQueued(fileList) {
  return voExpandZips(fileList).then(function (x) {
    var files = x.files, notes = x.notes;
    if (x.sawZip) {
      var hasAudio = files.some(function (f) { return voIsAudioFile(f) || voIsVideoFile(f); }) || selectedAudioFiles.length > 0;
      if (hasAudio) {
        var docs = files.filter(function (f) { return /\.pdf$/i.test(f.name) || f.type === 'application/pdf'; });
        if (docs.length) {
          files = files.filter(function (f) { return docs.indexOf(f) < 0; });
          notes.push('Documents in the export are not part of a voice-note batch — seal them separately: ' + docs.map(function (d) { return d.name; }).slice(0, 6).join(', ') + (docs.length > 6 ? ' and ' + (docs.length - 6) + ' more' : '') + '.');
        }
      }
    }
    // Photos with no voice note in the batch are documents: each is placed on
    // its own PDF page (the original bytes and their SHA-512 recorded on it)
    // and joins the PDF bundle, where on-device OCR reads it.
    var audioBatch = selectedAudioFiles.length > 0 || files.some(function (f) { return voIsAudioFile(f) || voIsVideoFile(f); });
    if (audioBatch) return { files: files, notes: notes };
    return voPhotosToPdfs(files).then(function (y) { return { files: y.files, notes: notes.concat(y.notes) }; });
  }).then(function (r) {
    voShowZipNote(r.notes);
    if (r.files.length) voAddFilesNow(r.files);
  }).catch(function (err) {
    alert('Could not read the selection: ' + (err && err.message ? err.message : 'unknown error'));
  });
}

// EXIF orientation (tag 0x0112) read from a TIFF header at offset t; 1 when
// absent or unreadable.
function voTiffOrientation(u8, t) {
  if (t + 8 > u8.length) return 1;
  var le = u8[t] === 0x49;
  var r16 = function (o) { return le ? (u8[o] | (u8[o + 1] << 8)) : ((u8[o] << 8) | u8[o + 1]); };
  var r32 = function (o) { return le ? ((u8[o] | (u8[o + 1] << 8) | (u8[o + 2] << 16)) + u8[o + 3] * 16777216) : (u8[o] * 16777216 + ((u8[o + 1] << 16) | (u8[o + 2] << 8) | u8[o + 3])); };
  var ifd = t + r32(t + 4);
  if (ifd + 2 > u8.length) return 1;
  var n = r16(ifd);
  for (var k = 0; k < n; k++) {
    var e = ifd + 2 + k * 12;
    if (e + 10 > u8.length) return 1;
    if (r16(e) === 0x0112) { var v = r16(e + 8); return (v >= 1 && v <= 8) ? v : 1; }
  }
  return 1;
}
// EXIF orientation of a JPEG (APP1 "Exif") or a PNG (eXIf chunk); 1 otherwise.
function voJpegOrientation(u8) {
  if (u8.length > 8 && u8[0] === 0x89 && u8[1] === 0x50 && u8[2] === 0x4E && u8[3] === 0x47) {
    var q = 8;
    while (q + 8 <= u8.length) {
      var clen = u8[q] * 16777216 + ((u8[q + 1] << 16) | (u8[q + 2] << 8) | u8[q + 3]);
      var ty = String.fromCharCode(u8[q + 4], u8[q + 5], u8[q + 6], u8[q + 7]);
      if (ty === 'eXIf') return voTiffOrientation(u8, q + 8);
      if (ty === 'IDAT' || ty === 'IEND') return 1;
      q += 12 + clen;
    }
    return 1;
  }
  if (u8.length < 4 || u8[0] !== 0xFF || u8[1] !== 0xD8) return 1;
  var i = 2;
  while (i + 4 < u8.length) {
    if (u8[i] !== 0xFF) return 1;
    var mk = u8[i + 1], len = (u8[i + 2] << 8) | u8[i + 3];
    if (mk === 0xDA || mk === 0xD9) return 1;
    if (mk === 0xE1 && i + 10 < u8.length && u8[i + 4] === 0x45 && u8[i + 5] === 0x78 && u8[i + 6] === 0x69 && u8[i + 7] === 0x66) return voTiffOrientation(u8, i + 10);
    i += 2 + len;
  }
  return 1;
}
// The PDF matrix [a b c d e f] that draws the stored picture (unit square)
// upright into the box x..x+dw, y..y+dh for EXIF orientation o (1-8), mirror
// images included.
function voOrientMatrix(o, x, y, dw, dh) {
  switch (o) {
    case 2: return [-dw, 0, 0, dh, x + dw, y];
    case 3: return [-dw, 0, 0, -dh, x + dw, y + dh];
    case 4: return [dw, 0, 0, -dh, x, y + dh];
    case 5: return [0, -dh, -dw, 0, x + dw, y + dh];
    case 6: return [0, -dh, dw, 0, x, y + dh];
    case 7: return [0, dh, dw, 0, x, y];
    case 8: return [0, dh, -dw, 0, x + dw, y];
    default: return [dw, 0, 0, dh, x, y];
  }
}
// One photo (PNG/JPEG) on one PDF page. The JPEG bytes are embedded unchanged
// (a PNG is re-compressed losslessly by pdf-lib); the page shows the picture
// as the camera meant it (EXIF orientation applied) and, beneath it, the file name and the
// SHA-512 of the original file, so the sealed page names the photo it carries.
async function voPhotoToPdf(file) {
  var PDFLibRef = window.PDFLib;
  if (!PDFLibRef || !PDFLibRef.PDFDocument) throw new Error('PDF engine not loaded');
  var bytes = new Uint8Array(await voReadFileBytes(file));
  var isPng = bytes.length > 8 && bytes[0] === 0x89 && bytes[1] === 0x50 && bytes[2] === 0x4E && bytes[3] === 0x47;
  var isJpg = bytes.length > 3 && bytes[0] === 0xFF && bytes[1] === 0xD8;
  if (!isPng && !isJpg) throw new Error('not a PNG or JPEG picture');
  var sha = await computeSHA512(bytes);
  var doc = await PDFLibRef.PDFDocument.create();
  var img = isPng ? await doc.embedPng(bytes) : await doc.embedJpg(bytes);
  var orient = voJpegOrientation(bytes);
  var quarter = orient >= 5; // 5-8: the stored picture is on its side
  var w0 = img.width, h0 = img.height;
  var vw = quarter ? h0 : w0, vh = quarter ? w0 : h0; // upright size
  var PW = 595.28, M = 18, CAP = 30, maxW = PW - 2 * M, maxH = 841.89 - 2 * M - CAP;
  var sc = Math.min(maxW / vw, maxH / vh);
  var dw = vw * sc, dh = vh * sc, PH = dh + 2 * M + CAP;
  var page = doc.addPage([PW, PH]);
  var m = voOrientMatrix(orient, (PW - dw) / 2, M + CAP, dw, dh);
  page.node.setXObject(PDFLibRef.PDFName.of('VoPhoto'), img.ref);
  page.pushOperators(PDFLibRef.pushGraphicsState(),
    PDFLibRef.concatTransformationMatrix(m[0], m[1], m[2], m[3], m[4], m[5]),
    PDFLibRef.drawObject('VoPhoto'), PDFLibRef.popGraphicsState());
  var f1 = await doc.embedFont(PDFLibRef.StandardFonts.Helvetica);
  var f2 = await doc.embedFont(PDFLibRef.StandardFonts.Courier);
  var nm = String(file.name).replace(/[^\x20-\x7E]/g, '?');
  if (nm.length > 90) nm = nm.slice(0, 87) + '...';
  page.drawText('Photo: ' + nm + ' (' + bytes.length + ' bytes' + ')', { x: M, y: M + 13, size: 7, font: f1 });
  page.drawText('Original file SHA-512: ' + sha, { x: M, y: M + 3, size: 5.6, font: f2 });
  try { doc.setTitle('Photo ' + nm); doc.setSubject('Original file SHA-512 ' + sha); } catch (e) {}
  var out = await doc.save({ useObjectStreams: true });
  var base = String(file.name).replace(/\.[^.]*$/, '') || 'photo';
  return new File([out], base + '.photo.pdf', { type: 'application/pdf', lastModified: file.lastModified || 0 });
}
// Convert every photo in a selection to a one-page PDF (other files pass
// through). A photo that cannot be read is named in the panel note.
async function voPhotosToPdfs(files) {
  var out = [], notes = [], done = 0, failed = [];
  for (var i = 0; i < files.length; i++) {
    var f = files[i];
    if (!(VO_SCREENSHOT_RE.test(f.name) || /^image\/(png|jpe?g)$/.test(f.type))) { out.push(f); continue; }
    try { out.push(await voPhotoToPdf(f)); done++; }
    catch (e) { failed.push(f.name + ' (' + (e && e.message ? e.message : 'unreadable') + ')'); }
  }
  if (done) notes.push(done + ' photo' + (done === 1 ? ' was' : 's were') + ' placed on ' + (done === 1 ? 'a PDF page' : 'PDF pages (one page each)') + ' on this device, to be sealed as documents; each page records the original file’s SHA-512.');
  if (failed.length) notes.push('Could not use: ' + failed.join(', ') + '. Only PNG and JPEG pictures can be sealed.');
  return { files: out, notes: notes };
}

// Add PDFs to the bundle (deduped by name+size), enforcing a total-size cap.
// A single file behaves exactly as before; two or more are merged at seal time.
function voAddFilesNow(fileList) {
  var added = 0, rejected = [];
  // Audio routes to its own batch path. Mixing audio and PDFs in one seal is
  // refused rather than guessed at: a PDF bundle merges into ONE document,
  // audio seals as N individual as-is files — silently doing both from one
  // button would produce artifacts the user did not ask for.
  var audioIn = [], pdfIn = [], txtIn = [], shotIn = [];
  for (var ai = 0; ai < fileList.length; ai++) {
    var fi = fileList[ai];
    if (voIsAudioFile(fi) || voIsVideoFile(fi)) audioIn.push(fi);
    else if (/\.txt$/i.test(fi.name)) txtIn.push(fi);
    else if (VO_SCREENSHOT_RE.test(fi.name) || /^image\/(png|jpe?g)$/.test(fi.type)) shotIn.push(fi);
    else pdfIn.push(fi);
  }
  var audioMode = audioIn.length || selectedAudioFiles.length;
  if ((audioMode && (pdfIn.length || selectedFiles.length)) ||
      (pdfIn.length === fileList.length && selectedAudioFiles.length)) {
    alert('Seal documents and voice notes separately: a PDF bundle merges into one sealed document, while each audio file is sealed as-is with its own certificate.');
    return;
  }
  if (audioMode) {
    for (var au = 0; au < audioIn.length; au++) {
      var af = audioIn[au];
      if (selectedAudioFiles.some(function (x) { return x.name === af.name && x.size === af.size; })) continue;
      if (selectedAudioFiles.length >= VO_AUDIO_MAX_FILES) { alert('Up to ' + VO_AUDIO_MAX_FILES + ' voice notes per batch — seal the rest in a second batch.'); break; }
      if (af.size > 200 * 1024 * 1024) { alert(af.name + ' is larger than 200 MB — seal it on its own through a desktop browser; the phone ZIP bundle cannot hold it.'); continue; }
      selectedAudioFiles.push(af);
    }
    if (txtIn.length) voManifestFile = txtIn[txtIn.length - 1]; // one manifest; latest wins
    for (var sh = 0; sh < shotIn.length && voScreenshotFiles.length < 25; sh++) {
      var sf = shotIn[sh];
      if (!voScreenshotFiles.some(function (x) { return x.name === sf.name && x.size === sf.size; })) voScreenshotFiles.push(sf);
    }
    voRenderAudioFiles();
    return;
  }
  if (txtIn.length) {
    alert('A chat export (.txt) goes with a voice-note batch — add the voice notes first. To seal the chat text on its own, save or print it as a PDF.');
    if (!pdfIn.length) return;
    fileList = pdfIn;
  }
  for (var i = 0; i < fileList.length; i++) {
    var f = fileList[i];
    var isPdf = f.type === 'application/pdf' || /\.pdf$/i.test(f.name);
    if (!isPdf) { rejected.push(f.name + ' (not a PDF)'); continue; }
    if (selectedFiles.some(function (x) { return x.name === f.name && x.size === f.size; })) continue; // dedupe
    selectedFiles.push(f);
    added++;
  }
  var total = selectedFiles.reduce(function (s, x) { return s + x.size; }, 0);
  if (total > VO_BUNDLE_MAX_BYTES) {
    // Roll back the just-added files that pushed it over, newest first.
    while (selectedFiles.length && selectedFiles.reduce(function (s, x) { return s + x.size; }, 0) > VO_BUNDLE_MAX_BYTES) {
      selectedFiles.pop();
    }
    alert('Bundle exceeds the 50MB total limit. Some files were not added — remove one, or seal in smaller bundles.');
  }
  if (rejected.length) alert('Skipped: ' + rejected.join(', '));
  voRenderFiles();
}

function voRemoveFile(idx) {
  selectedFiles.splice(idx, 1);
  window._voSelectedIsProtected = false;
  document.getElementById('protectedNote').style.display = 'none';
  voRenderFiles();
  // Re-check the single remaining file for password protection.
  if (selectedFiles.length === 1) voCheckProtectedOnSelect(selectedFiles[0]);
}
window.voRemoveFile = voRemoveFile;

// Render the current bundle and keep `selectedFile` pointing at the first file
// (naming/preview) until the merge at seal time replaces it with the bundle.
function voRenderFiles() {
  var info = document.getElementById('fileInfo');
  var list = document.getElementById('fileList');
  var total = selectedFiles.reduce(function (s, x) { return s + x.size; }, 0);
  if (selectedFiles.length === 0) {
    selectedFile = null;
    info.classList.remove('visible');
    list.innerHTML = '';
    document.getElementById('fileName').textContent = '';
    document.getElementById('fileSize').textContent = '';
    document.getElementById('sealBtn').disabled = true;
    return;
  }
  selectedFile = selectedFiles[0];
  info.classList.add('visible');
  document.getElementById('sealBtn').disabled = false;
  if (selectedFiles.length === 1) {
    document.getElementById('fileName').textContent = selectedFiles[0].name;
    document.getElementById('fileSize').textContent = (total / 1024 / 1024).toFixed(2) + ' MB';
    list.innerHTML = '';
  } else {
    document.getElementById('fileName').textContent = selectedFiles.length + ' documents — sealed & analysed as one bundle';
    document.getElementById('fileSize').textContent = (total / 1024 / 1024).toFixed(2) + ' MB total';
    var rows = selectedFiles.map(function (f, i) {
      return '<div style="display:flex;justify-content:space-between;gap:12px;padding:3px 0;">' +
        '<span>' + (i + 1) + '. ' + escapeHtml(f.name) + ' <span style="color:#4A7EC7;">(' + (f.size / 1024 / 1024).toFixed(2) + ' MB)</span></span>' +
        '<button type="button" onclick="voRemoveFile(' + i + ')" style="background:none;border:none;color:#ef4444;cursor:pointer;font-size:14px;line-height:1;">&#10005;</button>' +
        '</div>';
    }).join('');
    list.innerHTML = rows +
      '<div style="margin-top:8px;color:#8ea3b5;font-size:12px;">Documents are merged in this order into one sealed bundle. Password-protected files cannot be merged — seal those individually.</div>';
  }
}

// Merge selected PDFs into one bundle (pdf-lib). Returns Uint8Array bytes.
// Throws with a clear message if a file is encrypted (cannot be merged) or
// otherwise unreadable, so the pipeline surfaces it instead of failing opaquely.
// Read a File to a Uint8Array robustly. Browsers can throw NotReadableError on
// File.arrayBuffer() for large files (memory pressure) or when the underlying
// OS handle went stale after the reference was picked. We retry once via the
// older FileReader API (a different code path that often succeeds where the
// Blob promise API failed) before giving up with an actionable message.
// Only these failures are worth a second attempt via FileReader — they are the
// transient / large-file read errors where the Blob promise API and the older
// FileReader API can disagree. A genuinely unexpected error (e.g. a TypeError
// from a bad argument) is surfaced immediately rather than silently retried.
function voIsTransientReadError(err) {
  if (!err) return false;
  if (typeof DOMException !== 'undefined' && err instanceof DOMException) return true;
  var name = err.name || '';
  return name === 'NotReadableError' || name === 'NotFoundError' || name === 'SecurityError';
}

async function voReadFileBytes(file) {
  var e1;
  try {
    return new Uint8Array(await file.arrayBuffer());
  } catch (err) {
    e1 = err;
    if (!voIsTransientReadError(e1)) {
      // Unexpected failure: don't mask it behind the FileReader path.
      throw new Error('Could not read "' + file.name + '": ' + ((e1 && e1.message) || e1), { cause: e1 });
    }
  }
  try {
    var buf = await new Promise(function (resolve, reject) {
      var fr = new FileReader();
      fr.onload = function () { resolve(fr.result); };
      fr.onerror = function () { reject(fr.error || new Error('read error')); };
      fr.onabort = function () { reject(new Error('read aborted')); };
      fr.readAsArrayBuffer(file);
    });
    return new Uint8Array(buf);
  } catch (e2) {
    var mb = (file.size / (1024 * 1024)).toFixed(1);
    // Keep the low-level names in the message and the errors as `cause`, so the
    // friendly text stays readable while logs retain the underlying failure.
    var codes = [e1 && e1.name, e2 && e2.name].filter(Boolean).join('/');
    throw new Error('Could not read "' + file.name + '" (' + mb + ' MB). The file may have been moved or renamed since you selected it, or it is too large for your browser to hold in memory alongside the others. Re-select it fresh, close other tabs, or seal it on its own.' + (codes ? ' [' + codes + ']' : ''), { cause: e2 });
  }
}

async function voMergeBundle(files) {
  var PDFLibRef = window.PDFLib;
  if (!PDFLibRef || !PDFLibRef.PDFDocument) throw new Error('PDF engine not loaded; cannot merge the bundle.');
  var out = await PDFLibRef.PDFDocument.create();
  for (var i = 0; i < files.length; i++) {
    var bytes = await voReadFileBytes(files[i]);
    var src;
    try {
      src = await PDFLibRef.PDFDocument.load(bytes, { ignoreEncryption: false });
    } catch (e) {
      throw new Error('Could not merge "' + files[i].name + '" — it may be password-protected or damaged. Remove the password (print it to a new PDF) or seal it on its own.');
    }
    var pages = await out.copyPages(src, src.getPageIndices());
    for (var p = 0; p < pages.length; p++) out.addPage(pages[p]);
    // Release the source document + raw bytes before reading the next file so
    // peak memory stays near one source doc, not the whole bundle at once.
    src = null; bytes = null; pages = null;
  }
  try { out.setTitle('Verum Omnis Evidence Bundle (' + files.length + ' documents)'); } catch (e) {}
  // Object streams pack the merged PDF far more compactly, keeping the sealed
  // bundle small enough to hold, encrypt, and download on memory-tight devices.
  return await out.save({ useObjectStreams: true });
}

document.getElementById('uploadZone').addEventListener('click', () => document.getElementById('fileInput').click());
document.getElementById('fileInput').addEventListener('change', (e) => {
  if (e.target.files.length > 0) voAddFiles(e.target.files);
  e.target.value = ''; // allow re-selecting the same file after a remove
});
['dragover','dragleave','drop'].forEach(evt => {
  document.getElementById('uploadZone').addEventListener(evt, (e) => {
    e.preventDefault();
    e.currentTarget.classList.toggle('dragover', evt === 'dragover');
    if (evt === 'drop' && e.dataTransfer.files.length > 0) voAddFiles(e.dataTransfer.files);
  });
});

function setSealType(type) {
  sealType = type;
  document.querySelectorAll('.seal-type button').forEach(btn => btn.classList.toggle('active', btn.dataset.type === type));
  document.getElementById('clientField').classList.toggle('visible', type === 'commercial');
}

// ==================== SEALING MODE ====================
// 'seal-only' (DEFAULT): tamper protection only — no forensic scan, no score,
// no findings; outputs are the pristine sealed PDF + a one-page Seal Certificate.
// 'forensic': full pipeline — on-device forensic scan, indicator score, optional
// AI review, sealed original + sealed forensic report.
let sealMode = 'seal-only';
function setSealMode(mode) {
  sealMode = (mode === 'forensic') ? 'forensic' : 'seal-only';
  var onlyBtn = document.getElementById('modeSealOnly');
  var fxBtn = document.getElementById('modeForensic');
  if (onlyBtn) onlyBtn.classList.toggle('active', sealMode === 'seal-only');
  if (fxBtn) fxBtn.classList.toggle('active', sealMode === 'forensic');
  applyModeVisibility();
}
function applyModeVisibility() {
  var forensic = (sealMode === 'forensic');
  var els = ['patternShareSection', 'aiReviewSection', 'caseDetailsSection', 'stepFraud'];
  for (var i = 0; i < els.length; i++) {
    var el = document.getElementById(els[i]);
    if (el) el.style.display = forensic ? '' : 'none';
  }
  // The voice-note panel states whether transcription is on; it follows the mode.
  try { if (document.getElementById('voTranscribeNote') && typeof voRenderAudioFiles === 'function') voRenderAudioFiles(); } catch (eV) {}
}
applyModeVisibility(); // default seal-only: hide all analysis-only UI on load

async function computeSHA256(bytes) {
  const h = await crypto.subtle.digest('SHA-256', bytes);
  return Array.from(new Uint8Array(h)).map(b => b.toString(16).padStart(2,'0')).join('');
}
async function computeSHA512(bytes) {
  const h = await crypto.subtle.digest('SHA-512', bytes);
  return Array.from(new Uint8Array(h)).map(b => b.toString(16).padStart(2,'0')).join('');
}
function hexToBytes(hex) { const b = new Uint8Array(hex.length / 2); for (let i = 0; i < hex.length; i += 2) b[i / 2] = parseInt(hex.substring(i, i + 2), 16); return b; }

function utf8ToBase64(str) {
  const bytes = new TextEncoder().encode(str);
  let binary = '';
  bytes.forEach(b => binary += String.fromCharCode(b));
  return btoa(binary);
}
function escapeHtml(s) {
  return String(s === undefined || s === null ? '' : s).replace(/[&<>"']/g, function(c) {
    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
  });
}

async function deriveKey(password, salt) {
  const enc = new TextEncoder();
  const keyMaterial = await crypto.subtle.importKey('raw', enc.encode(password), 'PBKDF2', false, ['deriveKey']);
  return crypto.subtle.deriveKey({ name: 'PBKDF2', salt, iterations: 100000, hash: 'SHA-256' }, keyMaterial, { name: 'AES-GCM', length: 256 }, false, ['encrypt', 'decrypt']);
}
async function encryptSealedPDF(sealedBytes, password) {
  const salt = crypto.getRandomValues(new Uint8Array(16));
  const iv = crypto.getRandomValues(new Uint8Array(12));
  const key = await deriveKey(password, salt);
  const encrypted = await crypto.subtle.encrypt({ name: 'AES-GCM', iv }, key, sealedBytes);
  const result = new Uint8Array(16 + 12 + encrypted.byteLength);
  result.set(salt, 0); result.set(iv, 16); result.set(new Uint8Array(encrypted), 28);
  return result;
}
async function decryptSealedPDF(encryptedBytes, password) {
  if (encryptedBytes.length < 28) throw new Error('Invalid encrypted file');
  const salt = encryptedBytes.slice(0, 16);
  const iv = encryptedBytes.slice(16, 28);
  const ciphertext = encryptedBytes.slice(28);
  const key = await deriveKey(password, salt);
  const decrypted = await crypto.subtle.decrypt({ name: 'AES-GCM', iv }, key, ciphertext);
  return new Uint8Array(decrypted);
}

async function submitToOTS(otsDigestHex) {
  const hashBytes = hexToBytes(otsDigestHex);
  for (const url of ['https://a.pool.opentimestamps.org/digest','https://b.pool.opentimestamps.org/digest','https://a.pool.eternitywall.com/digest']) {
    try {
      const ctrl = new AbortController();
      const to = setTimeout(() => ctrl.abort(), 15000);
      const res = await fetch(url, { method: 'POST', headers: {'Content-Type':'application/x-www-form-urlencoded','Accept':'application/vnd.opentimestamps.v1'}, body: hashBytes, signal: ctrl.signal });
      clearTimeout(to);
      if (res.ok) { const d = await res.arrayBuffer(); if (d.byteLength > 0) return {success: true, calendar: url, proof: new Uint8Array(d)}; }
    } catch(e) { console.warn('Calendar failed:', url, e.message); }
  }
  return {success: false, error: 'All calendar servers failed — hash recorded for retry'};
}

function updateStep(n, s, d) {
  const badge = document.getElementById('step'+n).querySelector('.status');
  badge.className = 'status ' + s;
  badge.textContent = s==='complete'?'✓':s==='processing'?'◐':s==='error'?'✕':'○';
  if (d) document.getElementById('detail'+n).textContent = d;
}

async function generateQRDataURL(text, size) {
  return new Promise((resolve) => {
    if (typeof QRCode === 'undefined') { resolve(null); return; }
    const container = document.createElement('div');
    container.style.cssText = 'position:fixed;left:-9999px;top:0;';
    document.body.appendChild(container);
    try {
      new QRCode(container, { text, width: size || 400, height: size || 400, colorDark: '#000000', colorLight: '#ffffff', correctLevel: QRCode.CorrectLevel.H });
    } catch(e) { document.body.removeChild(container); resolve(null); return; }
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        try {
          const img = container.querySelector('img');
          const canvas = container.querySelector('canvas');
          if (img && img.src && img.src.startsWith('data:image')) {
            document.body.removeChild(container);
            resolve(img.src);
          } else if (canvas) {
            try {
              const dataUrl = canvas.toDataURL('image/png');
              document.body.removeChild(container);
              resolve(dataUrl);
            } catch(e) { document.body.removeChild(container); resolve(null); }
          } else {
            document.body.removeChild(container);
            resolve(null);
          }
        } catch(e) { try { document.body.removeChild(container); } catch(e2) {} resolve(null); }
      });
    });
  });
}

async function detectExistingSeal(pdfBytes) {
  const chain = [];
  try {
    const pdfDoc = await PDFDocument.load(pdfBytes, { ignoreEncryption: true });
    const subject = pdfDoc.getSubject();
    if (subject && (subject.startsWith('VO-SEAL|') || subject.startsWith('VO-SEAL2|'))) {
      const parts = subject.split('|');
      if (parts.length >= 3) chain.push({ sealId: parts[2], sha512: parts[1], source: 'Subject metadata' });
      const chainPart = parts.find(p => p.startsWith('CHAIN:'));
      if (chainPart) {
        const oldIds = chainPart.substring(6).split(',').filter(s => s);
        for (const oldId of oldIds) { if (oldId !== parts[2]) chain.push({ sealId: oldId, sha512: null, source: 'Chain history' }); }
      }
    }
  } catch (e) { console.warn('Seal chain detection failed:', e.message); }
  return chain;
}

// ==================== COMMERCIAL DETECTION SYSTEM ====================

const COMMERCIAL_KEYWORDS = [
  'pty ltd','proprietary limited','ltd','limited','inc','incorporated',
  'corp','corporation','llc','cc','close corporation',
  'invoice','purchase order','po number','quotation','quote','tax invoice',
  'tender','rfq','request for quotation','bid','procurement','rfx',
  'vat','vat number','tax number','tin','registration number',
  'contract','agreement','memorandum of understanding','mou','nda',
  'bbbee','bee certificate','bee level','black economic empowerment',
  'bank account','account number','swift','iban','routing number',
  'director','managing director','ceo','cfo','coo','board of directors',
  'shareholder','annual report','financial statement','balance sheet',
  'profit and loss','income statement','audit','audited','sars',
  'company registration','ck number','enterprise number'
];

const PDF_STRUCTURE = /^(obj|endobj|stream|endstream|xref|trailer|startxref|Type1|Type0|Type3|WinAnsiEncoding|MacRomanEncoding|Identity-H|Identity-V|CIDFontType|BaseFont|FontDescriptor|Subtype|Length|Filter|FlateDecode|ASCIIHexDecode|LZWDecode|DCTDecode|DeviceRGB|DeviceGray|DeviceCMYK|ExtGState|ColorSpace|Pattern|XObject|Image|Form|Group|Transparency|Shading|Font|ToUnicode|CMapName|Registry|Ordering|WMode|FontFile|FontFile2|FontFile3|CharSet|Flags|ItalicAngle|Ascent|Descent|CapHeight|StemV|StemH|AvgWidth|MaxWidth|MissingWidth|Leading|XHeight|FontBBox|FontMatrix|Encoding|CharProcs|FirstChar|LastChar|Width|Widths|CIDToGIDMap|CIDSystemInfo|DW|W|DW2|W2|Registry|Ordering|Supplement|RTLn|LTR|true|false|null|R|BT|ET|Tf|Td|Tj|TJ|Tm|Tc|Tw|Tz|Ts|Tr|TL|T\*|\[|\]|<<|>>)$/;

async function extractPdfText(pdfBytes) {
  const texts = [];
  const ascii = new Uint8Array(pdfBytes);
  const words = [];
  let word = '';
  for (let i = 0; i < ascii.length && i < 500000; i++) {
    const c = ascii[i];
    if (c >= 32 && c <= 126) { word += String.fromCharCode(c); }
    else { if (word.length >= 3) words.push(word); word = ''; }
  }
  for (const w of words) {
    const tokens = w.split(/[^a-zA-Z0-9]+/).filter(t => t.length >= 3 && !PDF_STRUCTURE.test(t));
    texts.push(...tokens);
  }
  const pdfStr = new TextDecoder().decode(ascii.slice(0, Math.min(ascii.length, 500000)));
  const parenMatches = pdfStr.match(/\(([^)]+)\)/g);
  if (parenMatches) {
    for (const m of parenMatches) {
      const inner = m.slice(1, -1);
      const tokens = inner.split(/[^a-zA-Z0-9]+/).filter(t => t.length >= 3 && !PDF_STRUCTURE.test(t));
      texts.push(...tokens);
    }
  }
  const streamMatches = pdfStr.match(/stream\r?\n([\s\S]*?)\r?\nendstream/g);
  if (streamMatches) {
    for (const sm of streamMatches.slice(0, 50)) {
      const inner = sm.replace(/^stream\r?\n/, '').replace(/\r?\nendstream$/, '');
      try {
        const decompressed = await rawInflate(inner);
        if (decompressed) {
          const dStr = new TextDecoder('utf-8', {fatal: false}).decode(decompressed);
          const dTokens = dStr.split(/[^a-zA-Z0-9]+/).filter(t => t.length >= 3 && !PDF_STRUCTURE.test(t));
          texts.push(...dTokens);
        }
      } catch(e) {}
    }
  }
  return texts;
}

function rawInflate(data) {
  return new Promise((resolve) => {
    try {
      const bytes = typeof data === 'string' ? new TextEncoder().encode(data) : new Uint8Array(data);
      if (typeof DecompressionStream !== 'undefined') {
        const wrapped = new Uint8Array(bytes.length + 6);
        wrapped[0] = 0x78; wrapped[1] = 0x9C;
        wrapped.set(bytes, 2);
        let a = 1, b = 0;
        for (let i = 0; i < bytes.length; i++) { a = (a + bytes[i]) % 65521; b = (b + a) % 65521; }
        const adler = (b << 16) | a;
        wrapped[wrapped.length - 4] = (adler >> 24) & 0xFF;
        wrapped[wrapped.length - 3] = (adler >> 16) & 0xFF;
        wrapped[wrapped.length - 2] = (adler >>  8) & 0xFF;
        wrapped[wrapped.length - 1] = adler & 0xFF;
        const ds = new DecompressionStream('deflate');
        const writer = ds.writable.getWriter();
        writer.write(wrapped).then(() => writer.close());
        const reader = ds.readable.getReader();
      const chunks = [];
      function read() {
        reader.read().then(({done, value}) => {
          if (done) { resolve(concatUint8Arrays(chunks)); return; }
          chunks.push(value); read();
        }).catch(() => resolve(null));
      }
      read();
    } else { resolve(null); }
  } catch(e) { resolve(null); }
});
}

function concatUint8Arrays(arrays) {
  if (!arrays || arrays.length === 0) return null;
  const total = arrays.reduce((s, a) => s + a.length, 0);
  const result = new Uint8Array(total);
  let offset = 0;
  for (const a of arrays) { result.set(a, offset); offset += a.length; }
  return result;
}

async function detectCommercialDocument(pdfBytes) {
  const texts = await extractPdfText(pdfBytes);
  const textLower = texts.map(t => t.toLowerCase());

  // Score different categories of commercial indicators
  let companyMatches = 0, financialMatches = 0, legalMatches = 0, regulatoryMatches = 0;

  // Company formation/type keywords (weighted: 3 points)
  const companyKeywords = ['pty ltd','proprietary limited','ltd','limited','inc','incorporated','corp','corporation','llc','cc','close corporation'];
  for (const kw of companyKeywords) {
    if (textLower.includes(kw)) companyMatches += 3;
  }

  // Financial/commercial transaction keywords (weighted: 2 points)
  const financialKeywords = ['invoice','purchase order','po number','quotation','quote','tax invoice','tender','rfq','request for quotation','bid','procurement','rfx','contract','agreement','mou','nda'];
  for (const kw of financialKeywords) {
    if (textLower.includes(kw)) financialMatches += 2;
  }

  // Legal/regulatory keywords (weighted: 1 point)
  const legalKeywords = ['vat','vat number','tax number','tin','registration number','bbbee','bee certificate','bee level','bank account','account number','swift','iban','routing number','director','managing director','ceo','cfo','coo','board of directors','shareholder','annual report','financial statement','balance sheet','profit and loss','income statement','audit','audited','sars','company registration','ck number','enterprise number'];
  for (const kw of legalKeywords) {
    if (textLower.includes(kw)) legalMatches += 1;
  }

  // Regulatory keywords (weighted: 2 points)
  const regulatoryKeywords = ['memorandum of understanding','black economic empowerment','financial statement','annual report'];
  for (const kw of regulatoryKeywords) {
    if (textLower.includes(kw)) regulatoryMatches += 2;
  }

  const totalScore = companyMatches + financialMatches + legalMatches + regulatoryMatches;
  const allMatches = [];
  for (const kw of COMMERCIAL_KEYWORDS) {
    if (textLower.includes(kw)) allMatches.push(kw);
  }

  // Commercial threshold: 6+ points (was 2+ keyword matches)
  // This reduces false positives while catching clear commercial use
  return {
    isCommercial: totalScore >= 6,
    matches: allMatches.slice(0, 10),
    count: allMatches.length,
    score: totalScore,
    details: { company: companyMatches, financial: financialMatches, legal: legalMatches, regulatory: regulatoryMatches }
  };
}

const LAW_ENFORCEMENT_DOMAINS = ['.gov.za','.gov','.police','.hawks','.npa','.justice','.saps','.fbi.gov','.doj.gov','.interpol.int','.europol.europa.eu'];

function getPricing() {
  let price = { amount: 50, currency: 'USD', symbol: '$', label: 'International' };
  if (gpsCoords) {
    const lat = parseFloat(gpsCoords.lat), lng = parseFloat(gpsCoords.lng);
    if (lat >= -35 && lat <= -22 && lng >= 16 && lng <= 33) {
      price = { amount: 750, currency: 'ZAR', symbol: 'R', label: 'South Africa' };
    } else if (lat >= -35 && lat <= -10 && lng >= 10 && lng <= 41) {
      price = { amount: 500, currency: 'ZAR', symbol: 'R', label: 'SADC Region' };
    }
  }

  // Enhanced law enforcement detection
  const email = (document.getElementById('senderEmail')?.value || '').toLowerCase().trim();
  const isLE = LAW_ENFORCEMENT_DOMAINS.some(d => email.endsWith(d));

  // Also detect if user identifies as law enforcement
  const userType = document.getElementById('sealType')?.value || 'private';
  const senderName = (document.getElementById('senderName')?.value || '').toLowerCase();
  const identifierText = (document.getElementById('senderIdentifier')?.value || '').toLowerCase();

  const leKeywords = ['police', 'law enforcement', 'police service', 'npa', 'saps', 'hawks', 'fbi', 'interpol', 'detective', 'officer', 'prosecutor', 'magistrate', 'judge'];
  const identifiesAsLE = leKeywords.some(kw => senderName.includes(kw) || identifierText.includes(kw));

  if (isLE || identifiesAsLE) {
    price = { ...price, amount: 0, label: price.label + ' — LAW ENFORCEMENT (FREE)' };
  }

  return price;
}

