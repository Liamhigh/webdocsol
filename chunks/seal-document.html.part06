      for (var lp = 0; lp < lps.length; lp++) { var c = _ocrConfidence[lps[lp]]; if (typeof c === 'number' && (lowest === null || c < lowest)) lowest = c; }
      if (lowest !== null && lowest < VO_OCR_FIGURE_MIN_CONFIDENCE) {
