    <label>Organisation Name</label>
    <input type="text" id="clientName" placeholder="e.g., Standard Bank, FNB, Legal Firm...">
  </div>

  <!-- Seal Button -->
  <button class="seal-btn" id="sealBtn" onclick="startSealing()" disabled>
