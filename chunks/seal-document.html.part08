  var scoreNum = (score != null && isFinite(score)) ? Number(score) : null;
  var SEP = '\n\n' + '='.repeat(80) + '\n\n';

  // CT lookups. forensic-report.js keeps its copies inside a closure, so they are
  // NOT visible here — define them locally (compact) so grouping and type names
  // work in this on-device narrative instead of collapsing every finding to
  // "DIGITAL" and showing raw codes like "ct14".
  var CATLAB = {
    STATEMENTAL: 'Conflicting Statements & Figures', IDENTITY: 'Identity & Role Conflicts',
    FINANCIAL: 'Financial Conflicts', INTEGRITY: 'Document Structure & Integrity',
    CROSS_REF: 'Cross-Reference Checks', CONTACT: 'Address & Location Conflicts',
    EVIDENCE: 'Evidence & Witness Conflicts', DIGITAL: 'Digital Consistency',
    FRANCHISE_LEASE: 'Franchise / Lease & Goodwill', BEHAVIOUR: 'Conduct Indicators'
  };
  var CATORD = ['STATEMENTAL', 'FRANCHISE_LEASE', 'IDENTITY', 'FINANCIAL', 'INTEGRITY', 'CROSS_REF', 'CONTACT', 'EVIDENCE', 'DIGITAL', 'BEHAVIOUR'];
  var CTNAME = {
    CT01: 'Direct Statement Contradiction', CT02: 'Numerical Discrepancy', CT03: 'Date Inconsistency',
    CT04: 'Temporal Sequence Break', CT05: 'Causal Impossibility', CT06: 'Logical Impossibility',
    CT07: 'Scope Creep Indicator', CT08: 'Term Definition Contradiction', CT09: 'Identity Contradiction',
    CT10: 'Role Contradiction', CT11: 'Authority Contradiction', CT12: 'Name Spelling Variation',
    CT13: 'Title Inconsistency', CT14: 'Entity Status Contradiction', CT15: 'Amount Discrepancy',
    CT16: 'Currency Mismatch', CT17: 'Account Number Invalidity', CT18: 'Bank Detail Mismatch',
    CT19: 'VAT Number Invalid', CT20: 'Registration Number Fake', CT21: 'Quotation Mismatch',
    CT22: 'Financial Calculation Error', CT23: 'Signature Mismatch', CT24: 'Metadata Contradiction',
    CT25: 'Font Inconsistency', CT26: 'Format Anomaly', CT27: 'Layout Manipulation',
    CT28: 'Image Integrity Failure', CT29: 'Timestamp Manipulation', CT30: 'Version Control Anomaly',
    CT31: 'Cross-Reference Failure', CT32: 'Source Attribution Failure', CT33: 'Legal Reference Invalid',
    CT34: 'Precedent Violation', CT35: 'Procedure Breach', CT36: 'Address Contradiction',
    CT37: 'Contact Detail Mismatch', CT38: 'Jurisdictional Impossibility', CT39: 'Chain of Custody Break',
    CT40: 'Witness Statement Conflict', CT41: 'Evidence Tampering Indicator', CT42: 'Digital Footprint Mismatch',
    CT43: 'Document Internal Conflict',
    CT44: 'Conditional Clause Misinvoked (Lessee/Owner Trap)', CT45: 'Asset Value Recognised Then Denied (Goodwill)',
    CT46: 'Role / Capacity Contradiction',
    CT47: 'Coercive Conduct Indicators',
    CT48: 'Gaslighting / Reality-Denial Indicators',
    CT49: 'Blame-Reversal / DARVO Indicators',
    CT50: 'Behavioural Pattern Indicator (Signed Rule)'
  };
  var CTCAT = {
    CT01: 'STATEMENTAL', CT02: 'STATEMENTAL', CT03: 'STATEMENTAL', CT04: 'STATEMENTAL', CT05: 'STATEMENTAL',
    CT06: 'STATEMENTAL', CT07: 'STATEMENTAL', CT08: 'STATEMENTAL',
    CT09: 'IDENTITY', CT10: 'IDENTITY', CT11: 'IDENTITY', CT12: 'IDENTITY', CT13: 'IDENTITY', CT14: 'IDENTITY',
    CT15: 'FINANCIAL', CT16: 'FINANCIAL', CT17: 'FINANCIAL', CT18: 'FINANCIAL', CT19: 'FINANCIAL',
    CT20: 'FINANCIAL', CT21: 'FINANCIAL', CT22: 'FINANCIAL',
    CT23: 'INTEGRITY', CT24: 'INTEGRITY', CT25: 'INTEGRITY', CT26: 'INTEGRITY', CT27: 'INTEGRITY',
    CT28: 'INTEGRITY', CT29: 'INTEGRITY', CT30: 'INTEGRITY',
    CT31: 'CROSS_REF', CT32: 'CROSS_REF', CT33: 'CROSS_REF', CT34: 'CROSS_REF', CT35: 'CROSS_REF',
    CT36: 'CONTACT', CT37: 'CONTACT', CT38: 'CONTACT', CT39: 'EVIDENCE', CT40: 'EVIDENCE', CT41: 'EVIDENCE',
    CT42: 'DIGITAL', CT43: 'DIGITAL',
    CT44: 'FRANCHISE_LEASE', CT45: 'FRANCHISE_LEASE', CT46: 'IDENTITY', CT47: 'BEHAVIOUR', CT48: 'BEHAVIOUR', CT49: 'BEHAVIOUR', CT50: 'BEHAVIOUR'
  };
  // The report's measured labels where the report script loaded (CTNAME is
  // the sealed taxonomy and stays equal to CT_NAMES).
  var nameOf = function (t) { return (window.VerumReport && window.VerumReport._ctLabel && CTNAME[t]) ? window.VerumReport._ctLabel(t) : (CTNAME[t] || t || 'finding'); };
  var catOf = function (t) { return CTCAT[t] || null; };

  // Plain-language meaning of each category — generic forensic context, always
  // true of the category, never a case-specific claim.
  var MEAN = {
    // Each in the measured words of what the group's detectors record; never
    // what the finding "is a marker of" (fraud, impersonation, alteration):
    // that is for the court (PD16; the review of 5 October 2026 found the
    // render gate dropping these sentences from the on-device summary).
    STATEMENTAL: 'the document states different facts, figures or definitions for the same thing in different places',
    IDENTITY: 'the names, titles, roles or entity statuses stated in the document do not line up',
    FINANCIAL: 'amounts, bank details, VAT or registration numbers or currencies do not agree with each other or with their required format',
    INTEGRITY: "the document's structure carries measurements (layout, metadata, fonts, timestamps, page order or signatures) that differ from one another",
    CROSS_REF: 'the document relies on sources, references or procedures that do not resolve when checked',
    CONTACT: 'addresses or contact details differ from one another, or place a party in two places',
    EVIDENCE: 'witness statements carry conflict markers, or the handling record of the evidence is incomplete',
    DIGITAL: "the document's digital footprint or internal references do not agree",
    FRANCHISE_LEASE: 'a contractual right is invoked whose precondition the record states otherwise, or an asset (goodwill, the value of the business) is recognised in one place and denied in another'
  };

  var clean = function (s) { return (s == null ? '' : String(s)).replace(/\s+/g, ' ').trim(); };
  // Structural notes: findings the engine demoted because the file is a
  // compiled bundle (repeated page numbers etc.) — normal housekeeping, so
  // the narrative counts them separately instead of letting them drown the
  // substantive story.
  var DEMRE = /\[bundle context:[^\]]*\]/i;
  var isDem = function (f) { return DEMRE.test(String((f && f.evidence) || '')); };
  var quoteOf = function (f) {
    var e = clean(f.evidence || f.description || '');
    // strip seal-footer debris dragged in when the analysed file is itself sealed
    // (matches the report builder's cleanQuote — several footer formats exist)
    e = e.replace(/verum omnis sha-?512 \(partial\):\s*[0-9a-f]{6,}/gi, ' ')
      .replace(/verum omnis seal(ed)?\s*(original|evidence|document)?\s*(case-[0-9a-f]+)?/gi, ' ')
      .replace(/\bcase-[0-9a-f]{6,}\b/gi, ' ')
      .replace(/\b[0-9a-f]{6,}\s*\.{2,3}\s*[0-9a-f]{6,}\b/gi, ' ')
      .replace(/\b(?=[0-9a-f]*\d)(?=[0-9a-f]*[a-f])[0-9a-f]{8,}\b/gi, ' ')
      .replace(/\b\d+\s*\/\s*\d+\s*verify seal\b/gi, ' ')
      .replace(/\bverify seal\b/gi, ' ')
      .replace(/\bclean bundle page \d+ of \d+\b/gi, ' ')
      .replace(/\bpage \d+ of \d+\b/gi, ' ')
      .replace(DEMRE, ' ')
      .replace(/\s+/g, ' ').trim();
    return e.length > 200 ? e.slice(0, 197) + '...' : e;
  };
  var whereOf = function (f) { return clean(f.location) || (f.page ? 'Page ' + f.page : 'the document'); };
  var atWhere = function (f) { var w = whereOf(f); return w === 'the document' ? 'in the document' : 'at ' + w; };
  var art = function (w) { return /^[aeiou]/i.test(clean(w)) ? 'an' : 'a'; };
  var joinList = function (a) { return a.length <= 1 ? (a[0] || '') : a.slice(0, -1).join(', ') + ' and ' + a[a.length - 1]; };

  // Partition: serial patterns and AI-identified are handled separately, and
  // demoted structural notes are counted apart from substantive findings so
  // bundle housekeeping never drowns the story.
  // AI-raised items are candidate tier ("never presented as engine-verified"),
  // so they are counted apart from the engine-verified findings (PD16).
  var serial = [], byCat = {}, demoted = 0, substantive = 0, aiCand = 0;
  list.forEach(function (f) {
    if (f.type === 'SERIAL') { serial.push(f); return; }
    if (f.source === 'ai') { aiCand++; (byCat.AI_IDENTIFIED = byCat.AI_IDENTIFIED || []).push(f); return; }
    if (isDem(f)) demoted++; else substantive++;
    var c = catOf(f.type) || f.category || 'DIGITAL';
    (byCat[c] = byCat[c] || []).push(f);
  });

  // No grading of the result (PD1, §15.2): the score once chose "This is a
  // critical-level result" and every key finding printed "(High)" or
  // "(Moderate)" (evidence-bundle-7-docs review, 5 October 2026). The count
  // and the record's own words carry it.

  var counts = CATORD.map(function (c) { return { cat: c, n: (byCat[c] || []).length }; })
    .filter(function (x) { return x.n > 0; })
    .sort(function (a, b) { return b.n - a.n; });

  // ---------- SUMMARY ----------
  var engineN = list.length - aiCand;
  var summary = 'The forensic engine examined this sealed document and recorded ' + engineN +
    ' finding' + (engineN === 1 ? '' : 's');
  if (demoted > 0) {
    summary += ' — ' + substantive + ' substantive and ' + demoted + ' routine structural note' + (demoted === 1 ? '' : 's') +
      ' of the kind expected when many separate documents are compiled into one bundle';
  }
  summary += '. ' + (demoted > 0 ? 'Part of this count comes from routine structural notes; the substantive findings below are what matter. ' : '');
  if (counts.length) {
    var dom = counts.slice(0, 3).map(function (x) { return (CATLAB[x.cat] || x.cat).toLowerCase() + ' (' + x.n + ')'; });
    summary += 'The findings cluster in ' + joinList(dom) + '. ';
  }
  if (aiCand > 0) {
    summary += 'The optional AI review raised ' + aiCand + ' further candidate item' + (aiCand === 1 ? '' : 's') +
      ' — advisory only, never counted among the findings. ';
  }
  if (serial.length) {
    // Only name genuinely-labelled patterns. Suppressed/weak/fallback names
    // ("Multi-stage pattern indicator", "... label suppressed") must never leak
    // into the prose — when none survive, say the labels were withheld.
    var snames = [];
    serial.forEach(function (f) {
      var n = clean(f.serialName || f.serialPattern || '');
      if (!n) return;
      if (/suppressed|weak signal|^multi-stage pattern (?:indicator|match)$/i.test(n)) return;
      if (snames.indexOf(n) < 0) snames.push(n);
    });
    summary += 'The engine also matched ' + serial.length + ' multi-stage pattern' + (serial.length === 1 ? '' : 's') +
      (snames.length
        ? ' — including the patterns named ' + joinList(snames.slice(0, 4)) + (snames.length > 4 ? ', among others' : '')
        : ' (labels withheld to avoid mischaracterising a document that discusses alleged fraud as its subject — see the Serial Pattern Analysis section)') + '. ';
  }
  summary += 'Every point below is drawn only from the document itself and is stated as a fact of the record; a human ' +
    'reviewer, investigator or court makes the final determination. This narrative was generated deterministically ' +
    'on this device from the sealed findings — no external service was used.';

  // ---------- KEY CONTRADICTIONS (top findings as plain sentences) ----------
  // "The actual contradiction, on which page" — one full sentence per top
  // finding, no bare detector codes, page anchor always stated. This is the
  // deterministic answer to a reader who never wants to decode "CT02".
  // Engine findings only: an AI candidate is never a key finding (the review
  // of 5 October 2026 found one leading this list by its own severity).
  var keyList = list.filter(function (f) { return f.type !== 'SERIAL' && !isDem(f) && f.source !== 'ai'; })
    .slice().sort(function (a, b) { return (b.severity || 0) - (a.severity || 0); }).slice(0, 8);
  var keyParts = keyList.map(function (f, i) {
    var nm = nameOf(f.type);
    var where = whereOf(f);
    var whereTxt = (where === 'the document') ? 'across the document' : 'at ' + where;
    return (i + 1) + '. ' + nm + ' — ' + whereTxt + ': "' + quoteOf(f) + '"';
  });

  // ---------- WHAT THE EVIDENCE SHOWS (prose per category) ----------
  // Examples always come from substantive findings; structural notes are
  // acknowledged with a count, never quoted as if they were evidence.
  var evParts = [];
  counts.forEach(function (x) {
    var whole = (byCat[x.cat] || []).slice().sort(function (a, b) { return (b.severity || 0) - (a.severity || 0); });
    var arr = whole.filter(function (f) { return !isDem(f); });
    var demN = whole.length - arr.length;
    if (arr.length === 0) {
      evParts.push((CATLAB[x.cat] || x.cat) + ' — ' + x.n + ' finding' + (x.n === 1 ? '' : 's') + ', all of them routine structural notes expected in a compiled bundle (repeated page numbering, annexures filed in another part of the file). Nothing in this group requires investigation on its own.');
      return;
    }
    var lead = arr[0];
    var leadName = nameOf(lead.type).toLowerCase();
    var p = (CATLAB[x.cat] || x.cat) + ' — ' + x.n + ' finding' + (x.n === 1 ? '' : 's') +
      (demN > 0 ? ' (' + arr.length + ' substantive, ' + demN + ' structural)' : '') + '. ' +
      'In this group, ' + (MEAN[x.cat] || 'the document shows internal inconsistencies') + '. ' +
      'The first in the engine\'s order is ' + art(leadName) + ' ' + leadName + ' ' + atWhere(lead) + ': "' + quoteOf(lead) + '"';
    if (arr.length > 1) {
      var second = arr[1];
      var secName = nameOf(second.type).toLowerCase();
      p += '; another is ' + art(secName) + ' ' + secName + ' ' + atWhere(second) + ' ("' + quoteOf(second) + '")';
    }
    p += '.';
    var rest = arr.length - 2;
    if (rest > 0) p += ' A further ' + rest + ' substantive finding' + (rest === 1 ? ' was' : 's were') + ' recorded in this group.';
    evParts.push(p);
  });
  var ai = byCat['AI_IDENTIFIED'] || [];
  if (ai.length) {
    evParts.push('AI-identified findings — ' + ai.length + '. The optional AI review flagged ' + ai.length +
      ' further point' + (ai.length === 1 ? '' : 's') + ' the deterministic detectors did not, for example: "' +
      clean(ai[0].rationale || ai[0].evidence || '') + '". These are advisory and are not findings.');
  }
  var evidence = evParts.length ? evParts.join('\n\n') : 'No categorised findings were available to describe.';

  // ---------- MULTI-STAGE PATTERNS ----------
  // Suppressed/masked pattern labels all render identically, so listing them
  // one per line tells the reader nothing eight times over — collapse them
  // into a single counted sentence and list only the named patterns.
  var patterns = '';
  if (serial.length) {
    var maskedN = 0, named = [];
    serial.forEach(function (f) {
      var nm = clean(f.serialName || f.serialPattern || '');
      var ev = clean(f.evidence || '');
      if (!nm || /label suppressed|weak signal|^multi-stage pattern (?:indicator|match)$/i.test(nm) || /label suppressed/i.test(ev)) maskedN++;
      else named.push(f);
    });
    patterns = 'A pattern is flagged only when several independent stages appear together in the same document, ' +
      'which is harder to explain as coincidence than any single finding.';
    if (named.length) {
      var lines = named.slice(0, 8).map(function (f) {
        return '- Pattern named ' + clean(f.serialName || f.serialPattern || 'Multi-stage pattern') + ': ' + quoteOf(f);
      });
      patterns += ' The engine matched:\n\n' + lines.join('\n');
      if (named.length > 8) patterns += '\n\n(' + (named.length - 8) + ' further named pattern(s) were included in the findings.)';
    }
    if (maskedN > 0) {
      patterns += (named.length ? '\n\n' : ' ') + maskedN + ' further multi-stage pattern match' + (maskedN === 1 ? ' was' : 's were') +
        ' matched with the label withheld: this document discusses alleged fraud or disputed conduct as its subject matter, and naming the patterns here could mischaracterise the document itself. The underlying findings remain in the sealed findings list for investigators.';
    }
  }

  // "HOW SERIOUS THIS IS" printed severity bands ("2 are critical (severity
  // 5), 1 high (4)…") into a sealed report: removed (PD1, §15.2; evidence-
  // bundle-7-docs review, 5 October 2026).

  // ---------- WHAT HAPPENED (the story) ----------
  // A flowing, plain-English account woven from the leading substantive
  // findings, the legal themes present, and the named parties from the case
  // details. Deterministic and anchored — it asserts nothing beyond the
  // findings, names no guilt, and reads like a case account rather than a list.
  var ci = (typeof voCaseDetails === 'function') ? (voCaseDetails() || {}) : {};
  var firstWord = function (n) { return String(n || '').trim().split(/\s+/)[0] || ''; };
  var actors = [];
  if (ci.parties) {
    String(ci.parties)
      .replace(/\b(complainant|respondents?|applicant|defendant|plaintiff|accused|first|second|third|others?)\b\s*:?/gi, ',')
      .replace(/\bvs?\.?\b|\bv\.\b|&|\/|\band\b|\|/gi, ',')
      .split(',').forEach(function (raw) {
        var p = raw.replace(/[^A-Za-z .'-]/g, ' ').replace(/\s+/g, ' ').trim();
        if (p && /[A-Z]/.test(p) && p.length >= 2 && actors.indexOf(p) < 0) actors.push(p);
      });
  }
  var strongest = list.filter(function (f) { return f.type !== 'SERIAL' && !isDem(f) && f.source !== 'ai'; })
    .slice().sort(function (a, b) { return (b.severity || 0) - (a.severity || 0); });
  var whatHappened = '';
  if (strongest.length) {
    var opener = 'Reading only the sealed document';
    if (ci.caseName) opener += ' in the matter of ' + clean(ci.caseName);
    if (ci.parties) opener += ' (' + clean(ci.parties) + ')';
    opener += ', the following account emerges for human review. ';
    whatHappened += opener;
    var s0 = strongest[0], n0 = nameOf(s0.type).toLowerCase();
