// Locate up to 2 occurrences of needle (ASCII string) inside a Uint8Array.
function voFindAscii(hay, needleStr, limit) {
  var hits = [];
  var n0 = needleStr.charCodeAt(0);
  var max = hay.length - needleStr.length;
  for (var i = 0; i <= max; i++) {
    if (hay[i] !== n0) continue;
    var ok = true;
    for (var j = 1; j < needleStr.length; j++) { if (hay[i + j] !== needleStr.charCodeAt(j)) { ok = false; break; } }
    if (ok) { hits.push(i); if (limit && hits.length >= limit) return hits; }
  }
  return hits;
}

// Patch the placeholder Subject hash inside the saved PDF bytes with the real
// SHA-512 of those bytes. Returns the sealed-file hash hex, or null when the
// placeholder is not present exactly once (caller then falls back to the
// legacy VO-SEAL subject — an honest degradation, never a silent failure).
async function voEmbedSealedFileHash(savedBytes) {
  var hits = voFindAscii(savedBytes, voUtf16Hex(VO_SEAL2_PREFIX + VO_HASH_PLACEHOLDER), 2);
  if (hits.length !== 1) return null;
  var hashBuf = await crypto.subtle.digest('SHA-512', savedBytes);
  var hb = new Uint8Array(hashBuf), hash = '';
  for (var i = 0; i < hb.length; i++) hash += (hb[i] < 16 ? '0' : '') + hb[i].toString(16);
  var hashEnc = voUtf16Hex(hash); // 512 ASCII chars == placeholder's encoded length
  var start = hits[0] + voUtf16Hex(VO_SEAL2_PREFIX).length;
  for (var k = 0; k < hashEnc.length; k++) savedBytes[start + k] = hashEnc.charCodeAt(k);
  return hash;
}

// Pre-seal page normalisation. Reveal any page whose CropBox hides part of its
// MediaBox, so the sealed copy shows the WHOLE page. A source PDF arrived with
// 58 pages cropped to a landscape slice and the seal was faithfully preserving
// that — half of each page was invisible in the sealed output, and manually
// un-cropping the source before sealing did not survive because pdf-lib carried
// the CropBox straight through. Resetting CropBox to MediaBox restores the full
// page; no content is touched, only the visible window. Runs BEFORE the overlay
// is drawn so the seal furniture sits on the full page. Defensive throughout:
// any per-page failure is skipped, never crashing the seal. Returns the count
// of pages restored, for disclosure.
function voNormalizeSealPageBoxes(pdf) {
  var P = (typeof window !== 'undefined' && window.PDFLib) ? window.PDFLib : {};
  if (!P.PDFArray || !P.PDFNumber || !P.PDFName) return 0;
  var pages = pdf.getPages();
  var fixed = 0;
  var toArr = function (box) {
    var out = [];
    for (var k = 0; k < 4; k++) { var v = box.get(k); out.push(v && v.asNumber ? v.asNumber() : Number(v)); }
    return out;
  };
  for (var i = 0; i < pages.length; i++) {
    try {
      var node = pages[i].node;
      var mb = node.MediaBox ? node.MediaBox() : null;
      var cb = node.CropBox ? node.CropBox() : null;
      if (!mb || !cb) continue;
      var ma = toArr(mb), ca = toArr(cb);
      if (voCropHidesContent(ma, ca)) {
        var arr = P.PDFArray.withContext(node.context);
        for (var k2 = 0; k2 < 4; k2++) arr.push(P.PDFNumber.of(ma[k2]));
        node.set(P.PDFName.of('CropBox'), arr);
        fixed++;
      }
    } catch (e) { /* one page failing must never break the seal */ }
  }
  return fixed;
}

async function buildSealedPDF(origBytes, qrDataURL, sealId, sha512, sha256, clientName, password, senderEmail, chain, fraudResult) {
  // Password-protected input: the overlay (watermark/QR/footer) cannot be
  // stamped inside a locked file, and force-loading would corrupt it. The
  // honest degradation is to seal the EXACT original bytes as-is — the
  // SHA-512 + OTS anchor already cover them, the verify page will match them,
  // and the Seal Certificate carries the QR and seal record instead. This
  // replaces a hard pipeline crash observed in production.
  window._voSealedAsIs = false;
  let pdf;
  try {
    pdf = await PDFDocument.load(origBytes);
  } catch (loadErr) {
    if (/encrypt/i.test(String(loadErr && loadErr.message))) {
      window._voSealedAsIs = true;
      window._voSealedFileHash = null; // no VO-SEAL2 subject can be written into a locked file
      return origBytes instanceof Uint8Array ? origBytes : new Uint8Array(origBytes);
    }
    throw loadErr;
  }
  let wmImg = null;
  if (watermarkBytes) { try { wmImg = await pdf.embedPng(watermarkBytes); } catch(e) {} }
  let qrImg = null;
  try {
    const base64 = qrDataURL.split(',')[1];
    const binary = atob(base64);
    const qrBytes = new Uint8Array(binary.length);
    for (let i = 0; i < binary.length; i++) qrBytes[i] = binary.charCodeAt(i);
    qrImg = await pdf.embedPng(qrBytes);
  } catch(e) { console.error('QR embed failed:', e.message); }
  const helv = await pdf.embedFont(StandardFonts.Helvetica);
  const helvBold = await pdf.embedFont(StandardFonts.HelveticaBold);
  const now = new Date();
  const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
  const ts = now.toLocaleString('en-GB', { timeZone: tz, year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false }).replace(',', '') + ' ' + tz;
  const short = sha512.substring(0,16);

  // Reveal any hidden (cropped) content BEFORE stamping and saving, so the
  // sealed copy shows whole pages and the seal furniture sits on the full page.
  window._voCropNormalizedPages = 0;
  try { window._voCropNormalizedPages = voNormalizeSealPageBoxes(pdf); } catch (e) {}

  const pages = pdf.getPages();

  for (let i = 0; i < pages.length; i++) {
    const pg = pages[i];
    const { width: pageW, height: pageH } = pg.getSize();

    // Content scaling removed in v1.2.6 — PDFContentStream.of() with q/cm/Q
    // operators was corrupting content streams on most pages, destroying all text.
    // The watermark, QR code, and footer are now drawn as overlays on top of
    // the original unmodified content — preserving 100% of document text.

    if (wmImg) {
      const s = Math.max(pageW / wmImg.width, pageH / wmImg.height);
      const w = wmImg.width * s, h = wmImg.height * s;
      pg.drawImage(wmImg, { x: (pageW-w)/2, y: (pageH-h)/2, width: w, height: h, opacity: 0.20 });
    }

    // PRISTINE SEAL DOCTRINE: no forensic/fraud overlays are ever drawn on the
    // original document. The seal proves integrity and time only; all forensic
    // characterisation lives exclusively in the separate sealed forensic report.

    // SEAL BANDS ON NEW SPACE. The QR panel and footer strip used to be drawn
    // OVER the page's own top-right corner and bottom edge — on scanned
    // originals with no margins that covered real content (in one real case,
    // the signature at the foot of a lease page). The page is EXTENDED
    // instead: the media/crop boxes grow downward for the footer band and
    // upward for the seal band, the original content keeps its exact
    // coordinates, and the seal furniture owns only the added space.
    const fy = pageH * 0.02, fs = Math.min(pageW, pageH) * 0.018;
    const footH = fy + fs*3;
    const panelSize = Math.max(Math.min(pageW, pageH) * 0.051, 26);
    const headH = panelSize + 10;
    const mbox = pg.getMediaBox();
    pg.setMediaBox(mbox.x, mbox.y - footH, mbox.width, mbox.height + footH + headH);
    try { pg.setCropBox(mbox.x, mbox.y - footH, mbox.width, mbox.height + footH + headH); } catch (eCb) {}
    const ox = mbox.x;                  // page left edge (origin can be non-zero)
    const footY = mbox.y - footH;       // base of the new footer band
    const headY = mbox.y + mbox.height; // base of the new header band (old top edge)

    // Header band: navy, QR panel right, verification hint left.
    pg.drawRectangle({ x: ox, y: headY, width: mbox.width, height: headH, color: rgb(0.02,0.05,0.08), opacity: 1 });
    {
      const panelX = ox + mbox.width - panelSize - 8;
      const panelY = headY + (headH - panelSize) / 2;
      pg.drawRectangle({ x: panelX, y: panelY, width: panelSize, height: panelSize, color: rgb(1, 1, 1), opacity: 0.95 });
      if (qrImg) {
        pg.drawImage(qrImg, { x: panelX + 2, y: panelY + 2, width: panelSize - 4, height: panelSize - 4 });
      } else {
        pg.drawText(sealId.substring(0, 8), { x: panelX + 2, y: panelY + panelSize/2, size: 5, font: helv, color: rgb(0.3, 0.3, 0.3) });
      }
      var hdrTxt = 'VERUM OMNIS SEALED ORIGINAL — scan the code or verify at verumglobal.foundation/verify.html';
      var hdrSize = fs * 0.8;
      var hdrMax = mbox.width - panelSize - 24 - pageW*0.06;
      while (hdrSize > 3.5 && helvBold.widthOfTextAtSize(hdrTxt, hdrSize) > hdrMax) hdrSize -= 0.2;
      pg.drawText(hdrTxt, { x: ox + pageW*0.03, y: headY + headH/2 - hdrSize/2, size: hdrSize, font: helvBold, color: rgb(0.82,0.65,0.28) });
    }

    pg.drawRectangle({ x: ox, y: footY, width: mbox.width, height: footH, color: rgb(0.02,0.05,0.08), opacity: 1 });
    const stLabel = sealType==='commercial' && clientName ? 'COMMERCIAL SEAL — ' + clientName.toUpperCase() : 'PRIVATE SEAL — FREE TIER';
    const chainIds = chain.map(c => c.sealId).filter(id => id && id !== sealId);
    const chainLabel = chainIds.length > 0 ? '  |  Chain: ' + chainIds.length + ' prev' : '';
    // Footer layout. The identity line (seal ID + hash + timestamp + page
    // numbers) is long and its length varies with the seal ID and chain, so it
    // was overrunning the fixed x=0.55*pageW start of the right-hand line and
    // printing straight through it — two strings on one baseline, illegible on
    // the sealed original. The right-hand line now sits on the TOP row,
    // right-aligned, and the identity line owns the bottom row across the full
    // width, shrinking to fit rather than colliding with anything.
    var footLeft = ox + pageW*0.03, footRight = pageW*0.03;
    var footSize = fs*0.75;
    var siteTxt = 'verumglobal.foundation  |  OpenTimestamps  |  Patent Pending';
    var siteSize = footSize;
    var siteMax = pageW * 0.5;
    while (siteSize > 3.5 && helv.widthOfTextAtSize(siteTxt, siteSize) > siteMax) siteSize -= 0.2;
    var stTxt = stLabel + chainLabel;
    pg.drawText(stTxt, { x: footLeft, y: footY + fy+fs*1.8, size: fs*0.8, font: helvBold, color: rgb(0.82,0.65,0.28) });
    pg.drawText(siteTxt, {
      x: Math.max(footLeft + helvBold.widthOfTextAtSize(stTxt, fs*0.8) + footSize,
                  ox + pageW - footRight - helv.widthOfTextAtSize(siteTxt, siteSize)),
      y: footY + fy+fs*1.8, size: siteSize, font: helv, color: rgb(0.36,0.42,0.48) });
    var idTxt = 'VERUM OMNIS SEALED ORIGINAL  |  Seal: ' + sealId + '  |  SHA-512: ' + short + '...  |  ' + ts + '  |  ' + (i+1) + '/' + pages.length + chainLabel;
    var idSize = footSize;
    var idMax = pageW - footLeft - footRight;
    while (idSize > 3.5 && helv.widthOfTextAtSize(idTxt, idSize) > idMax) idSize -= 0.2;
    pg.drawText(idTxt, { x: footLeft, y: footY + fy+fs*0.5, size: idSize, font: helv, color: rgb(0.58,0.71,0.78) });

    updateStep(6, 'processing', 'Page ' + (i+1) + ' of ' + pages.length);
  }

  if (password) {
    const cover = pdf.insertPage(0);
    const pw = pages.length > 0 ? pages[0].getWidth() : 595;
    const ph = pages.length > 0 ? pages[0].getHeight() : 842;
    cover.setSize(pw, ph);
    cover.drawRectangle({ x: 0, y: 0, width: pw, height: ph, color: rgb(0.02, 0.05, 0.08) });
    if (wmImg) {
      const s = Math.max(pw / wmImg.width, ph / wmImg.height);
      const w = wmImg.width * s, h = wmImg.height * s;
      cover.drawImage(wmImg, { x: (pw-w)/2, y: (ph-h)/2, width: w, height: h, opacity: 0.15 });
    }
    const cx = pw / 2, cy = ph * 0.65;
    cover.drawRectangle({ x: cx-30, y: cy-25, width: 60, height: 50, color: rgb(0.82, 0.65, 0.28), opacity: 0.9 });
    cover.drawCircle({ x: cx, y: cy+25, size: 18, color: rgb(0.82, 0.65, 0.28), opacity: 0.9 });
    cover.drawCircle({ x: cx, y: cy+25, size: 10, color: rgb(0.02, 0.05, 0.08), opacity: 1 });
    cover.drawText('DOCUMENT PROTECTED', { x: cx-140, y: cy-70, size: 22, font: helvBold, color: rgb(0.82, 0.65, 0.28) });
    let lineY = cy - 110;
    const instructions = [
      'This document has been password-protected by the sender.',
      '', 'To open this document:', '1. Contact the sender to request the password',
      '2. The sender will know you received this document', '3. This serves as your delivery receipt',
    ];
    for (const line of instructions) { if (line) cover.drawText(line, { x: cx-140, y: lineY, size: 11, font: helv, color: rgb(0.58, 0.71, 0.78) }); lineY -= 18; }
    if (senderEmail) { lineY -= 10; cover.drawText('Sender contact:', { x: cx-140, y: lineY, size: 11, font: helvBold, color: rgb(0.82, 0.65, 0.28) }); lineY -= 18; cover.drawText(senderEmail, { x: cx-140, y: lineY, size: 12, font: helv, color: rgb(0.95, 0.95, 0.95) }); }
    cover.drawText('Seal: ' + sealId + '  |  verumglobal.foundation', { x: cx-100, y: ph*0.03, size: 9, font: helv, color: rgb(0.36, 0.42, 0.48) });
  }

  var chainIds = chain.map(c => c.sealId).filter(id => id && id !== sealId);
  var chainStr = chainIds.length > 0 ? '|CHAIN:' + chainIds.join(',') : '';

  try { pdf.setTitle(selectedFile ? selectedFile.name : 'Sealed Document'); } catch(e) {}
  try { pdf.setAuthor('Verum Omnis'); } catch(e) {}
  // VO-SEAL2: placeholder sealed-file hash first (patched post-save); ORIG:
  // preserves the original content hash (the OTS-anchored pre-seal fingerprint).
  try { pdf.setSubject(VO_SEAL2_PREFIX + VO_HASH_PLACEHOLDER + '|' + sealId + '|ORIG:' + sha512 + chainStr); } catch(e) {}
  try { pdf.setKeywords(['verum', 'seal', 'v2', sha512.substring(0,16), sealType]); } catch(e) { console.warn('Keywords set failed:', e.message); }
  try { pdf.setProducer('Verum Omnis Document Sealing Service v1.3.0'); } catch(e) {}
  try { pdf.setCreationDate(new Date()); } catch(e) {}

  window._voSealedFileHash = null;
  try {
    var savedV2 = await pdf.save({ useObjectStreams: false });
    var sealedHash = await voEmbedSealedFileHash(savedV2);
    if (sealedHash) {
      window._voSealedFileHash = sealedHash;
      return savedV2;
    }
    console.warn('VO-SEAL2 placeholder patch infeasible; falling back to legacy VO-SEAL subject.');
  } catch (eV2) {
    console.warn('VO-SEAL2 save failed, falling back to legacy format:', eV2 && eV2.message ? eV2.message : eV2);
  }
  // Legacy fallback (pre-v1.3 format): Subject hash covers the pre-seal original.
  try { pdf.setSubject('VO-SEAL|' + sha512 + '|' + sealId + chainStr); } catch(e) {}
  try { pdf.setKeywords(['verum', 'seal', sha512.substring(0,16), sealType]); } catch(e) {}
  return await pdf.save();
}

// ==================== SEAL CERTIFICATE (Seal Only mode) ====================
// One-page certificate PDF, generated with the same pdf-lib tooling as the seal.
// House style matches the forensic report cover: navy full bleed, gold rules,
// serif wordmark. It states exactly what the seal proves — integrity and time.
async function buildSealCertificate(opts) {
  opts = opts || {};
  const certDoc = await PDFDocument.create();
  const helv = await certDoc.embedFont(StandardFonts.Helvetica);
  const helvBold = await certDoc.embedFont(StandardFonts.HelveticaBold);
  const times = await certDoc.embedFont(StandardFonts.TimesRoman);
  const timesBold = await certDoc.embedFont(StandardFonts.TimesRomanBold);
  const timesItalic = await certDoc.embedFont(StandardFonts.TimesRomanItalic);
  const courier = await certDoc.embedFont(StandardFonts.Courier);
  const NAVY = rgb(0x0e/255, 0x1a/255, 0x2b/255);
  const GOLD = rgb(0xc9/255, 0xa2/255, 0x27/255);
  const LIGHT = rgb(0.85, 0.88, 0.92);
  const MUTE = rgb(0.55, 0.63, 0.72);
  const WHITE = rgb(1, 1, 1);
  const PW = 595.28, PH = 841.89;
  const page = certDoc.addPage([PW, PH]);
  page.drawRectangle({ x: 0, y: 0, width: PW, height: PH, color: NAVY });
  page.drawRectangle({ x: 0, y: PH - 6, width: PW, height: 6, color: GOLD });
  page.drawRectangle({ x: 0, y: 0, width: PW, height: 6, color: GOLD });

  // WinAnsi-safe text: fold anything the standard fonts cannot encode.
  function safe(t) {
    // Whitelist as numeric code points only — no unicode escapes and no
    // non-ASCII literals in source (transport-safe). Allowed: printable ASCII 0x20-0x7E,
    // Latin-1 0xA0-0xFF, en/em dash, curly quotes, bullet, ellipsis (all
    // WinAnsi-encodable); everything else folds to '?'.
    var s = String(t === undefined || t === null ? '' : t), out = '', i, c;
    for (i = 0; i < s.length; i++) {
      c = s.charCodeAt(i);
      out += ((c >= 0x20 && c <= 0x7E) || (c >= 0xA0 && c <= 0xFF) ||
        c === 0x2013 || c === 0x2014 || c === 0x2018 || c === 0x2019 ||
        c === 0x201C || c === 0x201D || c === 0x2022 || c === 0x2026) ? s.charAt(i) : '?';
    }
    return out;
  }
  function cx(t, font, size) { return (PW - font.widthOfTextAtSize(safe(t), size)) / 2; }
  function wrap(t, font, size, maxW) {
    var words = safe(t).split(/\s+/), lines = [], cur = '';
    for (var i = 0; i < words.length; i++) {
      var trial = cur ? cur + ' ' + words[i] : words[i];
      if (font.widthOfTextAtSize(trial, size) > maxW && cur) { lines.push(cur); cur = words[i]; }
      else cur = trial;
    }
    if (cur) lines.push(cur);
    return lines;
  }

  // Wordmark + title
  var y = PH - 78;
  page.drawText('VERUM OMNIS', { x: cx('VERUM OMNIS', timesBold, 28), y: y, size: 28, font: timesBold, color: WHITE });
  y -= 18;
  var tag = 'A I   F O R E N S I C S   F O R   T R U T H';
  page.drawText(tag, { x: cx(tag, times, 8.5), y: y, size: 8.5, font: times, color: GOLD });
  y -= 16;
  page.drawLine({ start: { x: PW / 2 - 130, y: y }, end: { x: PW / 2 + 130, y: y }, thickness: 0.8, color: GOLD });
  y -= 40;
  page.drawText('SEAL CERTIFICATE', { x: cx('SEAL CERTIFICATE', timesBold, 23), y: y, size: 23, font: timesBold, color: GOLD });
  y -= 20;
  var sub = 'Cryptographic tamper-evidence certificate';
  page.drawText(sub, { x: cx(sub, timesItalic, 11), y: y, size: 11, font: timesItalic, color: LIGHT });
  y -= 42;

  // QR panel (right column) — links to verify.html with hash + seal metadata
  var qrSize = 118;
  var qrX = PW - 70 - qrSize, qrY = y - qrSize + 16;
  page.drawRectangle({ x: qrX - 8, y: qrY - 8, width: qrSize + 16, height: qrSize + 16, color: WHITE, borderColor: GOLD, borderWidth: 1 });
  var qrImg = null;
  if (opts.qrDataURL) {
    try {
      const b64 = String(opts.qrDataURL).split(',')[1];
      const bin = atob(b64);
      const qb = new Uint8Array(bin.length);
      for (let i = 0; i < bin.length; i++) qb[i] = bin.charCodeAt(i);
      qrImg = await certDoc.embedPng(qb);
    } catch (e) { qrImg = null; }
  }
  if (qrImg) page.drawImage(qrImg, { x: qrX, y: qrY, width: qrSize, height: qrSize });
  else page.drawText(safe(opts.sealId || ''), { x: qrX, y: qrY + qrSize / 2, size: 8, font: courier, color: rgb(0.3, 0.3, 0.3) });
  var scan = 'SCAN TO VERIFY';
  page.drawText(scan, { x: qrX - 8 + (qrSize + 16 - helvBold.widthOfTextAtSize(scan, 7)) / 2, y: qrY - 22, size: 7, font: helvBold, color: GOLD });
  var vurl = 'verumglobal.foundation/verify.html';
  page.drawText(vurl, { x: qrX - 8 + (qrSize + 16 - helv.widthOfTextAtSize(vurl, 6.5)) / 2, y: qrY - 33, size: 6.5, font: helv, color: MUTE });

  // Sender identity block (PRIVATE): identity, GPS and device render ONLY when
  // opts.includePrivate is true — i.e. on the separate PRIVATE certificate the
  // sealer keeps. The default (shareable) certificate never carries them.
  // FIELD LESSON (Aug 2026): certificates travel. A "private" certificate that
  // is the only certificate ends up in shared evidence folders, and this block
  // then hands every recipient the sealer's ID number, home address and a GPS
  // fix to metres — while the sealer may be in hiding from the very people
  // receiving the folder. Identity stays off anything that can be shared by
  // default; the private variant is a second, clearly-labelled file.
  var idy = opts.includePrivate ? (opts.identity || null) : null;
  var hasIdy = !!(idy && (idy.n || idy.id || idy.a || idy.e));
  if (!opts.includePrivate && (opts.identity || opts.gps || opts.dev)) {
    var py = qrY - 54;
    page.drawText('SENDER IDENTITY', { x: qrX - 8, y: py, size: 7, font: helvBold, color: GOLD });
    py -= 11;
    var privNote = wrap('Recorded privately by the sealer. Not shown on this shareable certificate.', helv, 7, qrSize + 16);
    for (var pn = 0; pn < privNote.length; pn++) {
      page.drawText(safe(privNote[pn]), { x: qrX - 8, y: py, size: 7, font: helv, color: MUTE });
      py -= 9.5;
    }
  }
  if (opts.includePrivate && (hasIdy || opts.gps || opts.dev)) {
    var iy = qrY - 54;
    page.drawText('SENDER IDENTITY (PRIVATE)', { x: qrX - 8, y: iy, size: 7, font: helvBold, color: GOLD });
    iy -= 11;
    var idLines = [];
    if (hasIdy) {
      if (idy.n) idLines.push('Name: ' + idy.n);
      if (idy.id) idLines.push('ID: ' + idy.id);
      if (idy.a) idLines.push('Addr: ' + idy.a);
      if (idy.e) idLines.push('Email: ' + idy.e);
    }
    if (opts.gps) idLines.push('GPS: ' + opts.gps + (opts.acc ? ' (±' + opts.acc + 'm)' : ''));
    if (opts.dev) idLines.push('Device: ' + opts.dev);
    for (var ii = 0; ii < idLines.length; ii++) {
      var wl = wrap(idLines[ii], helv, 7, qrSize + 16);
      for (var wi = 0; wi < wl.length; wi++) {
        if (iy < 250) break; // keep clear of the canonical statement box
        page.drawText(safe(wl[wi]), { x: qrX - 8, y: iy, size: 7, font: helv, color: LIGHT });
        iy -= 9.5;
      }
    }
  }

  // Detail rows (left column)
  var lx = 70, rowMaxW = qrX - 40 - lx;
  function row(label, valueLines, valueFont, valueSize, gap) {
    page.drawText(safe(label), { x: lx, y: y, size: 8, font: helvBold, color: GOLD });
    y -= 14;
    for (var i = 0; i < valueLines.length; i++) {
      page.drawText(safe(valueLines[i]), { x: lx, y: y, size: valueSize, font: valueFont, color: LIGHT });
      y -= (valueSize + 4.5);
    }
    y -= (gap === undefined ? 10 : gap);
  }
  row('DOCUMENT', wrap(opts.fileName || 'document.pdf', helv, 10, rowMaxW), helv, 10);
  var h = String(opts.sha512 || '');
  row('DOCUMENT SHA-512', h ? [h.substring(0, 64), h.substring(64)] : ['n/a'], courier, 7.5);
  row('SEAL ID', [opts.sealId || 'n/a'], courier, 11);
  row('SEALED (ISO-8601)', [opts.timestampISO || 'n/a'], courier, 10);
  row('PAGES', [String(opts.pageCount || 'n/a')], helv, 10);
  var otsLines = opts.otsSubmitted
    ? wrap('SUBMITTED — digest accepted by OpenTimestamps calendar' + (opts.otsCalendar ? ' (' + opts.otsCalendar.replace(/^https?:\/\//, '').replace(/\/.*$/, '') + ')' : '') + '. Bitcoin blockchain confirmation pending (typically 1-2 hours).', helv, 8.5, rowMaxW)
    : wrap('PENDING — calendar servers were unreachable at sealing time. The SHA-256 digest is recorded in the seal and can be submitted later; the seal itself is complete and valid without the blockchain anchor.', helv, 8.5, rowMaxW);
  row('OPENTIMESTAMPS STATUS', otsLines, helv, 8.5);

  // Canonical statement box
  var boxTop = 240, boxH = 74;
  page.drawRectangle({ x: 70, y: boxTop - boxH, width: PW - 140, height: boxH, borderColor: GOLD, borderWidth: 1, color: rgb(1, 1, 1), opacity: 0.04 });
  var c1 = 'This seal proves two things only — integrity and time.';
  var c2 = 'It is not a verification of the document’s contents.';
  page.drawText(c1, { x: cx(c1, timesItalic, 12), y: boxTop - 30, size: 12, font: timesItalic, color: WHITE });
  page.drawText(c2, { x: cx(c2, timesItalic, 12), y: boxTop - 48, size: 12, font: timesItalic, color: WHITE });

  // Footer
  page.drawText('VERUM OMNIS FOUNDATION  |  PATENT PENDING', { x: cx('VERUM OMNIS FOUNDATION  |  PATENT PENDING', helvBold, 7.5), y: 52, size: 7.5, font: helvBold, color: MUTE });
  page.drawText('Verify this seal at verumglobal.foundation/verify.html', { x: cx('Verify this seal at verumglobal.foundation/verify.html', helv, 8), y: 38, size: 8, font: helv, color: GOLD });

  try { certDoc.setTitle('Verum Omnis Seal Certificate — ' + (opts.sealId || '')); } catch (e) {}
  try { certDoc.setAuthor('Verum Omnis'); } catch (e) {}
  try { certDoc.setSubject('SEAL-CERT|' + (opts.sha512 || '') + '|' + (opts.sealId || '')); } catch (e) {}
  try { certDoc.setProducer('Verum Omnis Document Sealing Service v1.2.9'); } catch (e) {}
  try { certDoc.setCreationDate(new Date()); } catch (e) {}
  return await certDoc.save();
}

// ==================== ANCHOR CERTIFICATE (OTS submitted) ====================
// One-page certificate recording the OpenTimestamps submission itself: which
// digest went to which calendars, and when. Same house style as the Seal
// Certificate (navy full bleed, gold rules, serif wordmark). It is issued only
// when a calendar accepted the digest, and it is explicitly PENDING: the
// canonical statement says exactly what the seal proves — integrity and time.
async function buildAnchorCertificate(opts) {
  opts = opts || {};
  const certDoc = await PDFDocument.create();
  const helv = await certDoc.embedFont(StandardFonts.Helvetica);
  const helvBold = await certDoc.embedFont(StandardFonts.HelveticaBold);
  const times = await certDoc.embedFont(StandardFonts.TimesRoman);
  const timesBold = await certDoc.embedFont(StandardFonts.TimesRomanBold);
  const timesItalic = await certDoc.embedFont(StandardFonts.TimesRomanItalic);
  const courier = await certDoc.embedFont(StandardFonts.Courier);
  const NAVY = rgb(0x0e/255, 0x1a/255, 0x2b/255);
  const GOLD = rgb(0xc9/255, 0xa2/255, 0x27/255);
  const LIGHT = rgb(0.85, 0.88, 0.92);
  const MUTE = rgb(0.55, 0.63, 0.72);
  const WHITE = rgb(1, 1, 1);
  const PW = 595.28, PH = 841.89;
  const page = certDoc.addPage([PW, PH]);
  page.drawRectangle({ x: 0, y: 0, width: PW, height: PH, color: NAVY });
  page.drawRectangle({ x: 0, y: PH - 6, width: PW, height: 6, color: GOLD });
  page.drawRectangle({ x: 0, y: 0, width: PW, height: 6, color: GOLD });

  // WinAnsi-safe text: fold anything the standard fonts cannot encode.
  function safe(t) {
    // Whitelist as numeric code points only — no unicode escapes and no
    // non-ASCII literals in source (transport-safe). Allowed: printable ASCII 0x20-0x7E,
    // Latin-1 0xA0-0xFF, en/em dash, curly quotes, bullet, ellipsis (all
    // WinAnsi-encodable); everything else folds to '?'.
    var s = String(t === undefined || t === null ? '' : t), out = '', i, c;
    for (i = 0; i < s.length; i++) {
      c = s.charCodeAt(i);
      out += ((c >= 0x20 && c <= 0x7E) || (c >= 0xA0 && c <= 0xFF) ||
        c === 0x2013 || c === 0x2014 || c === 0x2018 || c === 0x2019 ||
        c === 0x201C || c === 0x201D || c === 0x2022 || c === 0x2026) ? s.charAt(i) : '?';
    }
    return out;
  }
  function cx(t, font, size) { return (PW - font.widthOfTextAtSize(safe(t), size)) / 2; }
  function wrap(t, font, size, maxW) {
    var words = safe(t).split(/\s+/), lines = [], cur = '';
    for (var i = 0; i < words.length; i++) {
      var trial = cur ? cur + ' ' + words[i] : words[i];
      if (font.widthOfTextAtSize(trial, size) > maxW && cur) { lines.push(cur); cur = words[i]; }
      else cur = trial;
    }
    if (cur) lines.push(cur);
    return lines;
  }

  // Wordmark + title
  var y = PH - 78;
  page.drawText('VERUM OMNIS', { x: cx('VERUM OMNIS', timesBold, 28), y: y, size: 28, font: timesBold, color: WHITE });
  y -= 18;
  var tag = 'A I   F O R E N S I C S   F O R   T R U T H';
  page.drawText(tag, { x: cx(tag, times, 8.5), y: y, size: 8.5, font: times, color: GOLD });
  y -= 16;
  page.drawLine({ start: { x: PW / 2 - 130, y: y }, end: { x: PW / 2 + 130, y: y }, thickness: 0.8, color: GOLD });
  y -= 40;
  page.drawText('BLOCKCHAIN ANCHOR CERTIFICATE', { x: cx('BLOCKCHAIN ANCHOR CERTIFICATE', timesBold, 23), y: y, size: 23, font: timesBold, color: GOLD });
  y -= 20;
  var sub = '— PENDING CONFIRMATION';
  page.drawText(sub, { x: cx(sub, timesItalic, 11), y: y, size: 11, font: timesItalic, color: LIGHT });
  y -= 42;

  // QR panel (right column) — same verify link as the Seal Certificate
  var qrSize = 118;
  var qrX = PW - 70 - qrSize, qrY = y - qrSize + 16;
  page.drawRectangle({ x: qrX - 8, y: qrY - 8, width: qrSize + 16, height: qrSize + 16, color: WHITE, borderColor: GOLD, borderWidth: 1 });
  var qrImg = null;
  if (opts.qrDataURL) {
    try {
      const b64 = String(opts.qrDataURL).split(',')[1];
      const bin = atob(b64);
      const qb = new Uint8Array(bin.length);
      for (let i = 0; i < bin.length; i++) qb[i] = bin.charCodeAt(i);
      qrImg = await certDoc.embedPng(qb);
    } catch (e) { qrImg = null; }
  }
  if (qrImg) page.drawImage(qrImg, { x: qrX, y: qrY, width: qrSize, height: qrSize });
  else page.drawText(safe(opts.sealId || ''), { x: qrX, y: qrY + qrSize / 2, size: 8, font: courier, color: rgb(0.3, 0.3, 0.3) });
  var scan = 'SCAN TO VERIFY';
  page.drawText(scan, { x: qrX - 8 + (qrSize + 16 - helvBold.widthOfTextAtSize(scan, 7)) / 2, y: qrY - 22, size: 7, font: helvBold, color: GOLD });
  var vurl = 'verumglobal.foundation/verify.html';
  page.drawText(vurl, { x: qrX - 8 + (qrSize + 16 - helv.widthOfTextAtSize(vurl, 6.5)) / 2, y: qrY - 33, size: 6.5, font: helv, color: MUTE });

  // Detail rows (left column)
  var lx = 70, rowMaxW = qrX - 40 - lx;
  function row(label, valueLines, valueFont, valueSize, gap) {
    page.drawText(safe(label), { x: lx, y: y, size: 8, font: helvBold, color: GOLD });
    y -= 14;
    for (var i = 0; i < valueLines.length; i++) {
      page.drawText(safe(valueLines[i]), { x: lx, y: y, size: valueSize, font: valueFont, color: LIGHT });
      y -= (valueSize + 4.5);
    }
    y -= (gap === undefined ? 10 : gap);
  }
  row('SEAL ID', [opts.sealId || 'n/a'], courier, 11);
  var h = String(opts.sha512 || '');
  // Every fingerprint says which bytes it belongs to: the one anchored is the
  // ORIGINAL upload's, and the OTS digest is the SHA-256 of its hex text — an
  // expert running an OpenTimestamps client needs both facts.
  row('ORIGINAL UPLOAD SHA-512 (BEFORE THE SEAL WAS APPLIED)', h ? [h.substring(0, 64), h.substring(64)] : ['n/a'], courier, 7.5, 6);
  var hs = String(opts.sealedSha512 || '');
  if (hs) row(opts.deliveredProtected ? 'DELIVERED FILE SHA-512 (THE PASSWORD-PROTECTED COPY SENT)' : 'DELIVERED FILE SHA-512 (THE SEALED FILE AS DELIVERED)', [hs.substring(0, 64), hs.substring(64)], courier, 7.5, 6);
  row('OTS DIGEST (SHA-256 OF THE ORIGINAL SHA-512 HEX TEXT)', [opts.otsDigest || 'n/a'], courier, 7.5, 6);
  var calLines = (Array.isArray(opts.calendars) && opts.calendars.length > 0)
    ? opts.calendars.map(function(c) { return String(c).replace(/^https?:\/\//, ''); })
    : ['n/a'];
  row('OPENTIMESTAMPS CALENDARS', calLines, helv, 9);
  row('SUBMITTED (ISO-8601)', [opts.timestampISO || 'n/a'], courier, 10);
  var pendLines = wrap('Digest accepted by the calendar(s) above; Bitcoin confirmation was pending when this certificate was made (typically 1-2 hours). This certificate records the submission; the confirmed proof is fetched by uploading the sealed PDF to verify.html.', helv, 8.5, rowMaxW);
  row('ANCHOR STATUS', pendLines, helv, 8.5);

  // Plain-language explanation for a non-technical recipient: what the seal
  // proves and how, in ordinary words. Fills the certificate body so the
  // reader understands tamper-evidence, SHA-512, the permanent blockchain
  // record and how to verify — without needing any technical background.
  y -= 6;
  page.drawText(safe('WHAT THIS CERTIFICATE PROVES'), { x: lx, y: y, size: 9.5, font: helvBold, color: GOLD });
  y -= 17;
  var explain = [
    // Every sentence says what the seal can truthfully claim when this
    // certificate is made: the digest is submitted and the Bitcoin
    // confirmation is pending (the report's own wording since PR #213).
    ['Any change is detectable.',
     'The original upload\'s SHA-512 was computed from its exact bytes before the seal was applied: change a single character and the fingerprint changes completely.' + (hs ? ' The delivered file\'s SHA-512 is printed above too (as any sha512sum tool computes it); a copy whose fingerprint differs is not the file delivered.' : '')],
    ['What SHA-512 is.',
     'A one-way hash: it turns the whole document into a fixed 128-character fingerprint that cannot be reversed. The same bytes always give the same fingerprint, and no practical way is known to make a different document with the same one.'],
    ['A public timestamp, once Bitcoin confirms it.',
     'The digest above was submitted to OpenTimestamps; the Bitcoin confirmation was pending when this certificate was made. Once confirmed, the Bitcoin block proves the fingerprint existed no later than that block\'s time. The submission time above is the sealing device\'s clock; the anchor does not prove it.'],
    ['How to check it.',
     (opts.deliveredProtected
       ? 'For the integrity check, upload the unprotected sealed copy to verumglobal.foundation/verify.html (the password-protected copy must be opened with its password first). '
       : 'For the integrity check, upload the sealed PDF to verumglobal.foundation/verify.html. ') +
     'Upload this certificate there to check the anchor status of its digest: the page asks the OpenTimestamps calendars for the confirmed proof. To check the Bitcoin block yourself, run an OpenTimestamps client (ots verify) against a Bitcoin node.']
  ];
  for (var ei = 0; ei < explain.length; ei++) {
    page.drawText(safe('•  ' + explain[ei][0]), { x: lx, y: y, size: 8.5, font: helvBold, color: LIGHT });
    y -= 12.5;
    var elines = wrap(explain[ei][1], helv, 8, PW - 150);
    for (var el = 0; el < elines.length; el++) { page.drawText(safe(elines[el]), { x: lx + 12, y: y, size: 8, font: helv, color: MUTE }); y -= 10.5; }
    y -= 7;
  }
  // Canonical governance statement (kept verbatim) closes the body.
  y -= 2;
  var canonical = 'The seal proves two things only — integrity and time. Findings, if any, are produced by the deterministic engine and anchored to quoted text and page references; the Court remains the arbiter of what the documents establish.';
  var cLines = wrap(canonical, timesItalic, 9.5, PW - 150);
  for (var ci = 0; ci < cLines.length; ci++) {
    page.drawText(cLines[ci], { x: cx(cLines[ci], timesItalic, 9.5), y: y, size: 9.5, font: timesItalic, color: WHITE });
    y -= 14;
  }

  // Footer
  page.drawText('VERUM OMNIS FOUNDATION  |  PATENT PENDING', { x: cx('VERUM OMNIS FOUNDATION  |  PATENT PENDING', helvBold, 7.5), y: 52, size: 7.5, font: helvBold, color: MUTE });
  page.drawText('Check the seal and its anchor at verumglobal.foundation/verify.html', { x: cx('Check the seal and its anchor at verumglobal.foundation/verify.html', helv, 8), y: 38, size: 8, font: helv, color: GOLD });

  try { certDoc.setTitle('Verum Omnis Anchor Certificate — ' + (opts.sealId || '')); } catch (e) {}
  try { certDoc.setAuthor('Verum Omnis'); } catch (e) {}
  try { certDoc.setSubject('ANCHOR-CERT|' + (opts.otsDigest || '') + '|' + (opts.sealId || '')); } catch (e) {}
  try { certDoc.setProducer('Verum Omnis Document Sealing Service v1.3.0'); } catch (e) {}
  try { certDoc.setCreationDate(new Date()); } catch (e) {}
  // No object streams: the Info dictionary stays readable to verify.html's
  // raw scan and to its find-a-sealed-document scanner.
  return await certDoc.save({ useObjectStreams: false });
}

// ==================== SEALING FLOW v1.2.6 ====================

// ==================== VOICE-NOTE / AUDIO BATCH SEALING ====================
// Each audio file is sealed AS-IS, individually: SHA-512 + SHA-256, seal ID,
// OpenTimestamps submission, QR payload, shareable Seal Certificate (and a
// PRIVATE certificate when identity/GPS/device were captured — same two-latch
// privacy design as documents: the shareable artifacts NEVER carry identity).
// Deliverables: ONE shareable ZIP (original audio + certificates + .ots
// receipts) and, separately, a PRIVATE-certificates ZIP that must not be
// distributed. The audio bytes are untouched throughout — the original file
// IS the evidence; the certificate and receipt carry the seal record.
function voRenderAudioFiles() {
  var info = document.getElementById('fileInfo');
  var list = document.getElementById('fileList');
  if (!selectedAudioFiles.length) { if (selectedFiles.length === 0) { info.classList.remove('visible'); list.innerHTML = ''; document.getElementById('sealBtn').disabled = true; } return; }
  info.classList.add('visible');
  document.getElementById('sealBtn').disabled = false;
  var total = selectedAudioFiles.reduce(function (s, x) { return s + x.size; }, 0);
  document.getElementById('fileName').textContent = '🎤 ' + selectedAudioFiles.length + ' recording' + (selectedAudioFiles.length === 1 ? '' : 's') + ' — each sealed as-is with its own certificate';
  document.getElementById('fileSize').textContent = (total / 1024 / 1024).toFixed(2) + ' MB total';
  var rows = selectedAudioFiles.map(function (f, i) {
    return '<div style="display:flex;justify-content:space-between;gap:12px;padding:3px 0;">' +
      '<span>' + (i + 1) + '. ' + escapeHtml(f.name) + ' <span style="color:#4A7EC7;">(' + (f.size / 1024).toFixed(0) + ' KB)</span></span>' +
      '<span style="cursor:pointer;color:#ef4444;" onclick="selectedAudioFiles.splice(' + i + ',1);voRenderAudioFiles();">✕</span></div>';
  });
  if (voManifestFile) {
    rows.push('<div style="display:flex;justify-content:space-between;gap:12px;padding:3px 0;color:#D4A843;">' +
      '<span>💬 Chat export: ' + escapeHtml(voManifestFile.name) + '</span>' +
      '<span style="cursor:pointer;color:#ef4444;" onclick="voManifestFile=null;voRenderAudioFiles();">✕</span></div>');
  }
  for (var si = 0; si < voScreenshotFiles.length; si++) {
    rows.push('<div style="display:flex;justify-content:space-between;gap:12px;padding:3px 0;color:#4A7EC7;">' +
      '<span>🖼 Screenshot: ' + escapeHtml(voScreenshotFiles[si].name) + '</span>' +
      '<span style="cursor:pointer;color:#ef4444;" onclick="voScreenshotFiles.splice(' + si + ',1);voRenderAudioFiles();">✕</span></div>');
  }
  // Transcription follows the sealing mode (founder direction 2026-09-07): on
  // with "Seal document with forensic report", never in "Seal document".
  var tcOn = (typeof sealMode !== 'undefined' && sealMode === 'forensic');
  rows.push('<div id="voTranscribeNote" style="margin-top:10px;padding:8px 10px;border:1px solid #D4A843;border-radius:6px;">' +
    '<div style="display:flex;gap:8px;align-items:flex-start;font-size:12.5px;color:#F8F9FA;">' +
    '<span style="margin-top:1px;">' + (tcOn ? '&#9679;' : '&#9675;') + '</span>' +
    '<span><strong>Transcription: ' + (tcOn ? 'on (Seal document with forensic report)' : 'off (Seal document)') + '.</strong> With a forensic report, each recording is sent to the AI service for machine transcription — <strong style="color:#D4A843;">the audio leaves this device for that step</strong>, unlike sealing, which is entirely local. Transcripts appear in the Evidence Report under a machine-transcript banner: they are reading aids, not evidence — the sealed audio is. Leave unticked for privileged or sensitive recordings.</span></div></div>');
  rows.push('<div style="font-size:12px;color:#8ea3b5;margin-top:8px;line-height:1.6;">Audio is sealed exactly as-is: the SHA-512 fingerprint and Bitcoin anchor cover these exact bytes, and the seal record lives on the certificate and .ots receipt. The audio file is never altered. A transcript is not evidence — the sealed audio is.' +
    ' Add the WhatsApp chat export (.txt, from Export chat — or drop the whole export .zip here; it is unpacked on this device) to tie each note to its sender and time in WhatsApp\'s own words, and screen grabs (.png/.jpg) as visual corroboration — a Voice-Note Evidence Report will be built and sealed with the batch.</div>');
  list.innerHTML = rows.join('');
}

// Best-effort duration via the browser's own decoder. Not every browser can
// decode .opus (Safari cannot); a failure is disclosed as "not determined on
// this device", never guessed.
function voAudioDuration(file) {
  return new Promise(function (resolve) {
    var url; var done = false;
    var finish = function (v) { if (done) return; done = true; try { URL.revokeObjectURL(url); } catch (e) {} resolve(v); };
    try {
      url = URL.createObjectURL(file);
      var a = new Audio();
      a.preload = 'metadata';
      a.onloadedmetadata = function () { finish(isFinite(a.duration) ? a.duration : null); };
      a.onerror = function () { finish(null); };
      a.src = url;
      setTimeout(function () { finish(null); }, 4000);
    } catch (e) { finish(null); }
  });
}

// ==================== VOICE-NOTE EVIDENCE REPORT ====================
// One sealed PDF recording, for each note: the fingerprint and seal record,
// the device-reported file details, and — when a chat export was supplied —
// the export line that references the file, QUOTED VERBATIM (the parsed
// sender/time are labelled as coming from the export, never from the audio).
// HARD RULES, stated in the report itself: no transcription unless the sealer
// ticked the consent box — and then every transcript is rendered under a
// machine-transcript banner as a reading aid, never evidence, and the intro
// discloses that transcripts are present; no assertion of who is speaking; an
// audio file carries no sender identity — attribution comes from the chat
// export, and voice identification is for a witness or the court. Screenshots
// are exhibits: fingerprinted and embedded, with pairing left to the reader
// against the chat export.
async function buildVoiceNoteReport(items, manifest, shots, generatedAt) {
  var doc = await PDFLib.PDFDocument.create();
  var helv = await doc.embedFont(PDFLib.StandardFonts.Helvetica);
  var helvB = await doc.embedFont(PDFLib.StandardFonts.HelveticaBold);
  var courier = await doc.embedFont(PDFLib.StandardFonts.Courier);
  var NAVY = PDFLib.rgb(0x0e / 255, 0x1a / 255, 0x2b / 255);
  var GOLD = PDFLib.rgb(0xD4 / 255, 0xA8 / 255, 0x43 / 255);
  var GRAY = PDFLib.rgb(0.35, 0.4, 0.45);
  var PW = 595.28, PH = 841.89, MARGIN = 60, y, page;
  // The globe watermark is part of the sealed look on every Verum report;
  // its absence reads as an unofficial document. Drawn first so all text
  // sits above it. A failed fetch never blocks the report.
  var wmImg = null;
  try {
    var wmB = await voEnsureWatermark();
    if (wmB) wmImg = await doc.embedPng(wmB);
  } catch (eWm) { wmImg = null; }
  function newPage() {
    page = doc.addPage([PW, PH]);
    if (wmImg) {
      var wmS = Math.min((PW * 0.72) / wmImg.width, (PH * 0.72) / wmImg.height);
      page.drawImage(wmImg, { x: (PW - wmImg.width * wmS) / 2, y: (PH - wmImg.height * wmS) / 2 - 10, width: wmImg.width * wmS, height: wmImg.height * wmS, opacity: 0.15 });
    }
    y = PH - MARGIN;
  }
  function ensure(h) { if (y - h < MARGIN) newPage(); }
  function wrapText(t, font, size, w) {
    var words = String(t).split(/\s+/), lines = [], cur = '';
    for (var i = 0; i < words.length; i++) {
      var cand = cur ? cur + ' ' + words[i] : words[i];
      if (font.widthOfTextAtSize(cand, size) > w && cur) { lines.push(cur); cur = words[i]; }
      else cur = cand;
    }
    if (cur) lines.push(cur);
    return lines;
  }
  function para(t, opts) {
    opts = opts || {};
    var font = opts.font || helv, size = opts.size || 10, color = opts.color || NAVY;
    var lines = wrapText(t, font, size, PW - 2 * MARGIN);
    for (var i = 0; i < lines.length; i++) { ensure(size + 4); page.drawText(lines[i], { x: MARGIN, y: y, size: size, font: font, color: color }); y -= size + 4; }
    y -= (opts.after === undefined ? 4 : opts.after);
  }
  function mono(t, size) {
    var lines = wrapText(t, courier, size || 8, PW - 2 * MARGIN);
    for (var i = 0; i < lines.length; i++) { ensure(12); page.drawText(lines[i], { x: MARGIN, y: y, size: size || 8, font: courier, color: GRAY }); y -= 11; }
  }
  // Local time first, UTC beside it. The zone is the DEVICE's setting (an
  // IANA name like Africa/Johannesburg) — country-level, so it never
  // discloses the sealer's position the way coordinates would.
  function voDualStamp(d) {
    var dt = new Date(d);
    var tz = 'device zone unknown';
    try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || tz; } catch (eTz) {}
    function p2(n) { return (n < 10 ? '0' : '') + n; }
    var loc = dt.getFullYear() + '-' + p2(dt.getMonth() + 1) + '-' + p2(dt.getDate()) + ' ' + p2(dt.getHours()) + ':' + p2(dt.getMinutes()) + ':' + p2(dt.getSeconds());
    return loc + ' (' + tz + ', device time) = ' + dt.toISOString().substring(0, 19) + ' UTC';
  }
  newPage();
  page.drawText('VOICE-NOTE EVIDENCE REPORT', { x: MARGIN, y: y, size: 20, font: helvB, color: NAVY }); y -= 26;
  page.drawText('Verum Omnis — sealed audio custody record', { x: MARGIN, y: y, size: 10, font: helv, color: GOLD }); y -= 22;
  para('Generated: ' + voDualStamp(generatedAt) + '   |   Recordings: ' + items.length +
    (manifest ? '   |   Chat export: supplied' : '   |   Chat export: not supplied') +
    (shots.length ? '   |   Screenshots: ' + shots.length : ''), { size: 9, color: GRAY, after: 10 });
  para('WHAT THIS REPORT IS', { font: helvB, size: 11, after: 2 });
  para('The sealed audio files are the evidence. This report records, for each recording: its cryptographic fingerprint and seal identifier, the file details as supplied to the sealing device, and — where a WhatsApp chat export was supplied — the export line that references the file, quoted verbatim.', { size: 9.5 });
  var anyTranscript = false;
  for (var atI = 0; atI < items.length; atI++) if (items[atI].transcript) { anyTranscript = true; break; }
  if (anyTranscript) {
    para('At the sealer\'s explicit request, machine transcripts are included below. A transcript is a reading aid produced by a speech-recognition model, not evidence — the sealed audio is. Nothing in this report identifies who is speaking in any recording. Attribution of a voice is for a witness or the court.', { font: helvB, size: 9.5 });
  } else {
    para('This report contains no transcription of any recording, and nothing in it identifies who is speaking in any recording. Attribution of a voice is for a witness or the court.', { font: helvB, size: 9.5 });
  }
  para('Sender names and times shown below come from the supplied chat export, not from the audio files: an audio file carries no sender identity. The export line is quoted verbatim so the reader can check every label against WhatsApp\'s own record.', { size: 9.5, after: 10 });
  if (manifest) {
    para('CHAT EXPORT ON RECORD', { font: helvB, size: 11, after: 2 });
    para(manifest.name + '  (' + manifest.lineCount + ' lines)', { size: 9.5, after: 1 });
    mono('SHA-512: ' + manifest.sha512); y -= 6;
  } else {
    para('No chat export was supplied. The recordings stand on their fingerprints alone; nothing in this report attributes any recording to a sender.', { size: 9.5, color: GRAY, after: 8 });
  }
  for (var n = 0; n < items.length; n++) {
    var it = items[n];
    ensure(120);
    y -= 6;
    page.drawLine({ start: { x: MARGIN, y: y }, end: { x: PW - MARGIN, y: y }, thickness: 0.5, color: GOLD }); y -= 14;
    para('RECORDING ' + (n + 1) + ' — ' + it.name, { font: helvB, size: 11, after: 2 });
    mono('SHA-512: ' + it.sha512);
    para('Seal ID: ' + it.sealId + '    |    Size: ' + (it.size / 1024).toFixed(1) + ' KB' +
      (it.duration !== null ? '    |    Duration: ' + Math.floor(it.duration / 60) + 'm ' + Math.round(it.duration % 60) + 's (as decoded on the sealing device)' : '    |    Duration: not determined on this device'), { size: 9 });
    para('Blockchain anchor: ' + (it.otsSubmitted ? 'digest accepted by OpenTimestamps calendar; Bitcoin confirmation upgrades the .ots receipt' : 'submission pending — re-seal later to anchor'), { size: 9 });
    para('Device-reported file date: ' + (it.lastModified ? voDualStamp(it.lastModified) : 'not available') +
      (it.isVideo ? '    |    Type: video recording (sealed as-is, not transcribed)' : ''), { size: 9 });
    if (it.transcript) {
      para('MACHINE TRANSCRIPT — reading aid, not evidence', { font: helvB, size: 9, color: GOLD, after: 2 });
      para('Produced by an automatic speech-recognition model at the sealer\'s request. The model can mis-hear words; verify every quoted word against the sealed audio, which is the evidence. Nothing in this transcript identifies who is speaking.', { size: 8, color: GRAY, after: 3 });
      para('“' + it.transcript.substring(0, 4000) + (it.transcript.length > 4000 ? ' …' : '') + '”', { size: 9 });
    } else if (it.transcriptNote) {
      para('Transcript: ' + it.transcriptNote + '.', { size: 8.5, color: GRAY });
    }
    // Sending metadata closes each recording's block, so a transcript is
    // always followed by the record of when and by whom the note was sent.
    if (it.manifestHit) {
      para('Chat-export line referencing this file (verbatim):', { font: helvB, size: 9, after: 2 });
      mono('"' + it.manifestHit.line + '"', 8.5);
      if (it.manifestHit.sender) {
        para('As recorded in the chat export: sent by ' + it.manifestHit.sender + (it.manifestHit.ts ? ' at ' + it.manifestHit.ts : '') + '.', { size: 9 });
      }
    } else {
      if (manifest) para('This file is not referenced by name in the supplied chat export.', { size: 9, color: GRAY });
      var nmDate = voNameDate(it.name);
      if (nmDate) para('The file name follows WhatsApp\'s naming pattern and carries the date ' + nmDate + '. A file name is assigned by the device, not proof of sending time — supply the chat export (.txt) for the sending record.', { size: 8.5, color: GRAY });
    }
  }
  if (shots.length) {
    newPage();
    para('SCREENSHOTS SUPPLIED AS VISUAL CORROBORATION', { font: helvB, size: 12, after: 2 });
    para('Each image below was supplied by the sealer alongside the recordings and is fingerprinted here. A screenshot shows what a screen displayed at capture; pairing any image with any particular recording is for the reader, against the chat export.', { size: 9, after: 8 });
    for (var s = 0; s < shots.length; s++) {
      var img = null;
      try { img = /\.png$/i.test(shots[s].name) ? await doc.embedPng(shots[s].bytes) : await doc.embedJpg(shots[s].bytes); } catch (eImg) { img = null; }
      var capH = 26;
      if (img) {
        var maxW = PW - 2 * MARGIN, maxH = 520;
        var scale = Math.min(maxW / img.width, maxH / img.height, 1);
        var iw = img.width * scale, ih = img.height * scale;
        ensure(ih + capH + 16);
        page.drawImage(img, { x: MARGIN, y: y - ih, width: iw, height: ih });
        y -= ih + 6;
      } else {
        ensure(capH + 16);
        para('(image could not be embedded — the original file is in the sealed bundle)', { size: 8.5, color: GRAY, after: 2 });
      }
      para(shots[s].name, { size: 8.5, after: 1 });
      mono('SHA-512: ' + shots[s].sha512.substring(0, 64) + '…', 7.5);
      y -= 10;
    }
  }
  try { doc.setTitle('Verum Omnis Voice-Note Evidence Report'); } catch (e) {}
  try { doc.setAuthor('Verum Omnis'); } catch (e) {}
  try { doc.setCreationDate(generatedAt); } catch (e) {}
  return await doc.save();
}

async function voSealAudioBatch() {
  var files = selectedAudioFiles.slice(0, VO_AUDIO_MAX_FILES);
  if (!files.length) return;
  var btn = document.getElementById('sealBtn');
  btn.disabled = true;
  // Forensic mode transcribes on the service; the same pre-flight applies.
  if (typeof sealMode !== 'undefined' && sealMode === 'forensic') {
    var _preA = await voPreflightForensicService();
    if (!_preA.ok) {
      var _hostA = (typeof location !== 'undefined' && location.host) ? location.host : 'this address';
      voShowPreflightBlock(voPreflightMessage(_preA, _hostA));
      btn.disabled = false;
      return;
    }
  }
  var list = document.getElementById('fileList');
  var status = document.createElement('div');
  status.id = 'audioSealStatus';
  status.style.cssText = 'font-size:13px;color:#D4A843;margin-top:10px;line-height:1.7;';
  var old = document.getElementById('audioSealStatus'); if (old) old.remove();
  list.parentNode.appendChild(status);
  try { captureDevice(); } catch (e) {}
  try { if (!gpsCoords) gpsCoords = await captureGPS(); } catch (e) { gpsCoords = null; }
  var shareEntries = [], privEntries = [], rows = [], anyPending = false;
  var hasIdentity = false;
  // Manifest + screenshots are read up front so each recording can carry its
  // chat-export line, and the report can fingerprint every companion file.
  var manifestInfo = null;
  if (voManifestFile) {
    try {
      var manBytes = new Uint8Array(await voManifestFile.arrayBuffer());
      var manText = new TextDecoder('utf-8').decode(manBytes);
      manifestInfo = { name: voManifestFile.name, text: manText,
        lineCount: manText.split(/\r?\n/).length,
        sha512: await computeSHA512(manBytes), bytes: manBytes };
    } catch (eMan) { manifestInfo = null; }
  }
  var shotInfos = [];
  for (var sc = 0; sc < voScreenshotFiles.length; sc++) {
    try {
      var scBytes = new Uint8Array(await voScreenshotFiles[sc].arrayBuffer());
      shotInfos.push({ name: voScreenshotFiles[sc].name, bytes: scBytes, sha512: await computeSHA512(scBytes) });
    } catch (eShot) {}
  }
  var reportItems = [];
  for (var i = 0; i < files.length; i++) {
    var f = files[i];
    status.textContent = 'Sealing ' + (i + 1) + ' of ' + files.length + ': ' + f.name + ' …';
    try {
      var bytes = new Uint8Array(await f.arrayBuffer());
      var sha512 = await computeSHA512(bytes);
      var otsDigestHex = await computeSHA256(bytes);
      var sealId = 'VO-' + sha512.substring(0, 12).toUpperCase();
      var otsResult = await submitToOTS(otsDigestHex);
      if (!otsResult.success) anyPending = true;
      var meta = collectSealMetadata();
      meta.sha512 = sha512; meta.otsDigest = otsDigestHex; meta.otsStatus = !!otsResult.success; meta.sealId = sealId;
      hasIdentity = hasIdentity || !!(meta.id || meta.gps || meta.dev);
      var qrContent = 'https://verumglobal.foundation/verify.html?h=' + sha512.substring(0, 32) + '&m=' + encodeURIComponent(utf8ToBase64(JSON.stringify(buildQrPayload(meta, null))));
      var qrDataURL = await generateQRDataURL(qrContent, 400);
      var certBase = { fileName: f.name, sha512: sha512, sealId: sealId,
        timestampISO: new Date(meta.t).toISOString(), pageCount: null,
        otsSubmitted: !!otsResult.success, otsCalendar: otsResult.calendar || null, qrDataURL: qrDataURL };
      var certBytes = await buildSealCertificate(Object.assign({}, certBase, {
        identity: meta.id || null, gps: meta.gps || null, dev: meta.dev || null }));
      var baseName = f.name.replace(/\.[^.]+$/, '');
      shareEntries.push({ name: f.name, bytes: bytes });
      shareEntries.push({ name: baseName + '-' + sealId + '-seal-certificate.pdf', bytes: new Uint8Array(certBytes) });
      if (meta.id || meta.gps || meta.dev) {
        try {
          var privBytes = await buildSealCertificate(Object.assign({}, certBase, {
            includePrivate: true, identity: meta.id || null, gps: meta.gps || null,
            acc: meta.acc || null, dev: meta.dev || null }));
          privEntries.push({ name: baseName + '-' + sealId + '-seal-certificate-PRIVATE.pdf', bytes: new Uint8Array(privBytes) });
        } catch (privErr) { console.warn('Private certificate failed for ' + f.name + ':', privErr); }
      }
      if (otsResult.success && window.VoOts) {
        var receiptBytes = null;
        try {
          if (otsResult.proof && otsResult.proof.length > 0) {
            var cand = VoOts.buildFileFromFragment(otsDigestHex, otsResult.proof);
            var probe = VoOts.parseSummary(cand);
            if (probe.valid && probe.attestations.some(function (a) { return a.type === 'pending'; })) receiptBytes = cand;
          }
        } catch (eF) { receiptBytes = null; }
        if (!receiptBytes) { try { receiptBytes = VoOts.buildPendingReceipt(otsDigestHex, [otsResult.calendar]); } catch (eP) { receiptBytes = null; } }
        if (receiptBytes) shareEntries.push({ name: baseName + '-' + sealId + '.ots', bytes: new Uint8Array(receiptBytes) });
      }
      reportItems.push({ name: f.name, size: f.size, lastModified: f.lastModified || null,
        sha512: sha512, sealId: sealId, otsSubmitted: !!otsResult.success,
        duration: await voAudioDuration(f), file: f, isVideo: voIsVideoFile(f),
        manifestHit: manifestInfo ? voManifestLineFor(manifestInfo.text, f.name) : null });
      rows.push('✓ ' + f.name + ' — ' + sealId + (otsResult.success ? '' : ' (blockchain anchor pending retry)'));
    } catch (err) {
      rows.push('✕ ' + f.name + ' — sealing failed: ' + (err && err.message ? err.message.substring(0, 80) : 'unknown error'));
    }
    status.innerHTML = escapeHtml(rows.join('\n')).replace(/\n/g, '<br>');
  }
  // Transcription — runs AFTER every recording is sealed, so the evidence is
  // anchored whether or not this step succeeds. The audio leaves the device
  // ONLY here, only in "Seal document with forensic report" (the mode card
  // says so), and a failure never blocks anything: the note simply carries no
  // transcript.
  var tcOn = (typeof sealMode !== 'undefined' && sealMode === 'forensic');
  if (tcOn) {
    for (var ti = 0; ti < reportItems.length; ti++) {
      // reportItems only holds files that SEALED — index into it, never into
      // the raw selection, or a failed seal shifts every later transcript
      // onto the wrong recording.
      var tf = reportItems[ti].file;
      if (tf && voIsVideoFile(tf)) { reportItems[ti].transcript = null; reportItems[ti].transcriptNote = 'not transcribed — video recordings are sealed as-is; transcription covers voice notes only'; continue; }
      if (!tf || tf.size > 6 * 1024 * 1024) { reportItems[ti].transcript = null; reportItems[ti].transcriptNote = 'not transcribed — recording exceeds the transcription size limit'; continue; }
      status.textContent = 'Transcribing ' + (ti + 1) + ' of ' + reportItems.length + ' (audio leaves this device for this step)…';
      try {
        var tBytes = new Uint8Array(await tf.arrayBuffer());
        var tB64 = ''; for (var tb = 0; tb < tBytes.length; tb += 0x8000) tB64 += String.fromCharCode.apply(null, tBytes.subarray(tb, tb + 0x8000));
        var tRes = await fetch('/api/v1/ai/transcribe', { method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ audio: btoa(tB64), name: tf.name }) });
        var tRaw = await tRes.text().catch(function () { return ''; });
        var tJson = null; try { tJson = JSON.parse(tRaw); } catch (tpe) {}
        if (tRes.ok && tJson && tJson.machineGenerated === true && tJson.text) {
          reportItems[ti].transcript = tJson.text;
        } else {
          reportItems[ti].transcript = null;
          // Name what actually answered. A worker failure carries its error
          // code (and detail); anything else — an edge error page, a
          // challenge, a misroute — is identified by status, content type and
          // a tag-stripped snippet, so no failure is ever just "service
          // error" again.
          var tWhy = tJson && tJson.error
            ? tJson.error + (tJson.detail ? ': ' + String(tJson.detail).slice(0, 160) : '')
            : 'HTTP ' + tRes.status + ' ' + ((tRes.headers.get('content-type') || 'no content-type').split(';')[0]) +
              (tRaw ? ' — ' + tRaw.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 120) : '');
          reportItems[ti].transcriptNote = 'transcription unavailable (' + tWhy + ') — the sealed audio is unaffected';
        }
      } catch (tErr) {
        reportItems[ti].transcript = null;
        reportItems[ti].transcriptNote = 'transcription failed (' + String((tErr && tErr.message) || 'network error').slice(0, 120) + ') — the sealed audio is unaffected';
      }
    }
    status.innerHTML = escapeHtml(rows.join('\n')).replace(/\n/g, '<br>');
  }
  // The Voice-Note Evidence Report: built from the sealed items, then itself
  // sealed through the standard report path (QR + footer + self-integrity).
  var voiceReportUrl = null;
  if (reportItems.length) {
    try {
      status.textContent = 'Building Voice-Note Evidence Report…';
      var vrBytes = await buildVoiceNoteReport(reportItems, manifestInfo, shotInfos, new Date());
      var vrSha512 = await computeSHA512(new Uint8Array(vrBytes));
      var vrSealId = 'VO-' + vrSha512.substring(0, 12).toUpperCase();
      var vrQrContent = 'https://verumglobal.foundation/verify.html?h=' + vrSha512.substring(0, 32);
      var vrQr = await generateQRDataURL(vrQrContent, 400);
      var vrSealed = (window.VerumReport && typeof window.VerumReport.seal === 'function')
        ? await window.VerumReport.seal(vrBytes, { sealId: vrSealId, sha512: vrSha512, qrDataURL: vrQr, sourceName: 'voice-note batch (' + reportItems.length + ' recordings)' })
        : vrBytes;
      shareEntries.push({ name: 'voice-note-evidence-report-sealed.pdf', bytes: new Uint8Array(vrSealed) });
      if (manifestInfo) shareEntries.push({ name: manifestInfo.name, bytes: manifestInfo.bytes });
      for (var so = 0; so < shotInfos.length; so++) shareEntries.push({ name: shotInfos[so].name, bytes: shotInfos[so].bytes });
      voiceReportUrl = URL.createObjectURL(new Blob([vrSealed], { type: 'application/pdf' }));
    } catch (vrErr) {
      console.warn('Voice-note report failed (individual seals unaffected):', vrErr);
      rows.push('✕ Voice-Note Evidence Report could not be built — the individual seals and certificates are unaffected.');
      status.innerHTML = escapeHtml(rows.join('\n')).replace(/\n/g, '<br>');
    }
  }
  var out = ['<div style="margin-top:10px;">'];
  if (voiceReportUrl) {
    out.push('<a class="download-btn" href="' + voiceReportUrl + '" download="voice-note-evidence-report-sealed.pdf">⬇ Download Voice-Note Evidence Report (sealed PDF)</a>');
  }
  if (shareEntries.length) {
    var zipUrl = URL.createObjectURL(voZipBundle(shareEntries));
    out.push('<a class="download-btn" href="' + zipUrl + '" download="voice-notes-sealed.zip">⬇ Download sealed voice notes (ZIP: audio + certificates + receipts)</a>');
  }
  if (privEntries.length) {
    var privUrl = URL.createObjectURL(voZipBundle(privEntries));
    out.push('<a class="download-btn" href="' + privUrl + '" download="voice-notes-PRIVATE-certificates-do-not-share.zip">⬇ Download PRIVATE certificates (your records only)</a>');
  }
  out.push('<div style="font-size:12px;color:#8ea3b5;margin-top:8px;line-height:1.6;">Keep each audio file together with its certificate and .ots receipt — the audio bytes are the evidence and were not modified. The certificate proves integrity and time only.' +
    (privEntries.length ? ' The PRIVATE ZIP carries your identity details — never place it in a shared folder.' : '') +
    (anyPending ? ' One or more blockchain submissions did not reach a calendar — re-seal those files later to anchor them.' : ' Bitcoin confirmation typically completes within 1–2 hours; verify later at verumglobal.foundation/verify.html.') + '</div></div>');
  // Restore the per-file seal rows: "Building report…" must not be the last
  // thing the user sees in place of which files actually sealed.
  status.innerHTML = escapeHtml(rows.join('\n')).replace(/\n/g, '<br>') + out.join('');
  btn.disabled = false;
}

// The forensic service answers /api/v1/site/health with JSON; a host with no
// API (the old Pages copy, the March mock-up) answers with HTML or 405. Only
// a JSON {ok:true} clears forensic mode. Never called in Seal document mode.
var VO_PREFLIGHT_TIMEOUT_MS = 8000;
async function voPreflightForensicService(fetchImpl) {
  var doFetch = fetchImpl || ((typeof fetch === 'function') ? fetch : null);
  if (!doFetch) return { ok: true, skipped: true };
  var once = async function () {
    var ctrl = (typeof AbortController === 'function') ? new AbortController() : null;
    var timer = ctrl ? setTimeout(function () { try { ctrl.abort(); } catch (eT) {} }, VO_PREFLIGHT_TIMEOUT_MS) : null;
    try {
      var r = await doFetch('/api/v1/site/health', { cache: 'no-store', headers: { accept: 'application/json' }, signal: ctrl ? ctrl.signal : undefined });
      var ct = String((r.headers && r.headers.get && r.headers.get('content-type')) || '').toLowerCase();
      if (ct.indexOf('application/json') === -1) return { ok: false, reason: 'no_api_at_this_address', status: r.status };
      var j = null;
      try { j = await r.json(); } catch (eJ) { return { ok: false, reason: 'no_api_at_this_address', status: r.status }; }
      if (!j || j.ok !== true) return { ok: false, reason: 'service_unhealthy', status: r.status };
      return { ok: true };
    } catch (e) {
      return { ok: false, reason: (e && e.name === 'AbortError') ? 'timeout' : 'unreachable' };
    } finally { if (timer) clearTimeout(timer); }
  };
  var first = await once();
  // A dropped connection is retried once; an answer that is not the service is final.
  if (!first.ok && (first.reason === 'unreachable' || first.reason === 'timeout')) return await once();
  return first;
}
// The words the person sealing sees when forensic mode cannot run here.
function voPreflightMessage(pre, host) {
  var tail = '\n\nOpen https://webdocsol.liamhigh78.workers.dev/seal-document.html and try again, or choose Seal document (no analysis; nothing leaves this device).';
  if (pre.reason === 'unreachable' || pre.reason === 'timeout') {
    return 'Seal document with forensic report needs the forensic service, and it could not be reached from ' + host + ' (' + (pre.reason === 'timeout' ? 'no answer within ' + Math.round(VO_PREFLIGHT_TIMEOUT_MS / 1000) + ' seconds' : 'network error') + '). Nothing was sealed. Check the connection and try again.' + tail;
  }
  if (pre.reason === 'service_unhealthy') {
    return 'Seal document with forensic report needs the forensic service, and the service at ' + host + ' reports itself unhealthy' + (pre.status ? ' (HTTP ' + pre.status + ')' : '') + '. Nothing was sealed. Try again shortly.' + tail;
  }
  return 'Seal document with forensic report needs the forensic service, and ' + host + ' has none: it answered with a web page instead of the service' + (pre.status ? ' (HTTP ' + pre.status + ')' : '') + '. The AI review, the Brain 9 sweep, the signed rule package and the court-ready narrative cannot run here, so no forensic report was produced and nothing was sealed.' + tail;
}
function voShowPreflightBlock(msg) {
  try {
    var el = document.getElementById('preflightBanner');
    if (!el) {
      el = document.createElement('div');
      el.id = 'preflightBanner';
      el.setAttribute('role', 'alert');
      el.style.cssText = 'margin:12px 0;padding:12px 14px;border:1px solid #c0392b;border-radius:8px;background:#fdecea;color:#7b1d12;font-size:13px;line-height:1.6;white-space:pre-line;';
      var btn = document.getElementById('sealBtn');
      if (btn && btn.parentNode) btn.parentNode.insertBefore(el, btn.nextSibling); else document.body.appendChild(el);
    }
    el.textContent = msg;
    el.hidden = false;
  } catch (e) {}
  try { alert(msg); } catch (eA) {}
}

async function startSealing() {
  if (selectedAudioFiles.length) { return voSealAudioBatch(); }
  if (!selectedFile && selectedFiles.length === 0) return;

  // Free any blob: URLs from a previous seal/retry before we build a large new
  // one — otherwise each attempt on a big document piles tens of MB of
  // un-revoked object URLs onto the tab until downloads/share start failing.
  voRevokeAllObjectURLs();

  // Multi-document bundle: merge the selected PDFs into one so the seal covers
  // the whole set and the forensic engine analyses them as a single corpus
  // (cross-document contradictions only surface when read together). A single
  // file is left exactly as-is, preserving password-protected handling.
  if (selectedFiles.length > 1) {
    try {
      var _bundleBytes = await voMergeBundle(selectedFiles);
      selectedFile = new File([_bundleBytes], 'evidence-bundle-' + selectedFiles.length + '-docs.pdf', { type: 'application/pdf' });
    } catch (mergeErr) {
      alert(mergeErr && mergeErr.message ? mergeErr.message : 'Could not merge the selected documents.');
      return;
    }
  } else if (selectedFiles.length === 1) {
    selectedFile = selectedFiles[0];
  }
  if (!selectedFile) return;

  // Pre-flight (annexure EB, 11 Sep 2026): a forensic report needs the
  // forensic service. The 528-page run was made on an address that answered
  // every API call with a web page, and the sealed output said "NOT RUN" in
  // four places while still carrying the title. Now the page checks BEFORE
  // the pipeline starts (no file read, no GPS prompt) and refuses to produce
  // an unreviewed forensic report; Seal document never pre-flights.
  try { var _pb = document.getElementById('preflightBanner'); if (_pb) _pb.hidden = true; } catch (ePb) {}
  if (sealMode === 'forensic') {
    var _pre = await voPreflightForensicService();
    if (!_pre.ok) {
      var _host = (typeof location !== 'undefined' && location.host) ? location.host : 'this address';
      voShowPreflightBlock(voPreflightMessage(_pre, _host));
      document.getElementById('sealBtn').disabled = false;
      return;
    }
  }

  maybeRunGatekeep(); // advisory only — NEVER blocks sealing
  document.getElementById('sealBtn').disabled = true;
  document.getElementById('pipeline').classList.add('visible');
  document.getElementById('results').classList.remove('visible');
  for (let i = 1; i <= 8; i++) updateStep(i, 'pending', '');
  updateStep('Fraud', 'pending', '');
  otsProof = null; gpsCoords = null; deviceInfo = null;

  // ALL variable declarations in outer scope — NO TDZ error on mobile
  var sha256 = '', sha512 = '', sealId = '', otsDigestHex = '';
  var chain = [];
  var fileBytes = null;
  var detection = null;

  try {
    // Step 1: Read file + GPS
    updateStep(1, 'processing');
    // Robust read: large files can throw NotReadableError on .arrayBuffer();
    // fall back to FileReader before failing with an actionable message.
    fileBytes = (await voReadFileBytes(selectedFile)).buffer;
    var gpsPromise = captureGPS();
    deviceInfo = captureDevice();
    gpsCoords = await gpsPromise;
    updateStep(1, 'complete', gpsCoords ? gpsCoords.lat + ',' + gpsCoords.lng : 'GPS declined');

    // Step 1.5: Forensic Contradiction Engine — FORENSIC ANALYSIS MODE ONLY.
    // Seal Only mode performs no content analysis of any kind: the seal proves
    // integrity and time only, and nothing about the document's contents is
    // scanned, scored, or sent anywhere.
    var forensicResult = null;
    _pipelineClassification = null;
    _pipelineTextSample = '';
    _pipelineTextBlocks = null;
    if (sealMode === 'forensic') {
      // AI triage (optional; only when AI review is enabled): classify the document
      // FIRST, concurrently with the deterministic engine run. Defensive: ANY
      // failure — including the classify endpoint not being deployed yet (404/500)
      // — is silent; the full engine run proceeds with no classification label.
      var classifyPromise = null;
      if (isAiReviewEnabled()) {
        classifyPromise = (async function() {
          try {
            var tokens = await extractPdfText(fileBytes);
            var fullSample = (Array.isArray(tokens) ? tokens.join(' ') : String(tokens || '')).replace(/\s+/g, ' ').trim();
            // Keep a larger excerpt for the narrator (real names/dates/amounts);
            // classify still only needs the first 4000 chars for triage.
            _pipelineTextSample = fullSample.slice(0, 12000);
            var sample = fullSample.slice(0, 4000);
            if (!sample) return null;
            var ai = null;
            try { ai = await aiClassifyDocument(sample, _pipelinePageCount || 0); } catch (eAi) { ai = null; }
            // "Other (confidence: low)" on an obvious legal case file is a
            // failed classification — reconcile against on-device rules.
            return voReconcileClassification(ai, _pipelineTextSample || sample);
          } catch (e) { return null; }
        })();
      }
      updateStep('Fraud', 'processing', 'Loading PDF and extracting text...');
      try {
        // The forensic scripts are same-origin <script> tags with no fallback.
        // On a phone a single dropped request left runForensicEngine undefined
        // and the whole scan failed with "runForensicEngine is not defined".
        // Re-fetch any that did not arrive before the scan runs.
        await voEnsureForensicScripts(function(msg){ updateStep('Fraud','processing',msg); });
        var pdfDocForForensics = await PDFDocument.load(fileBytes, { ignoreEncryption: true });
        _pipelinePageCount = pdfDocForForensics.getPageCount();
        updateStep('Fraud', 'processing', 'Scanning ' + _pipelinePageCount + ' page(s) - 40 contradiction detectors running...');
        // The signed rule package (engine-update loop) is decided BEFORE the scan so
        // the report names exactly what applied; bounded wait, never blocks the seal.
        try {
          await Promise.race([voLoadRulePackage(), new Promise(function (r) { setTimeout(r, VO_RULES_FETCH_TIMEOUT_MS + 500); })]);
        } catch (eRP) {}
        forensicResult = await runForensicEngine(fileBytes, pdfDocForForensics, function (done, total) {
          updateStep('Fraud', 'processing', 'Scanning page ' + done + ' of ' + total + ' - 40 contradiction detectors running...');
        }, { referenceTime: new Date().toISOString() }); // the analysis instant is an input, never read by the engine (determinism): it dates the "dated after its analysis" note
        // Keep the per-page text for the finding-anchored narrator excerpt.
        try { _pipelineTextBlocks = (forensicResult && Array.isArray(forensicResult.pageTexts)) ? forensicResult.pageTexts : null; } catch (ePT) { _pipelineTextBlocks = null; }
      } catch(e) {
        console.warn('Forensic engine error:', e);
        forensicResult = { clean: true, overallScore: 0, confidence: 'CLEAN', totalFindings: 0, findings: [], scanFailed: true, scanError: (e && e.message ? e.message : 'unknown'), extractionNotes: 'Forensic engine error: ' + (e && e.message ? e.message : 'unknown') + '. The scan could not complete; absence of findings here is NOT a clean result.', summary: 'Forensic scan could not complete' };
      }
      if (classifyPromise) { try { _pipelineClassification = await classifyPromise; } catch (e) { _pipelineClassification = null; } }
      // Bundle mode: on a legal case file (case details supplied), demote the
      // single-document structural indicators and recompute the score BEFORE
      // anything downstream reads it (status line, AI review, report, JSON).
      try { forensicResult = applyBundleMode(forensicResult); } catch (bmErr) { console.warn('Bundle mode skipped:', bmErr); }
      // A scan that crashed is NOT a clean scan. The catch above sets clean:true
      // purely so the seal can still complete, so rendering that as a green tick
      // told the user "no indicators found" when the engine had in fact never
      // run. Surface the failure instead — for a forensic tool, a silent false
      // clean is worse than no scan at all.
      if (forensicResult.scanFailed) {
        updateStep('Fraud', 'error', 'Scan could NOT complete (' + (forensicResult.scanError || 'unknown error') + ') - this is not a clean result');
      } else if (forensicResult.unreadable) {
        updateStep('Fraud', 'error', 'No machine-readable text - document NOT analysed (scanned/image PDF). This is NOT a clean result.');
      } else {
        updateStep('Fraud', 'complete',
          forensicResult.clean
            // contradictionTypesUsed counts the finding types that fired, not the
            // number of detectors run — "checked" read as "the engine did nothing".
            ? 'No findings - ' + (forensicResult.contradictionTypesUsed || 0) + ' of 46 contradiction types triggered'
            : forensicResult.totalFindings + ' findings recorded, stated as fact and anchored to the record');
      }
    } else {
      // Seal Only: grab the page count for the Seal Certificate — nothing else.
      try { _pipelinePageCount = (await PDFDocument.load(fileBytes, { ignoreEncryption: true })).getPageCount(); } catch(e) { _pipelinePageCount = 0; }
    }

    // Step 2: Hashes
    updateStep(2, 'processing');
    sha256 = await computeSHA256(fileBytes);
    sha512 = await computeSHA512(fileBytes);
    sealId = 'VO-' + sha512.substring(0, 12).toUpperCase();
    otsDigestHex = await computeSHA256(new TextEncoder().encode(sha512));
    updateStep(2, 'complete', sha256.substring(0, 16) + '...');

    // Detect existing seals
    updateStep(4, 'processing', 'Checking for previous seals...');
    chain = await detectExistingSeal(fileBytes);
    updateStep(4, 'processing', chain.length > 0 ? 'Found: ' + chain.map(c => c.sealId).join(', ') : 'No previous seals');

    // === COMMERCIAL DETECTION ===
    updateStep(3, 'processing', 'Scanning document for commercial content...');
    detection = await detectCommercialDocument(fileBytes);
    updateStep(3, 'complete', detection.isCommercial ? 'Commercial: ' + detection.count + ' matches' : 'Private document');

    // Store pipeline state
    _pipelineFileBytes = fileBytes;
    _pipelineSha256 = sha256;
    _pipelineSha512 = sha512;
    _pipelineSealId = sealId;
    _pipelineOtsDigestHex = otsDigestHex;
    _pipelineChain = chain;
    _pipelineDetection = detection;
    _pipelineFraudResult = forensicResult;

    // If commercial detected but user selected private, show payment gate
    if (detection.isCommercial && sealType === 'private') {
      sealType = 'commercial';
      setSealType('commercial');
      var price = getPricing();
      showPaymentGate(price, detection);
      return; // STOP — user must interact with payment gate
    }

    // If user selected commercial, show pricing
    if (sealType === 'commercial') {
      var price = getPricing();
      if (price.amount > 0) {
        showPaymentGate(price, detection);
        return; // STOP — wait for payment
      }
    }

    // Continue with sealing pipeline
    await runSealingPipeline();

  } catch (err) {
    console.error('SEALING ERROR:', err);
    for (var i = 1; i <= 8; i++) {
      var b = document.getElementById('step' + i).querySelector('.status');
      if (b.classList.contains('pending') || b.classList.contains('processing')) updateStep(i, 'error', '');
    }
    var bFraud = document.getElementById('stepFraud')?.querySelector('.status');
    if (bFraud && (bFraud.classList.contains('pending') || bFraud.classList.contains('processing'))) updateStep('Fraud', 'error', '');
    // Samsung Browser fix: use var not let in catch block
    var errorMsg = 'Unknown error';
    if (err && err.message) errorMsg = err.message;
    else if (err && typeof err === 'string') errorMsg = err;
    else if (err) errorMsg = JSON.stringify(err);

    var resultsEl = document.getElementById('results');
    resultsEl.classList.add('visible');
    resultsEl.innerHTML =
      '<h3 style="color:#ef4444;">Sealing Failed</h3>' +
      '<div style="background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.25);border-radius:12px;padding:20px;margin:16px 0;font-size:14px;color:#D5D8DD;">' +
      '<strong style="color:#ef4444;">Error:</strong> ' + errorMsg + '<br><br>' +
      '<strong>What went wrong:</strong><br>The PDF could not be fully processed.<br><br>' +
      '<strong>Try:</strong><br>Print the PDF to a new PDF file<br>Use a PDF optimizer<br>Try on a desktop computer' +
      '</div>' +
      '<button class="seal-btn" onclick="resetSealing()" style="margin-top:20px;">Try Again</button>';
    resultsEl.scrollIntoView({behavior:'smooth'});
  } finally {
    document.getElementById('sealBtn').disabled = false;
  }
}

// ==================== OPTIONAL AI REVIEW (CLOUDFLARE WORKERS AI) ====================
// Advisory layer only — it never blocks sealing. PRIVACY HARD LIMIT: only finding
// metadata (type, severity, short evidence quote, location, id) is ever sent; the
// document itself never leaves this device. Every call has a 10s AbortController
// timeout; any failure is silent and the pipeline proceeds with the deterministic
// engine's unpruned findings.
// Two modes, no switches (founder direction 2026-09-07): "Seal document with
// forensic report" IS the choice to run the AI review, the Brain 9 sweep,
// transcription and the court-ready narrative. Seal-only never calls an AI.
function isAiReviewEnabled() {
  return sealMode === 'forensic';
}

// Last AI transport failure, surfaced in the report methodology so a fallback
// is self-diagnosing instead of a silent "service unavailable".
window._voLastAiError = null;

async function aiApiPost(path, payload, timeoutMs) {
  var ctrl = new AbortController();
  var timer = setTimeout(function() { ctrl.abort(); }, timeoutMs || 10000);
  try {
    // SAME-ORIGIN, relative URL — never a hardcoded host. The page is served on
    // www.verumglobal.foundation but this used to POST to the apex
    // verumglobal.foundation, making every AI call cross-origin. A cross-origin
    // JSON POST triggers a CORS preflight, and the apex<->www canonical redirect
    // is not followed on preflight requests — so classify, assess, narrate and
    // gatekeep ALL failed silently and the report fell back to the on-device
    // narrative every time. A relative path hits whatever host actually served
    // the page: no cross-origin, no preflight, no redirect.
    var res = await fetch(path, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
      signal: ctrl.signal
    });
    if (!res.ok) throw new Error('AI endpoint ' + path + ' returned HTTP ' + res.status);
    return await res.json();
  } catch (e) {
    var reason = (e && e.name === 'AbortError')
      ? ('timed out after ' + (timeoutMs || 10000) + 'ms')
      : (e && e.message ? e.message : 'network/CORS error');
    window._voLastAiError = path + ': ' + reason;
    throw e;
  } finally {
    clearTimeout(timer);
  }
}

// Gatekeep advisory: shows a non-blocking banner when the declared tier looks
// likely to be unlicensed commercial use. Sealing is NEVER prevented.
function maybeRunGatekeep() {
  try {
    var banner = document.getElementById('gatekeepBanner');
    if (banner) banner.style.display = 'none';
    var sel = document.getElementById('tierSelector');
    var tier = sel ? sel.value : '';
    if (!tier) return;
    aiApiPost('/api/v1/ai/gatekeep', { declaredTier: tier }, 10000).then(function(r) {
      if (r && r.likelihood === 'high' && banner) banner.style.display = 'block';
    }).catch(function() { /* advisory only — silent */ });
  } catch (e) { /* advisory only — silent */ }
}

// Assess: returns { ran, findings (kept), added (AI-identified, cap 20), assessed }
// or null on any failure. Only the first 200 findings are sent for assessment;
// findings beyond the cap are always kept. Tolerant of older workers that do not
// return additionalFindings.
// Split the findings across as many /assess calls as it takes to stay under the
// worker's caps, then merge. Sending all findings in ONE body is what produced
// the "AI consensus NOT RUN (HTTP 413)" on the 148-page Ritz bundle: the worker
// rejects any request body over 16 KB (MAX_AI_BODY) and accepts at most 40
// findings per call (MAX_ASSESS_FINDINGS). A large scan's evidence quotes blow
// past 16 KB in one shot. Here each finding's evidence is trimmed to the
// server's own 300-char cap (the model never sees more), findings are packed
// into batches under both limits, and a batch that fails is skipped — its
// findings are KEPT, never silently dropped — so one bad batch cannot lose the
// whole review. Verdicts merge by id (every finding is given one).
var AI_ASSESS_BODY_LIMIT = 14 * 1024;   // headroom under the worker's 16 KB cap
var AI_ASSESS_MAX_PER_BATCH = 40;       // worker MAX_ASSESS_FINDINGS
var AI_ASSESS_EVIDENCE_CHARS = 300;     // worker MAX_EVIDENCE_CHARS

// Locate an AI candidate's verbatim quote in the sealed page text (kept from
// the engine run as _pipelineTextBlocks). Whitespace-normalised, case-
// insensitive; the model's own page number is used only when the quote is
// found on that page. Returns { found, quote, location }.
function voAnchorAiQuote(quote, pageHint) {
  var q = (typeof quote === 'string') ? quote.replace(/\s+/g, ' ').trim() : '';
  if (q.length < 12) return { found: false, quote: null, location: 'unanchored (AI candidate: no verbatim quote)' };
  var blocks = Array.isArray(_pipelineTextBlocks) ? _pipelineTextBlocks : [];
  var needle = q.toLowerCase();
  var hint = parseInt(pageHint, 10);
  var order = [];
  if (isFinite(hint) && hint >= 1 && hint <= blocks.length) order.push(hint - 1);
  for (var i = 0; i < blocks.length; i++) { if (order.indexOf(i) < 0) order.push(i); }
  for (var o = 0; o < order.length; o++) {
    var hay = String(blocks[order[o]] || '').replace(/\s+/g, ' ').toLowerCase();
    if (hay.indexOf(needle) >= 0) {
      return { found: true, quote: q.slice(0, 160), location: (blocks.length <= 1) ? 'Full document' : ('Page ' + (order[o] + 1)) };
    }
  }
  return { found: false, quote: null, location: 'unanchored (AI candidate: quote not found in the sealed text)' };
}

// ==================== BRAIN 9 (R&D) SWEEP OF THE SEALED TEXT ====================
// Constitution v8 §2.10: Brain 9 trains and calibrates the other eight brains,
// red-teams them, and cannot issue findings, verdicts or conclusions — when it
// detects that another brain missed evidence it logs an ANCHORED RECOMMENDATION,
// internal, not part of sealed reports. This is that pass, on the website:
// after the eight deterministic brains have run, the sealed page text (the text
// layer the engine analysed, OCR rescues included — never a raw evidence file)
// goes to /api/v1/ai/sweep in windows; every item the model returns must quote
// the text verbatim, is verified server-side and AGAIN here against this
// device's copy of the text, and is discarded otherwise. Survivors are listed on
// this page and in a separate, unsealed recommendations file, counted (with the
// pages read) in the sealed report's Methodology, and — with the opt-in — sent
// to the engine-improvement loop, so a recurring miss becomes a signed rule the
// deterministic engine applies next time. They never enter a sealed report.
var AI_SWEEP_WINDOW_CHARS = 11000;   // under the worker's 12,500-character window cap (JSON overhead)
var AI_SWEEP_MAX_PAGES_PER_WINDOW = 8;
var AI_SWEEP_MAX_WINDOWS = 16;
var AI_SWEEP_BUDGET_MS = 180000;     // three minutes; the pages not read are disclosed
var AI_SWEEP_CALL_TIMEOUT_MS = 35000;
var AI_SWEEP_MIN_PAGE_CHARS = 40;    // VO_NEAR_EMPTY_CHARS: an unread page has nothing to sweep

function voSweepPagesOf(location) {
  return (typeof voRulePagesOf === 'function') ? voRulePagesOf(location) : [];
}

// "1-9, 14, 17-20" from a list of page numbers.
function voB9PageRanges(pages) {
  var s = (pages || []).slice().sort(function (a, b) { return a - b; });
  var out = [];
  for (var i = 0; i < s.length; i++) {
    var start = s[i];
    while (i + 1 < s.length && s[i + 1] === s[i] + 1) i++;
    out.push(start === s[i] ? String(start) : (start + '-' + s[i]));
  }
  return out.join(', ');
}

// Windows: pages the engine flagged nothing on come first (a miss can only be
// there), then flagged pages; consecutive pages are grouped; every window
// stays under the size caps. A page too long for one window is read in part.
function voBuildSweepWindows(textBlocks, engineFindings) {
  var flagged = {};
  var list = Array.isArray(engineFindings) ? engineFindings : [];
  for (var i = 0; i < list.length; i++) {
    var pgs = voSweepPagesOf(list[i] && list[i].location);
    for (var k = 0; k < pgs.length; k++) flagged[pgs[k]] = true;
  }
  var eligible = [];
  for (var p = 0; p < textBlocks.length; p++) {
    var t = String(textBlocks[p] || '');
    var mass = (typeof voContentMass === 'function') ? voContentMass(t) : t.replace(/\s+/g, '').length;
    if (mass < AI_SWEEP_MIN_PAGE_CHARS) continue;
    eligible.push({ page: p + 1, text: t, flagged: !!flagged[p + 1] });
  }
  var order = eligible.filter(function (e) { return !e.flagged; }).concat(eligible.filter(function (e) { return e.flagged; }));
  var windows = [], cur = [], curChars = 0;
  for (var o = 0; o < order.length; o++) {
    var e = order[o];
    var text = e.text.length > AI_SWEEP_WINDOW_CHARS ? e.text.slice(0, AI_SWEEP_WINDOW_CHARS) : e.text;
    var breaks = cur.length && (cur.length >= AI_SWEEP_MAX_PAGES_PER_WINDOW || curChars + text.length > AI_SWEEP_WINDOW_CHARS || cur[cur.length - 1].page + 1 !== e.page);
    if (breaks) { windows.push(cur); cur = []; curChars = 0; }
    cur.push({ page: e.page, text: text, flagged: e.flagged, truncated: text.length < e.text.length });
    curChars += text.length;
  }
  if (cur.length) windows.push(cur);
  return { windows: windows, eligiblePages: eligible.length };
}

async function aiBrain9Sweep(textBlocks, engineFindings, onProgress) {
  var info = { ran: false, reason: null, windows: 0, windowsPlanned: 0, pagesRead: [], pagesReadText: '', pagesTotal: Array.isArray(textBlocks) ? textBlocks.length : 0, eligiblePages: 0, recommendations: 0, unverified: 0, duplicates: 0, budgetHit: false, failedWindows: 0 };
  var recs = [];
  if (!Array.isArray(textBlocks) || textBlocks.length === 0) { info.reason = 'no page text'; return { info: info, recommendations: recs }; }
  var built = voBuildSweepWindows(textBlocks, engineFindings);
  info.eligiblePages = built.eligiblePages;
  info.windowsPlanned = built.windows.length;
  var windows = built.windows.slice(0, AI_SWEEP_MAX_WINDOWS);
  if (!windows.length) { info.reason = 'no page carried enough text to read'; return { info: info, recommendations: recs }; }
  // The types the eight brains already reported, per page: the model reports
  // only what they did not, and a duplicate of an engine finding is dropped.
  var knownByPage = {};
  var ef = Array.isArray(engineFindings) ? engineFindings : [];
  for (var i = 0; i < ef.length; i++) {
    var pgs = voSweepPagesOf(ef[i] && ef[i].location);
    for (var k = 0; k < pgs.length; k++) { (knownByPage[pgs[k]] = knownByPage[pgs[k]] || []).push(String((ef[i] && ef[i].type) || '')); }
  }
  var seen = {};
  var t0 = Date.now();
  for (var w = 0; w < windows.length; w++) {
    if (Date.now() - t0 > AI_SWEEP_BUDGET_MS) { info.budgetHit = true; break; }
    var win = windows[w];
    var pageNos = win.map(function (x) { return x.page; });
    if (onProgress) { try { onProgress(w + 1, windows.length, voB9PageRanges(pageNos)); } catch (eP) {} }
    var known = [];
    for (var pi = 0; pi < pageNos.length; pi++) {
      var kt = knownByPage[pageNos[pi]] || [];
      for (var ki = 0; ki < kt.length; ki++) known.push({ type: kt[ki], page: pageNos[pi] });
    }
    var res = null;
    try {
      res = await aiApiPost('/api/v1/ai/sweep', { pages: win.map(function (x) { return { page: x.page, text: x.text }; }), known: known.slice(0, 200) }, AI_SWEEP_CALL_TIMEOUT_MS);
    } catch (e) { res = null; }
    if (!res || res.reviewed !== true || !Array.isArray(res.recommendations)) { info.failedWindows++; continue; }
    info.windows++;
    info.pagesRead = info.pagesRead.concat(pageNos);
    info.unverified += (res.unverified | 0);
    for (var r = 0; r < res.recommendations.length; r++) {
      var it = res.recommendations[r] || {};
      // The second verification: against this device's copy of the sealed text.
      var anchor = voAnchorAiQuote(it.quote, it.page);
      if (!anchor.found) { info.unverified++; continue; }
      var type = (typeof it.type === 'string' && it.type.trim()) ? it.type.trim().slice(0, 64) : 'B9_RECOMMENDATION';
      var page = parseInt(String(anchor.location).replace(/\D+/g, ''), 10) || (parseInt(it.page, 10) || 0);
      if ((knownByPage[page] || []).indexOf(type) >= 0) { info.duplicates++; continue; }
      var key = type + '|' + page + '|' + anchor.quote.toLowerCase();
      if (seen[key]) { info.duplicates++; continue; }
      seen[key] = true;
      var sev = parseInt(it.severity, 10); if (!isFinite(sev) || sev < 1 || sev > 5) sev = 3;
      recs.push({ type: type, severity: sev, rationale: String(it.rationale || '').slice(0, 300), quote: anchor.quote, page: page, location: anchor.location, brain: 'B9', source: 'ai', anchored: true });
    }
  }
  info.ran = info.windows > 0;
  if (!info.ran && !info.reason) info.reason = window._voLastAiError || 'service unavailable';
  info.recommendations = recs.length;
  info.pagesReadText = voB9PageRanges(info.pagesRead);
  return { info: info, recommendations: recs };
}

// The results panel states what Brain 9 read and recommends, and offers the
// recommendations as a separate, unsealed file. Never fails the panel.
function voRenderBrain9Recommendations() {
  try {
    var el = document.getElementById('results');
    if (!el || document.getElementById('brain9Recs')) return;
    var info = _pipelineB9Info;
    var recs = Array.isArray(_pipelineB9Recs) ? _pipelineB9Recs : [];
    if (!info) return;
    var box = document.createElement('div');
    box.id = 'brain9Recs';
    box.style.cssText = 'margin-top:18px;padding:14px 16px;border:1px solid rgba(74,126,199,0.45);border-radius:10px;background:rgba(15,52,96,0.10);font-size:13px;color:#D5D8DD;line-height:1.6;';
    var head = document.createElement('div');
    head.style.cssText = 'font-weight:700;color:#F8F9FA;margin-bottom:6px;';
    head.textContent = 'Brain 9 (R&D) sweep of the sealed text';
    box.appendChild(head);
    var para = document.createElement('div');
    para.textContent = info.ran
      ? ('Read pages ' + (info.pagesReadText || '—') + ' of ' + info.pagesTotal + ' (' + info.windows + ' window' + (info.windows === 1 ? '' : 's') + (info.budgetHit ? ', time budget reached' : '') + '). ' +
         recs.length + ' anchored recommendation' + (recs.length === 1 ? '' : 's') + '; ' + (info.unverified | 0) + ' suggestion' + ((info.unverified | 0) === 1 ? '' : 's') +
         ' discarded as not found in the sealed text. Recommendations are not findings and are held outside the sealed report (Constitution v8 §2.10); they train the engine.')
      : ('Not run — ' + (info.reason || 'service unavailable') + '.');
    box.appendChild(para);
    if (recs.length) {
      var ul = document.createElement('ul');
      ul.style.cssText = 'margin:8px 0 0 18px;padding:0;';
      for (var i = 0; i < recs.length; i++) {
        var li = document.createElement('li');
        li.style.marginBottom = '6px';
        li.textContent = recs[i].type + ' · severity ' + recs[i].severity + ' · ' + recs[i].location + ' — “' + recs[i].quote + '” — ' + recs[i].rationale;
        ul.appendChild(li);
      }
      box.appendChild(ul);
      var name = (typeof selectedFile !== 'undefined' && selectedFile && selectedFile.name) ? selectedFile.name : 'document';
      var payload = {
        brain: 'B9',
        note: 'Recommendations, not findings (Constitution v8 §2.10). Each quote was verified verbatim against the sealed text on this device. Not part of any sealed report.',
        document: name,
        generated_utc: new Date().toISOString(),
        pagesRead: info.pagesReadText,
        pagesTotal: info.pagesTotal,
        recommendations: recs
      };
      var a = document.createElement('a');
      a.className = 'download-btn';
      a.style.cssText = 'display:inline-block;margin-top:10px;';
      a.href = URL.createObjectURL(new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' }));
      a.download = name.replace(/\.pdf$/i, '') + '-brain9-recommendations.json';
      a.textContent = '⬇ Download Brain 9 recommendations (JSON, unsealed)';
      box.appendChild(a);
    }
    el.appendChild(box);
  } catch (e) { /* the results panel never fails on this */ }
}

function aiAssessBatches(assessed) {
  var batches = [], cur = [], curLen = 14 /* {"findings":[]} */;
  for (var b = 0; b < assessed.length; b++) {
    var itemLen = JSON.stringify(assessed[b]).length + 1;  // +1 for the comma
