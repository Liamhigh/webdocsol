    // OF FRAUD"). Headings are held to the same language rule and dropped
    // (and counted) when they fail it; they are never printed unread.
    if (trimmed.length < 60 && (/^[A-Z0-9 ,'&()\-]+$/.test(trimmed) || /^[A-Z][^.]{0,58}:$/.test(trimmed))) {
