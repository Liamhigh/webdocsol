  for (var i = 0; i < found.length; i++) {
    var dup = false;
    for (var d = 0; d < out.length; d++) {
      if (samePartyName(out[d], found[i])) { dup = true; break; }
    }
    if (!dup) out.push(found[i]);
  }
  return out;
}

// Same, with roles: declared roles are kept; parties discovered in the record
