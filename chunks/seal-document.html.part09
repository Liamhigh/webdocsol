// Structured record of every page the engine could NOT read this run, and why:
// { capped: [pageNo...], noText: [...], renderFailed: [...] } (1-based). Fed to
// the report builder so unread pages are disclosed prominently with a
// human-review instruction (founder ruling: missing evidence must be named —
// the AllFuels bundle had 119 unread pages holding a lease agreement).
var _voUnreadPages = null;
var _voOcrRescuedPages = null;
var _voOcrConfidence = null;    // {page: 0-100} recogniser confidence per OCR page (annexure EB)
var VO_OCR_SECONDS_PER_PAGE = 3; // rough on-device estimate used only to phrase the continue prompt
// The cap is a default, not a wall. When a bundle has more scanned pages than
// the cap, the person sealing decides once whether to read them all (with a
// time estimate) — the annexure EB run left 119 pages unread and the report
// could only say so. window.voOcrContinueAll (true/false) overrides the prompt
// for headless runs and tests.
function voOcrAskToContinue(extra, base) {
  try {
    if (typeof window !== 'undefined' && typeof window.voOcrContinueAll === 'boolean') return window.voOcrContinueAll;
    if (typeof confirm !== 'function') return false;
    var mins = Math.max(1, Math.ceil(extra * VO_OCR_SECONDS_PER_PAGE / 60));
    return confirm('This bundle has ' + extra + ' more scanned page' + (extra === 1 ? '' : 's') + ' beyond the standard on-device OCR limit of ' + VO_OCR_MAX_PAGES + ' (' + base + ' will be read either way).\n\nReading them all will take roughly ' + mins + ' more minute' + (mins === 1 ? '' : 's') + ' on this device, and the report will then cover every page.\n\nOK = read them all now.  Cancel = keep the limit (the unread pages are named in the report).');
  } catch (e) { return false; }
}

// Compress sorted 1-based page numbers to "3, 5-8, 12" for disclosure lines.
function voPageRanges(pages) {
  if (!pages || !pages.length) return '';
