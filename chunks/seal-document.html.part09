      // Render this chunk's canvases one by one (main-thread work), then
      // recognize them in parallel — one in-flight canvas per worker bounds
      // bitmap memory the same way the old one-at-a-time loop did.
      var jobs = [];
      for (var k = 0; k < chunk.length; k++) {
        var pageIdx = chunk[k];
        try {
          var page = await pdf.getPage(pageIdx + 1);
          // Cap the raster: scale 2.0 on an A0 plan or a 600-dpi scan produces
          // a bitmap large enough to kill the tab before OCR ever runs.
          var _vp1 = page.getViewport({ scale: 1 });
          var _scale = Math.min(2.0, 2200 / Math.max(_vp1.width || 1, _vp1.height || 1));
          if (!(_scale > 0.5)) _scale = 0.5;
          var viewport = page.getViewport({ scale: _scale });
          var canvas = document.createElement('canvas');
          canvas.width = Math.ceil(viewport.width);
          canvas.height = Math.ceil(viewport.height);
          await voOcrDeadline(
            page.render({ canvasContext: canvas.getContext('2d'), viewport: viewport }).promise,
            VO_OCR_RENDER_MS, 'render-p' + (pageIdx + 1));
          jobs.push({ pageIdx: pageIdx, canvas: canvas, worker: workers[jobs.length % workers.length] });
        } catch (pageErr) {
          renderFailed.push(pageIdx + 1); // named in the note, scan continues
          _ocrTick(pageIdx);
        }
      }
      var deadWorkers = [];
      await Promise.all(jobs.map(function (job) {
        return voOcrDeadline(job.worker.recognize(job.canvas), VO_OCR_RECOGNIZE_MS, 'ocr-p' + (job.pageIdx + 1)).then(function (res) {
          var text = (res && res.data && res.data.text ? res.data.text : '').replace(/\s+/g, ' ').trim();
          if (text.length > VO_OCR_EMPTY_CHARS) {
            out[job.pageIdx] = '[OCR] ' + text;
            rescued.push(job.pageIdx + 1);
            if (res && res.data && typeof res.data.confidence === 'number') ocrConf[job.pageIdx + 1] = Math.round(res.data.confidence);
          } else {
            // Rendered fine but OCR read (almost) nothing: a blank page, a
            // photo with no text, or print too poor to read. Named, not silent.
            noText.push(job.pageIdx + 1);
          }
        }).catch(function (pageErr) {
          if (pageErr && /VO_OCR_TIMEOUT/.test(String(pageErr.message || pageErr))) {
            // The worker never answered. It cannot be trusted with the next
            // chunk either, so retire it; the page is disclosed as unread.
            timedOut.push(job.pageIdx + 1);
            if (deadWorkers.indexOf(job.worker) === -1) deadWorkers.push(job.worker);
          } else {
            renderFailed.push(job.pageIdx + 1); // named in the note, scan continues
          }
        }).then(function () {
          job.canvas.width = job.canvas.height = 0; // release bitmap memory promptly
          _ocrTick(job.pageIdx);
        });
      }));
      for (var dw = 0; dw < deadWorkers.length; dw++) {
        var di = workers.indexOf(deadWorkers[dw]);
        if (di !== -1) workers.splice(di, 1);
        try { deadWorkers[dw].terminate(); } catch (eT) {}
      }
      if (!workers.length) {
        // Every worker has wedged. Record the rest as unread rather than
        // looping on a pool that cannot answer.
        for (var rem = c0 + chunk.length; rem < candidates.length; rem++) timedOut.push(candidates[rem] + 1);
        break;
      }
    }
  } finally {
    for (var _tw = 0; _tw < workers.length; _tw++) { try { await workers[_tw].terminate(); } catch (e) {} }
    try { await pdf.destroy(); } catch (e) {}
  }
  // Parallel completion can finish pages out of order; the note lists pages
  // in document order regardless.
  rescued.sort(function (a, b) { return a - b; });
  noText.sort(function (a, b) { return a - b; });
  renderFailed.sort(function (a, b) { return a - b; });
  timedOut.sort(function (a, b) { return a - b; });
  // Record every unread page + reason for the report's disclosure section.
  var cappedPages = cappedIdx.map(function (p) { return p + 1; });
  _voUnreadPages = { capped: cappedPages, noText: noText.slice(), renderFailed: renderFailed.slice(), timedOut: timedOut.slice() };
  // OCR PROVENANCE (PD6): which pages were machine-recovered rather than read
  // from a native text layer. The report marks findings anchored on these
  // pages so a reader knows the quoted characters came through OCR and must
  // be verified against the page image before exact wording is relied on.
  _voOcrRescuedPages = rescued.slice();
  _voOcrConfidence = ocrConf;
  // Full per-page accounting: every candidate page ends up in exactly one of
  // rescued / noText / renderFailed, so the extraction note states precisely
  // which pages were read and why the rest were not.
  var tail =
    (noText.length ? ' ' + noText.length + ' page(s) rendered but held no legible text (blank, photographic, or print too poor to read): ' + noText.join(', ') + '.' : '') +
    (renderFailed.length ? ' ' + renderFailed.length + ' page(s) could not be rendered for OCR: ' + renderFailed.join(', ') + '.' : '') +
    (timedOut.length ? ' ' + timedOut.length + ' page(s) exceeded the per-page OCR time limit and remain unread: ' + voPageRanges(timedOut) + '.' : '') +
    (skipped > 0 ? ' A further ' + skipped + ' image-only page(s) exceeded the OCR cap (' + VO_OCR_MAX_PAGES + ') and remain unread: page(s) ' + voPageRanges(cappedPages) + '.' : '');
  if (!rescued.length) {
    return { textBlocks: textBlocks, note: 'OCR rescue ran on ' + candidates.length + ' image-only page(s) but recovered no legible text; those pages remain unread.' + tail, ocrPages: [], ocrConfidence: {}, noTextPages: noText.slice() };
  }
  var note = 'OCR rescue: recovered text on-device (tesseract.js, eng) for ' + rescued.length +
    ' image-only page(s): ' + rescued.join(', ') + '.' + tail;
  return { textBlocks: out, note: note, ocrPages: rescued.slice(), ocrConfidence: ocrConf, noTextPages: noText.slice() };
}

// ==================== SIGNED RULE PACKAGE — the engine-update loop (client side) ====================
// worker/rule-format.md: GET /api/v1/rules/manifest -> {package, signature, algorithm, publicKeyId}.
// The engine (forensic-engine-page.js, SIGNED RULE PACKAGES) verifies the RSA-SHA512
// signature against the pinned master key and compiles the package; this page fetches
// the manifest, keeps the last VERIFIED manifest in localStorage so a phone that is
// offline -- or on a host that has no API -- still applies the newest package it has
// seen, and hands the compiled package to the engine as window.voRulePackage before a
// scan. The same loop the Android app (RuleUpdateClient) and the fraud-firewall
// (ruleUpdate.ts) run. Relative URL: works on the domain and on the Worker's own
// workers.dev address alike. Nothing about the document is involved: the manifest is
// public, signed data, and it is only ever READ.
var VO_RULES_MANIFEST_PATH = '/api/v1/rules/manifest';
var VO_RULES_CACHE_KEY = 'vo.rulePackage.manifest.v1';
var VO_RULES_FETCH_TIMEOUT_MS = 8000;
window.voRulePackage = null;
window._voRulePackageStatus = { state: 'pending', reason: null, version: null };
var _voRulePackagePromise = null;

function voRulePackageReasonText(reason) {
  var r = String(reason || '');
  if (r === 'no_api_at_this_address') return 'this address answered with a web page instead of the rules service';
  if (r === 'none_published') return 'no rule package has been published yet';
  if (r === 'timeout') return 'the rules service did not answer in time';
  if (r === 'unreachable') return 'the rules service could not be reached';
  if (r === 'no_webcrypto') return 'this browser cannot verify signatures here (the page must be served over https)';
  if (r === 'engine_not_loaded') return 'the engine script had not loaded';
  if (r.indexOf('signature') === 0 || r.indexOf('verify_error') === 0) return 'the package signature did not verify (' + r + ')';
  if (r) return 'the manifest was rejected (' + r + ')';
  return 'no reason recorded';
}

// One status object for the pipeline and the report, one line for the page.
function voSetRulePackageStatus(state, reason, pkg) {
  window._voRulePackageStatus = {
    state: state,
    reason: reason || null,
    reasonText: reason ? voRulePackageReasonText(reason) : null,
    version: pkg ? pkg.version : null,
    publishedAt: pkg ? pkg.publishedAt : null,
    sha512: pkg ? pkg.sha512 : null,
    keyId: pkg ? pkg.keyId : null,
    pairRules: pkg ? pkg.pairs.length : 0,
    groupRules: (pkg && Array.isArray(pkg.groups)) ? pkg.groups.length : 0,
    source: pkg ? pkg.fetchedFrom : null
  };
  // The Node harnesses evaluate this script with a stub document: never
  // assume a DOM here.
  var el = (typeof document !== 'undefined' && document && typeof document.getElementById === 'function')
    ? document.getElementById('rulePackageStatus') : null;
  if (!el) return;
  if (state === 'applied' && pkg) {
    el.textContent = 'Signed rule package v' + pkg.version + ' — signature verified (' + pkg.keyId + ')' +
      (pkg.publishedAt ? ', published ' + String(pkg.publishedAt).slice(0, 10) : '') +
      (pkg.fetchedFrom === 'cache' ? ', from this device’s last verified copy' : '') + '. ' +
      pkg.pairs.length + ' phrase-pair rule(s) and ' + (Array.isArray(pkg.groups) ? pkg.groups.length : 0) + ' co-occurrence group(s) active beside the built-in engine' +
      (reason ? ' (live check: ' + voRulePackageReasonText(reason) + ')' : '') + '.';
  } else if (state === 'pending') {
    el.textContent = 'Rule package: checking the rules service…';
  } else {
    el.textContent = 'Built-in rules only — ' + voRulePackageReasonText(reason) + '. Every built-in detector still runs.';
  }
}

async function voVerifiedPackageFrom(manifest, fetchedFrom) {
  var v = await voVerifyRulePackage(manifest);
  if (!v.ok) return { ok: false, reason: v.reason };
  return { ok: true, compiled: voCompileRulePackage(v.package, { sha512: v.sha512, keyId: manifest.publicKeyId, fetchedFrom: fetchedFrom }) };
}

function voLoadRulePackage() {
  if (_voRulePackagePromise) return _voRulePackagePromise;
  _voRulePackagePromise = (async function () {
    if (typeof voVerifyRulePackage !== 'function' || typeof voCompileRulePackage !== 'function') {
      voSetRulePackageStatus('unavailable', 'engine_not_loaded', null);
      return null;
    }
    // 1. The last verified manifest on this device, re-verified every time.
    var cached = null;
    try {
      var raw = localStorage.getItem(VO_RULES_CACHE_KEY);
      if (raw) {
        var parsed = JSON.parse(raw);
        if (parsed && parsed.manifest) {
          var cv = await voVerifiedPackageFrom(parsed.manifest, 'cache');
          if (cv.ok) cached = cv.compiled; else { try { localStorage.removeItem(VO_RULES_CACHE_KEY); } catch (eR) {} }
        }
      }
    } catch (eC) { cached = null; }
    // 2. The live manifest.
    var live = null, reason = null;
    try {
      var ctrl = new AbortController();
      var timer = setTimeout(function () { ctrl.abort(); }, VO_RULES_FETCH_TIMEOUT_MS);
      var res = await fetch(VO_RULES_MANIFEST_PATH, { method: 'GET', headers: { 'Accept': 'application/json' }, cache: 'no-store', signal: ctrl.signal });
      clearTimeout(timer);
      var ctype = String(res.headers.get('content-type') || '');
      if (ctype.indexOf('application/json') < 0) {
        reason = 'no_api_at_this_address';
      } else {
        var body = await res.json();
        var code = body && (body.error || body.code);
        if (res.status === 503 && code === 'no_rule_package') reason = 'none_published';
        else if (!res.ok) reason = 'http_' + res.status + (code ? ':' + code : '');
        else {
          var lv = await voVerifiedPackageFrom(body, 'live');
          if (lv.ok) {
            live = lv.compiled;
            try { localStorage.setItem(VO_RULES_CACHE_KEY, JSON.stringify({ manifest: body, storedAt: new Date().toISOString() })); } catch (eS) {}
          } else {
            reason = lv.reason;
          }
        }
      }
    } catch (eF) {
      reason = (eF && eF.name === 'AbortError') ? 'timeout' : 'unreachable';
    }
    // 3. Choose: the live package, unless the device already holds a newer
    // verified one (the Android client's version gate); the cache when the
    // live check failed.
    var chosen = live;
    if (live && cached && voSemverNewer(cached.version, live.version)) chosen = cached;
    if (!chosen && cached) chosen = cached;
    window.voRulePackage = chosen;
    if (chosen) voSetRulePackageStatus('applied', chosen === live ? null : reason, chosen);
    else voSetRulePackageStatus('unavailable', reason || 'unreachable', null);
    return chosen;
  })();
  return _voRulePackagePromise;
}
// Start at load (in a real browser only; the Node harnesses that evaluate this
// script have no DOM and must not start a fetch); the scan awaits the same
// promise (bounded) before the engine runs.
try {
  if (typeof window !== 'undefined' && typeof document !== 'undefined' && document && typeof document.getElementById === 'function' && typeof fetch === 'function') {
    setTimeout(function () { voLoadRulePackage(); }, 0);
  }
} catch (eBoot) {}

// ==================== ANONYMOUS PATTERN SHARING (AUTOMATIC IN FORENSIC MODE) ====================
// Feeds the verum-rules feedback loop. PRIVACY HARD LIMIT: only detector IDs,
// finding types, integer severities (1-5), and page counts are ever sent.
// Never any document content, quotes, locations, filenames, hashes, or
// identity data. Fire-and-forget: silent on failure, never blocks sealing.
// Contract (worker/verum-rules.js): POST {"patterns":[...]} only — any other
// top-level field is rejected; each pattern may carry ONLY the four fields.
function shareAnonymousPatterns(fraudResult) {
  try {
    // Automatic in "Seal document with forensic report" (founder direction
    // 2026-09-07: detector ids, contradiction types, severities and page counts
    // are not personal information); never in "Seal document".
    if (sealMode !== 'forensic') return;
    // scanFailed means the engine could not complete — that is NOT a clean
    // result, so it must not be fed to the feedback loop as one.
    if (!fraudResult || fraudResult.scanFailed) return;
    var pageCount = parseInt(_pipelinePageCount, 10);
    if (!isFinite(pageCount) || pageCount < 0) pageCount = 0;
    var findings = Array.isArray(fraudResult.findings) ? fraudResult.findings.slice(0, 200) : [];
    var patterns = [];
    if (findings.length === 0) {
      // Clean scan: still valuable signal for the engine — record it with
      // the page count as a single synthetic marker (endpoint requires a
      // non-empty patterns array).
      patterns.push({ detectorId: 'CLEAN_SCAN', type: 'CLEAN_SCAN', severity: 1, pageCount: pageCount });
    } else {
      for (var i = 0; i < findings.length; i++) {
        var f = findings[i] || {};
        var detectorId = (typeof f.type === 'string' && f.type) ? f.type : 'UNKNOWN';
        // A hit from a signed rule package names its rule, never the detector
        // whose type it borrows -- otherwise the package would feed its own
        // rules back into the loop as if the engine had found them.
        if (f.packageRule) detectorId = ('SIGNED_RULE_' + String(f.packageRule)).slice(0, 64);
        var type = (f.type === 'SERIAL') ? (f.serialPattern || 'SERIAL') : ((typeof f.type === 'string' && f.type) ? f.type : 'UNKNOWN');
        var sev = parseInt(f.severity, 10);
        if (!isFinite(sev) || sev < 1) sev = 1; else if (sev > 5) sev = 5;
        patterns.push({ detectorId: detectorId, type: type, severity: sev, pageCount: pageCount });
      }
    }
    // Engine-update loop: AI-identified candidates (any type but SERIAL) are fed
    // back so recurring AI-surfaced patterns can be curated into a signed rule
    // package, which the deterministic engine then applies on every client.
    // rationale/quote/text is NEVER sent — only the four contract fields, per
    // the verum-rules worker contract.
    var aiAdded = Array.isArray(_pipelineAiAddedFindings) ? _pipelineAiAddedFindings : [];
    // Worker contract: <=200 patterns total per submission — engine findings keep
    // priority; AI-identified patterns fill the remaining budget only. pageCount is
    // REQUIRED on every pattern (non-negative int; 0 = unknown) or the worker 400s.
    var aiBudget = 200 - patterns.length;
    for (var a = 0; a < aiAdded.length && a < aiBudget; a++) {
      var af = aiAdded[a] || {};
      var aType = (typeof af.type === 'string' ? af.type.trim() : '').slice(0, 64);
      // An AI candidate typed with an engine code (CT01-CT46) is the loop's
      // most useful signal -- "the engine missed a CT01 here" -- and travels
      // as detectorId AI_IDENTIFIED, distinguishable from an engine finding.
      if (!aType || aType === 'SERIAL') continue;
      var aSev = parseInt(af.severity, 10);
      if (!isFinite(aSev) || aSev < 1) aSev = 1; else if (aSev > 5) aSev = 5;
      patterns.push({ detectorId: af.anchored ? 'AI_IDENTIFIED' : 'AI_IDENTIFIED_UNANCHORED', type: aType, severity: aSev, pageCount: pageCount });
    }
    // The AI review's "unsupported" notes on engine findings: a precision
    // signal for the improvement loop ("the AI doubted a CT20 here"). The
    // finding itself was never removed; the trainer drafts rules only from
    // AI_IDENTIFIED and B9_RECOMMENDATION, so this is recorded for calibration.
    var aiNotes = Array.isArray(_pipelineAiNotes) ? _pipelineAiNotes : [];
    for (var an = 0; an < aiNotes.length && patterns.length < 200; an++) {
      var nf = aiNotes[an] || {};
      var nType = (typeof nf.type === 'string' ? nf.type.trim() : '').slice(0, 64);
      if (!nType || nType === 'SERIAL') continue;
      var nSev = parseInt(nf.severity, 10);
      if (!isFinite(nSev) || nSev < 1) nSev = 1; else if (nSev > 5) nSev = 5;
      patterns.push({ detectorId: 'AI_REVIEW_UNSUPPORTED', type: nType, severity: nSev, pageCount: pageCount });
    }
    // Brain 9 recommendations (anchored, verified verbatim): the loop's training
    // signal — "the eight brains missed this type here". Same four fields only.
    var b9 = Array.isArray(_pipelineB9Recs) ? _pipelineB9Recs : [];
    for (var b = 0; b < b9.length && patterns.length < 200; b++) {
      var br = b9[b] || {};
      var bType = (typeof br.type === 'string' ? br.type.trim() : '').slice(0, 64);
      if (!bType || bType === 'SERIAL') continue;
      var bSev = parseInt(br.severity, 10);
      if (!isFinite(bSev) || bSev < 1) bSev = 1; else if (bSev > 5) bSev = 5;
      patterns.push({ detectorId: 'B9_RECOMMENDATION', type: bType, severity: bSev, pageCount: pageCount });
    }
    var ctrl = new AbortController();
    var timer = setTimeout(function() { ctrl.abort(); }, 8000);
    fetch('/api/v1/feedback/patterns', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ patterns: patterns }),
      signal: ctrl.signal
    }).then(function(res) {
      clearTimeout(timer);
      if (res && res.ok) {
        var resultsEl = document.getElementById('results');
        if (resultsEl && !document.getElementById('patternShareNote')) {
          var note = document.createElement('div');
          note.id = 'patternShareNote';
          note.style.cssText = 'font-size:12px;color:#4A7EC7;margin-top:14px;font-family:\'Courier New\',monospace;letter-spacing:0.04em;';
          note.textContent = 'Anonymous pattern data shared — thank you.';
          resultsEl.appendChild(note);
        }
      }
    }).catch(function() { /* silent — feedback must never disturb sealing */ });
  } catch (e) { /* silent — feedback must never disturb sealing */ }
}

// Static #results skeleton captured at load. The "Sealing Failed" panels replace
// #results content to show the error; without a restore, every subsequent seal in
// the same page session found the qrPreview canvas / hash displays / download grid
// gone and crashed at the QR step with "Cannot read properties of null (reading
// 'getContext')". Restored defensively at the single pipeline entry point.
var RESULTS_SKELETON_HTML = document.getElementById('results').innerHTML;

async function runSealingPipeline() {
  if (!document.getElementById('qrPreview') && RESULTS_SKELETON_HTML) {
    document.getElementById('results').innerHTML = RESULTS_SKELETON_HTML;
  }
  var fileBytes = _pipelineFileBytes;
  var sha256 = _pipelineSha256;
  var sha512 = _pipelineSha512;
  var sealId = _pipelineSealId;
  var otsDigestHex = _pipelineOtsDigestHex;
  var chain = _pipelineChain;
  var fraudResult = _pipelineFraudResult;

  var otsResult = null, qrDataURL = null;
  var password = null, senderEmail = '';
  var sealedBytes = null, encryptedBytes = null, meta = null;

  // Password protection is validated UP FRONT — before any analysis — so a
  // mismatch, a too-short password, or an empty box fails fast with a clear
  // reason. Previously this was checked at the compositing step and, if it
  // failed the ">=8 && matches" test, the password was silently dropped and the
  // file came out UNPROTECTED even though the user switched protection on. A
  // sensitive report must never leave unprotected when a password was requested.
  if (document.getElementById('passwordToggle') && document.getElementById('passwordToggle').checked) {
    var _pw1 = (document.getElementById('docPassword') && document.getElementById('docPassword').value) || '';
    var _pw2 = (document.getElementById('docPasswordConfirm') && document.getElementById('docPasswordConfirm').value) || '';
    if (!_pw1 || !_pw2)
      throw new Error('Password protection is switched ON, but a password box is empty. Type the same password (at least 8 characters) into BOTH boxes, or switch password protection off.');
    if (_pw1.length < 8)
      throw new Error('Password protection is switched ON, but the password is too short. Use at least 8 characters, or switch password protection off.');
    if (_pw1 !== _pw2)
      throw new Error('Password protection is switched ON, but the two password boxes do not match. Re-type the SAME password in both boxes.');
    password = _pw1;
  }

  // Step 3: OpenTimestamps
  updateStep(3, 'processing', 'Contacting a.pool.opentimestamps.org...');
  otsResult = await submitToOTS(otsDigestHex);
  updateStep(3, otsResult.success ? 'complete' : 'error', otsResult.success ? 'Submitted' : otsResult.error);

  // Step 4: Watermark
  updateStep(4, 'complete', chain.length > 0 ? 'Chain: ' + chain.length + ' prev' : 'No chain');

  // Step 5: QR — encode full forensic data for verify page
  updateStep(5, 'processing');
  meta = collectSealMetadata();
  // Embed full SHA-512 + OTS digest into QR metadata
  // This allows verify page to: display full hash, query blockchain, confirm seal
  meta.sha512 = sha512;              // Full 128-char SHA-512 fingerprint
  meta.otsDigest = otsDigestHex;     // 64-char OTS SHA-256 digest for blockchain lookup
  meta.otsStatus = otsResult.success; // Whether OTS calendar accepted the digest
  meta.sealId = sealId;              // VO-XXXXXXXXXXXX seal identifier
  // PRIVACY: public QR payload excludes identity/GPS/device (buildQrPayload);
  // those stay in the private Seal Certificate only.
  var chainIdsQr = chain.map(function(c) { return c.sealId; }).filter(function(id) { return id && id !== sealId; });
  var metaStr = encodeURIComponent(utf8ToBase64(JSON.stringify(buildQrPayload(meta, chainIdsQr))));
  var qrContent = 'https://verumglobal.foundation/verify.html?h=' + sha512.substring(0,32) + '&m=' + metaStr;
  // QR ROBUSTNESS: QR generation or preview rendering must NEVER abort the seal.
  // The QR is a convenience pointer to the verify page; the SHA-512 fingerprint,
  // the per-page seal footer text and the PDF metadata Subject remain the
  // authoritative seal. On ANY failure the seal proceeds without the QR image
  // and the UI states the omission honestly.
  var qrOmitted = false;
  try {
    qrDataURL = await generateQRDataURL(qrContent, 400);
  } catch (qrErr) {
    console.warn('QR generation failed (seal continues without QR):', qrErr);
    qrDataURL = null;
  }
  if (!qrDataURL) qrOmitted = true;
  try {
    var pC = document.getElementById('qrPreview');
    if (pC && pC.getContext) {
      var pX = pC.getContext('2d');
      pC.width = 220; pC.height = 220;
      pX.fillStyle = '#ffffff'; pX.fillRect(0, 0, 220, 220);
      if (qrDataURL) { const qI = new Image(); qI.onload = () => { pX.drawImage(qI, 10, 10, 200, 200); }; qI.onerror = () => { pX.fillStyle = '#ff0000'; pX.fillText('QR Error', 80, 110); }; qI.src = qrDataURL; }
    }
  } catch (pvErr) {
    console.warn('QR preview render failed (seal continues without QR):', pvErr);
  }
  if (qrOmitted) {
    updateStep(5, 'complete', 'QR omitted (generation failed) — hash + footer remain the authoritative seal');
    var qrNoteEl = document.getElementById('qrPreviewNote');
    if (qrNoteEl) qrNoteEl.textContent = 'QR code omitted for this seal (generation failed). The SHA-512 fingerprint and the seal footer on every page remain the authoritative proof of integrity and time.';
  } else {
    updateStep(5, 'complete');
  }

  // Step 6: Seal Footer  (password already validated and set up front)
  updateStep(6, 'processing', 'Compositing ' + selectedFile.name + '...');
  senderEmail = document.getElementById('senderEmail')?.value?.trim() || '';
  await voEnsureWatermark(); // retry the watermark if the boot-time fetch dropped
  sealedBytes = await buildSealedPDF(fileBytes, qrDataURL, sealId, sha512, sha256, document.getElementById('clientName').value || '', password, senderEmail, chain, fraudResult);
  if (window._voSealedAsIs) {
    updateStep(6, 'complete', 'Protected PDF — sealed as-is; seal record lives on the Seal Certificate');
  } else if (window._voCropNormalizedPages > 0) {
    updateStep(6, 'complete', 'Restored full page on ' + window._voCropNormalizedPages +
      ' cropped page(s) so the sealed copy shows the whole document');
  }

  window._voNewPasswordSkipped = false;
  if (password && window._voSealedAsIs) {
    // The input already carries its own password protection (it was sealed
    // as-is). Encrypting an encrypted file double-encrypts its streams and
    // renders garbage pages, so the new password is NOT applied — stated
    // plainly in the step and on the results card, never silently.
    encryptedBytes = null;
    window._voNewPasswordSkipped = true;
    updateStep(6, 'complete', 'Already password-protected — existing password kept; the new password was NOT applied');
  } else if (password) {
    // Produce a STANDARD password-protected PDF: one ordinary .pdf that opens
    // in any reader (Adobe, Preview, Chrome, phones) with a password prompt.
    // The recipient cannot open it without asking the sender for the password
    // — that request is the delivery receipt. Falls back to the legacy .voice
    // container only if standard encryption is somehow unavailable, so a
    // password is never silently dropped.
    if (typeof window.VOEncryptPDF === 'function') {
      try {
        encryptedBytes = window.VOEncryptPDF(sealedBytes, password, null, sha512);
        window._voEncFormat = 'pdf';
      } catch (encErr) {
        console.warn('Standard PDF encryption failed, falling back to .voice:', encErr && encErr.message);
        encryptedBytes = await encryptSealedPDF(sealedBytes, password);
        window._voEncFormat = 'voice';
      }
    } else {
      encryptedBytes = await encryptSealedPDF(sealedBytes, password);
      window._voEncFormat = 'voice';
    }
  }
  updateStep(6, 'complete');

  // Step 7: Finalize
  updateStep(7, 'processing'); await sleep(200); updateStep(7, 'complete');

  // Step 8: SHA-512
  updateStep(8, 'processing'); await sleep(300); updateStep(8, 'complete', sha512.substring(0,16)+'...');

  // Add fraud data to metadata
  if (fraudResult) {
    meta.fraudScore = fraudResult.overallScore;
    meta.fraudFindings = fraudResult.totalFindings;
    meta.fraudConfidence = fraudResult.confidence;
    meta.fraudContradictionTypes = fraudResult.contradictionTypesUsed;
    meta.fraudSerialPatterns = fraudResult.serialPatternsDetected;
    meta.fraudClean = fraudResult.clean;
  }

  // === Optional AI review (Cloudflare Workers AI) — advisory only, NEVER breaks the seal flow ===
  // Founder ruling (5 October 2026): the AI never deletes or changes an engine
  // finding. Assess returns every engine finding unchanged (an "unsupported"
  // view rides along as an advisory note) and the contradictions the engine
  // missed, which are candidates, never findings; narrate drafts the report's
  // AI Narrative Summary. On ANY failure the pipeline continues with the
  // deterministic engine's findings.
  var reportFraudResult = fraudResult;
  var aiReviewInfo = null;
  var aiNarrativeText = null;
  var aiNarrativeSource = null; // 'ai' = Workers-AI narrator; 'local' = on-device fallback
  _pipelineAiAddedFindings = [];
  _pipelineAiNotes = [];
  _pipelineB9Recs = [];
  _pipelineB9Info = null;
  try {
    if (isAiReviewEnabled() && fraudResult && !fraudResult.scanFailed && Array.isArray(fraudResult.findings) && fraudResult.findings.length > 0) {
      updateStep(7, 'processing', 'AI review of findings (optional)...');
      var originalCount = fraudResult.findings.length;
      // Assess in its OWN try: the endpoint throws (non-2xx) when the model is
      // unavailable, and that throw previously escaped to the outer catch and
      // skipped the narrative entirely. Isolate it so assess failing only marks
      // the review unavailable — it never blocks the narrative below.
      var assessRes = null;
      try { assessRes = await aiAssessFindings(fraudResult.findings); }
      catch (assessErr) { console.warn('[VO-AI] assess failed:', assessErr && assessErr.message ? assessErr.message : assessErr); assessRes = null; }
      if (!assessRes || !assessRes.ran) {
        aiReviewInfo = { applied: false, reason: window._voLastAiError || 'service unavailable' };
        updateStep(7, 'processing', 'AI review unavailable — the engine findings stand as produced');
      }
      if (assessRes && assessRes.ran) {
        // The engine's findings, every one, in the engine's order, then the
        // AI's candidates. Timeline, person index and type counts are the
        // engine's own: nothing was removed, so nothing is recomputed.
        var mergedFindings = assessRes.findings.concat(assessRes.added);
        reportFraudResult = Object.assign({}, fraudResult, { findings: mergedFindings, totalFindings: mergedFindings.length });
        var assessedCount = (assessRes.assessed != null ? assessRes.assessed : originalCount) | 0;
        aiReviewInfo = {
          applied: true,
          assessed: assessedCount,
          attempted: originalCount,
          original: originalCount,
          noted: assessRes.noted | 0,
          added: assessRes.added.length,
          duplicates: assessRes.duplicates | 0
        };
        _pipelineAiAddedFindings = assessRes.added;
        _pipelineAiNotes = assessRes.findings.filter(function (f) { return f && f.aiReviewNote; });
        updateStep(7, 'processing', 'AI review read ' + assessedCount + ' engine finding' + (assessedCount === 1 ? '' : 's') + ' (all kept as the engine produced them)' + (assessRes.added.length ? ', +' + assessRes.added.length + ' AI-raised candidate' + (assessRes.added.length === 1 ? '' : 's') : ''));
      }
      // Brain 9 (R&D) sweep of the sealed text — recommendations, never findings
      // (Constitution v8 §2.10). Runs whether or not assess ran; its output is
      // kept OUT of reportFraudResult; the report states coverage and counts.
      try {
        if (Array.isArray(_pipelineTextBlocks) && _pipelineTextBlocks.length) {
          updateStep(7, 'processing', 'Brain 9 sweep: reading the sealed text for what the engine missed...');
          var sweep = await aiBrain9Sweep(_pipelineTextBlocks, fraudResult.findings, function (i, n, pages) {
            updateStep(7, 'processing', 'Brain 9 sweep: pages ' + pages + ' (window ' + i + ' of ' + n + ')...');
          });
          _pipelineB9Recs = sweep.recommendations;
          _pipelineB9Info = sweep.info;
          if (!aiReviewInfo) aiReviewInfo = { applied: false, reason: window._voLastAiError || 'service unavailable' };
          aiReviewInfo.sweep = sweep.info;
          updateStep(7, 'processing', sweep.info.ran
            ? ('Brain 9 sweep read pages ' + sweep.info.pagesReadText + ' of ' + sweep.info.pagesTotal + ' — ' + sweep.recommendations.length + ' anchored recommendation(s)')
            : 'Brain 9 sweep unavailable — the engine findings stand without it');
        }
      } catch (sweepErr) {
        console.warn('[VO-AI] Brain 9 sweep failed (sealing unaffected):', sweepErr && sweepErr.message ? sweepErr.message : sweepErr);
      }
      // Draft the narrative whether or not the assess step ran — it used to be
      // nested inside the assess-success block, so any assess failure (e.g. the
      // 70B model being throttled) silently produced NO narrative at all. The
      // narrative is the point of the report and has its own template fallback,
      // so it must not depend on assess. Use reportFraudResult's findings
      // (assessed when available, else the raw engine output). aboutFraud
      // documents get serial-pattern LABELS suppressed so the drafted narrative
      // cannot mischaracterise the subject matter.
      var narrateFindings = (reportFraudResult && reportFraudResult.findings) || [];
      if ((_pipelineClassification && _pipelineClassification.aboutFraud === true) || voIsLegalCaseFile()) {
        narrateFindings = narrateFindings.map(function(f) {
          if (!f || f.type !== 'SERIAL') return f;
          var c = Object.assign({}, f);
          c.serialName = 'Multi-stage pattern match';
          c.serialPattern = 'MULTI_STAGE_PATTERN';
          c.evidence = 'Multi-stage pattern match (label suppressed for this document class).';
          return c;
        });
      }
      if (narrateFindings.length > 0) {
        updateStep(7, 'processing', 'Drafting report narrative (AI)...');
        // Narrate in its OWN try too: the endpoint returns a deterministic
        // template even when the model fails, so this should always yield a
        // narrative — but if anything does throw, the report still builds.
        try { aiNarrativeText = await aiNarrateReport(narrateFindings, reportFraudResult.overallScore, reportFraudResult.confidence); if (aiNarrativeText) aiNarrativeSource = window._voNarrateTemplate ? 'local' : 'ai'; }
        catch (narrErr) { console.warn('[VO-AI] narrate failed:', narrErr && narrErr.message ? narrErr.message : narrErr); aiNarrativeText = null; }
        // Guarantee a narrative even when the AI endpoint is unreachable: fall
        // back to an on-device narrative built directly from the findings.
        if (!aiNarrativeText) {
          aiNarrativeText = buildLocalNarrative(narrateFindings, reportFraudResult.overallScore, reportFraudResult.confidence);
          if (aiNarrativeText) aiNarrativeSource = 'local';
        }
      }
    }
  } catch (aiErr) {
    console.warn('AI review skipped (sealing unaffected):', aiErr && aiErr.message ? aiErr.message : aiErr);
    reportFraudResult = fraudResult;
    aiReviewInfo = (isAiReviewEnabled() && fraudResult && !fraudResult.scanFailed && fraudResult.findings && fraudResult.findings.length > 0)
      ? { applied: false, reason: window._voLastAiError || 'service unavailable' } : null;
    aiNarrativeText = null;
    aiNarrativeSource = null;
    _pipelineAiAddedFindings = [];
    _pipelineAiNotes = [];
    _pipelineB9Recs = [];
    _pipelineB9Info = null;
  }

  // Seal Only mode: one-page Seal Certificate — NEVER breaks the seal flow.
  // TWO variants when identity/GPS/device were captured: the shareable
  // certificate carries NO sender identity (safe to file, forward, or drop in
  // an evidence folder); the PRIVATE variant carries the full identity block
  // and exists solely for the sealer's own records. The shareable build gets
  // no identity opts at all AND buildSealCertificate gates the block on
  // includePrivate — two independent latches, so one future mistake cannot
  // leak a home address into a distributed certificate.
  window._voSealCert = null;
  window._voSealCertPrivate = null;
  window._voSealCertPrivateFailed = false;
  if (sealMode !== 'forensic') {
    try {
      updateStep(7, 'processing', 'Building seal certificate...');
      var certBase = {
        fileName: selectedFile.name,
        sha512: sha512,
        sealId: sealId,
        timestampISO: new Date(meta.t || Date.now()).toISOString(),
        pageCount: _pipelinePageCount || null,
        otsSubmitted: !!(otsResult && otsResult.success),
        otsCalendar: otsResult && otsResult.calendar ? otsResult.calendar : null,
        qrDataURL: qrDataURL
      };
      var certBytes = await buildSealCertificate(Object.assign({}, certBase, {
        identity: meta.id || null, gps: meta.gps || null, dev: meta.dev || null
      }));
      window._voSealCert = { bytes: certBytes };
      if (meta.id || meta.gps || meta.dev) {
        // The PRIVATE certificate is the sealer's ONLY custody record of the
        // identity/GPS/device block — the shareable certificate deliberately
        // omits it and merely says it was "recorded privately by the sealer".
        // A swallowed failure here therefore breaks that promise silently:
        // the user would walk away with no private record and no warning.
        // One retry, then a flagged failure the download area reports.
        var privOpts = Object.assign({}, certBase, {
          includePrivate: true,
          identity: meta.id || null,
          gps: meta.gps || null,
          acc: meta.acc || null,
          dev: meta.dev || null
        });
        window._voSealCertPrivateFailed = false;
        for (var privTry = 0; privTry < 2 && !window._voSealCertPrivate; privTry++) {
          try {
            var certPrivBytes = await buildSealCertificate(privOpts);
            window._voSealCertPrivate = { bytes: certPrivBytes };
          } catch (privErr) {
            console.warn('Private certificate generation failed (attempt ' + (privTry + 1) + ' of 2; shareable certificate unaffected):', privErr);
          }
        }
        if (!window._voSealCertPrivate) window._voSealCertPrivateFailed = true;
      }
      updateStep(7, 'complete', window._voSealCertPrivateFailed
        ? 'Certificate ready — private record failed, see downloads'
        : 'Certificate ready');
    } catch (certErr) {
      console.warn('Seal certificate generation failed (document seal unaffected):', certErr);
      window._voSealCert = null;
      window._voSealCertPrivate = null;
      window._voSealCertPrivateFailed = false;
      updateStep(7, 'complete');
    }
  }

  // Anchor Certificate (BOTH modes, only when a calendar accepted the digest):
  // records the OpenTimestamps submission — seal ID, document SHA-512, OTS
  // digest, calendar list, ISO-8601 submission time. NEVER breaks the seal flow.
  window._voAnchorCert = null;
  if (otsResult && otsResult.success) {
    try {
      window._voAnchorCert = {
        bytes: await buildAnchorCertificate({
          fileName: selectedFile.name,
          sha512: sha512,
          // The SHA-512 of the bytes delivered, as sha512sum computes it — the
          // password-protected copy when one was made. The VO-SEAL2 value in
          // the seal metadata is a self-check over the bytes with a placeholder
          // and never equals sha512sum of the file (verification of this run).
          sealedSha512: (password && encryptedBytes) ? await computeSHA512(encryptedBytes) : (sealedBytes ? await computeSHA512(sealedBytes) : null),
          deliveredProtected: !!(password && encryptedBytes),
          sealId: sealId,
          otsDigest: otsDigestHex,
          calendars: [window.VoOts ? VoOts.normalizeCalendarUrl(otsResult.calendar) : otsResult.calendar],
          timestampISO: new Date(meta.t || Date.now()).toISOString(),
          qrDataURL: qrDataURL
        })
      };
    } catch (anchorErr) {
      console.warn('Anchor certificate generation failed (document seal unaffected):', anchorErr);
      window._voAnchorCert = null;
    }
  }

  // Step 9 (optional, FORENSIC ANALYSIS MODE only): sealed forensic report — NEVER breaks the seal flow
  var reportPack = null;
  window._voReportDebug = {
    sealMode: sealMode,
    verum_report_available: !!window.VerumReport,
    build_fn_available: typeof window.VerumReport?.build,
    findings_count: reportFraudResult?.findings?.length,
    findings_is_array: Array.isArray(reportFraudResult?.findings),
    ai_review_info: aiReviewInfo,
    timestamp: new Date().toISOString()
  };
  // Recover the report builder too if its script was the one that dropped.
  if (sealMode === 'forensic' && (!window.VerumReport || typeof window.VerumReport.build !== 'function')) {
    try { await voEnsureForensicScripts(function(msg){ updateStep(7,'processing',msg); }); } catch (e) {}
  }
  try {
    if (sealMode === 'forensic' && window.VerumReport && typeof window.VerumReport.build === 'function') {
      updateStep(7, 'processing', 'Building forensic report...');
      window._voReportDebug.stage = 'BUILDING';
      console.log('[VO-REPORT-DEBUG] Starting forensic report build', {
        sealMode: sealMode,
        verum_report_available: !!window.VerumReport,
        build_fn_available: typeof window.VerumReport.build,
        findings_count: reportFraudResult?.findings?.length,
        findings_is_array: Array.isArray(reportFraudResult?.findings)
      });

      // AI classification (may be null — classify endpoint is optional/rolling out).
      // aboutFraud:true suppresses serial-pattern LABELS; corroborated labels need
      // >=2 independent severity>=3 findings, else they demote to weak signals.
      var classification = _pipelineClassification;
      var serialInfo = getSerialLabelInfo(reportFraudResult && reportFraudResult.findings, !!(classification && classification.aboutFraud === true) || voIsLegalCaseFile());

      console.log('[VO-REPORT-DEBUG] Build options prepared', {
        serial_info_suppressed: serialInfo.suppressed,
        ai_narrative_present: !!aiNarrativeText,
        ai_review_applied: aiReviewInfo?.applied
      });

      var reportBytes = await window.VerumReport.build({
        findings: reportFraudResult,
        documents: [{
          name: selectedFile.name,
          pageCount: _pipelinePageCount || null,
          sha512: sha512,
          sealId: sealId,
          bytes: fileBytes ? (fileBytes.byteLength || fileBytes.length) : null
        }],
        identity: (function () {
          var ci = voCaseDetails();
          return {
            fullName: document.getElementById('clientName') ? (document.getElementById('clientName').value || '') : '',
            caseName: ci.caseName || undefined,
            caseRefs: ci.caseRefs || undefined,
            parties: ci.parties || undefined,
            jurisdiction: ci.jurisdiction || undefined
          };
        })(),
        engineVersion: VO_ENGINE_VERSION,
        rulePackage: (fraudResult && fraudResult.rulePackage) || null,
        rulePackageStatus: window._voRulePackageStatus || null,
        extractionNotes: fraudResult && fraudResult.extractionNotes ? fraudResult.extractionNotes : null,
        unreadPages: _voUnreadPages,
        ocrPages: _voOcrRescuedPages,
        ocrConfidence: _voOcrConfidence || null,
        gps: (typeof gpsCoords !== 'undefined' && gpsCoords) ? { lat: gpsCoords.lat, lng: gpsCoords.lng, acc: gpsCoords.accuracy || null } : null,
        aiReview: aiReviewInfo,
        aiNarrative: aiNarrativeText,
        aiNarrativeSource: aiNarrativeSource,
        classification: classification,
        serialLabels: {
          suppressed: serialInfo.suppressed,
          corroboratedNames: serialInfo.corroborated.map(serialNameOf),
          weakNames: serialInfo.weak.map(serialNameOf),
          supportCount: serialInfo.supportCount
        },
        ots: { submitted: !!(otsResult && otsResult.success), calendar: otsResult && otsResult.calendar ? otsResult.calendar : null },
        images: { watermark: watermarkBytes }
      });

      console.log('[VO-REPORT-DEBUG] Report PDF built successfully', {
        report_bytes: reportBytes?.length,
        is_uint8array: reportBytes instanceof Uint8Array
      });

      var rSha512 = await computeSHA512(reportBytes);
      var rSealId = 'VO-' + rSha512.substring(0, 12).toUpperCase();
      var rOtsDigestHex = await computeSHA256(new TextEncoder().encode(rSha512));
      var rOts = await submitToOTS(rOtsDigestHex);
      var rMeta = collectSealMetadata();
      rMeta.sha512 = rSha512;
      rMeta.otsDigest = rOtsDigestHex;
      rMeta.otsStatus = rOts.success;
      rMeta.sealId = rSealId;
      rMeta.report = true;
      var rQrContent = 'https://verumglobal.foundation/verify.html?h=' + rSha512.substring(0, 32) + '&m=' + encodeURIComponent(utf8ToBase64(JSON.stringify(buildQrPayload(rMeta, null))));
      var rQr = await generateQRDataURL(rQrContent, 400);

      console.log('[VO-REPORT-DEBUG] About to seal report', {
        seal_id: rSealId,
        report_size_kb: (reportBytes?.length / 1024).toFixed(2)
      });

      var rSealedBytes = await window.VerumReport.seal(reportBytes, {
        sealId: rSealId,
        sha512: rSha512,
        qrDataURL: rQr,
        sourceName: selectedFile.name
      });

      console.log('[VO-REPORT-DEBUG] Report sealed successfully', {
        sealed_size_kb: (rSealedBytes?.length / 1024).toFixed(2),
        size_increase_bytes: (rSealedBytes?.length - reportBytes?.length)
      });

      reportPack = { bytes: rSealedBytes, sealId: rSealId, sha512: rSha512, ots: rOts };
      window._voReportPack = reportPack;

      // The narrator reads the technical report's text from the PRE-SEAL bytes:
      // the seal overlay is proof, not case evidence. Extraction is local; the
      // bounded text leaves only after the report's seal id and hash exist.
      var technicalReportContext = null;
      try {
        technicalReportContext = await voTechnicalReportTextForNarrative(reportBytes, VO_HUMAN_TECH_REPORT_CHARS, VO_HUMAN_TECH_REPORT_PAGES);
        technicalReportContext.sealId = reportPack.sealId;
        technicalReportContext.sha512 = reportPack.sha512;
      } catch (trcErr) {
        console.warn('Technical-report narrator context unavailable (narrative will use findings and sealed page text):', trcErr);
        technicalReportContext = { text: '', pageCount: 0, suppliedPages: 0, truncated: false, charCount: 0, sealId: reportPack.sealId, sha512: reportPack.sha512 };
      }

      // The plain-language narrative PDF was retired on 2026-09-07 (founder:
      // "the human narrative is not necessary"): the forensic report's Part 1
      // already carries the plain-language telling, and the court-ready
      // narrative below is the covering document. buildNarrative stays in
      // forensic-report.js for the annex path and its tests; the seal page no
      // longer produces or offers the file.
      window._voNarrativePack = null;

      // Findings JSON (1verum GHRP contract v1.0.0) — the machine-readable
      // twin of the report, offered as its own download. Never blocks the seal.
      window._voFindingsJson = null;
      try {
        window._voAiReviewApplied = !!(aiReviewInfo && aiReviewInfo.applied === true);
        window._voFindingsJson = buildFindingsJson(
          reportFraudResult, selectedFile.name, sha512, _pipelinePageCount || 0, voCaseDetails());
      } catch (fjErr) {
        console.warn('Findings JSON generation failed (report unaffected):', fjErr);
      }

      // Court-ready narrative ("human report") — opt-in, default OFF. Written by
      // the AI narrator section by section from the sealed findings, gated on
      // the worker and again at render time, rendered by buildHumanReport and
      // sealed like every other output. Runs AFTER the technical report and the
      // findings JSON so it can cite both by hash; never blocks the seal, the
      // report or the JSON.
      window._voHumanReportPack = null;
      try {
        // The court-ready narrative is part of "Seal document with forensic
        // report": no separate switch (founder direction 2026-09-07).
        if (isAiReviewEnabled() && reportFraudResult && !reportFraudResult.scanFailed &&
            Array.isArray(reportFraudResult.findings) && reportFraudResult.findings.length > 0 &&
            typeof window.VerumReport.buildHumanReport === 'function') {
          updateStep(7, 'processing', 'Verifying the legal citations before drafting the narrative...');
          var fjSha = null;
          try { if (window._voFindingsJson) fjSha = await computeSHA512(new TextEncoder().encode(JSON.stringify(window._voFindingsJson, null, 2))); } catch (eFj) {}
          // B7 law lanes: verify the candidate statutes before the narrative
          // cites them (null when unreachable — the report claims nothing then).
          var lawCheck = await aiVerifyLaw(reportFraudResult, fjSha);
          updateStep(7, 'processing', 'Drafting the court-ready narrative (AI, section by section)...');
          var hr = await aiHumanReport(reportFraudResult.findings, {
            timeline: reportFraudResult.timeline || null,
            unreadPages: _voUnreadPages,
            lawCheck: lawCheck,
            technicalSealId: reportPack.sealId,
            technicalSha512: reportPack.sha512,
            technicalReport: technicalReportContext,
            findingsJsonText: window._voFindingsJson ? JSON.stringify(window._voFindingsJson, null, 2) : '',
            onProgress: function (i, n, sec) { updateStep(7, 'processing', 'Court-ready narrative: section ' + i + ' of ' + n + ' (' + String(sec).replace(/_/g, ' ') + ')...'); }
          });
          var hBytes = await window.VerumReport.buildHumanReport({
            findings: reportFraudResult,
            documents: [{ name: selectedFile.name, pageCount: _pipelinePageCount || null, sha512: sha512, sealId: sealId }],
            identity: (function () {
              var ci3 = voCaseDetails();
              return { caseName: ci3.caseName || undefined, caseRefs: ci3.caseRefs || undefined, parties: ci3.parties || undefined, jurisdiction: ci3.jurisdiction || undefined };
            })(),
            extractionNotes: fraudResult && fraudResult.extractionNotes ? fraudResult.extractionNotes : null,
            rulePackage: (fraudResult && fraudResult.rulePackage) || null,
            rulePackageStatus: window._voRulePackageStatus || null,
            unreadPages: _voUnreadPages,
            ocrPages: _voOcrRescuedPages || null,
            ocrConfidence: _voOcrConfidence || null,
            gps: (typeof gpsCoords !== 'undefined' && gpsCoords) ? { lat: gpsCoords.lat, lng: gpsCoords.lng, acc: gpsCoords.accuracy || null } : null,
            aiReview: aiReviewInfo,
            classification: classification,
            serialLabels: { suppressed: serialInfo.suppressed, corroboratedNames: serialInfo.corroborated.map(serialNameOf), weakNames: serialInfo.weak.map(serialNameOf), supportCount: serialInfo.supportCount },
            ots: { submitted: !!(otsResult && otsResult.success), calendar: otsResult && otsResult.calendar ? otsResult.calendar : null },
            images: { watermark: watermarkBytes },
            humanSections: hr.sections,
            humanFindings: hr.humanFindings,
            lawCheck: lawCheck,
            humanProvenance: {
              model: hr.model, contract: 'human-v1', generatedUtc: hr.generatedUtc,
              technicalSealId: reportPack.sealId, technicalSha512: reportPack.sha512,
              findingsJsonSha512: fjSha, findingsJsonVersion: window._voFindingsJson ? window._voFindingsJson.findings_json_version : null,
              sectionsGenerated: hr.generated, sectionsWriter: hr.writerSections, sectionsAttempted: hr.calls, modelAttempts: hr.modelAttempts || 0,
              recordContext: hr.recordContext || null
            }
          });
          var hSha512 = await computeSHA512(hBytes);
          var hSealId = 'VO-' + hSha512.substring(0, 12).toUpperCase();
          var hDigestHex = await computeSHA256(new TextEncoder().encode(hSha512));
          var hOts = await submitToOTS(hDigestHex);
          var hMeta = collectSealMetadata();
          hMeta.sha512 = hSha512; hMeta.otsDigest = hDigestHex; hMeta.otsStatus = hOts.success; hMeta.sealId = hSealId; hMeta.report = true;
          var hQrContent = 'https://verumglobal.foundation/verify.html?h=' + hSha512.substring(0, 32) + '&m=' + encodeURIComponent(utf8ToBase64(JSON.stringify(buildQrPayload(hMeta, null))));
          var hQr = await generateQRDataURL(hQrContent, 400);
          var hSealedBytes = await window.VerumReport.seal(hBytes, { sealId: hSealId, sha512: hSha512, qrDataURL: hQr, sourceName: selectedFile.name, tag: 'NARRATIVE REPORT', titleSuffix: ' — Sealed Court-Ready Narrative' });
          window._voHumanReportPack = { bytes: hSealedBytes, sealId: hSealId, sha512: hSha512, ots: hOts, generated: hr.generated, writerSections: hr.writerSections, model: hr.model };
          updateStep(7, 'processing', 'Court-ready narrative sealed (' + hr.generated + ' of ' + hr.writerSections + ' sections AI-written)');
        }
      } catch (hErr) {
        console.warn('Court-ready narrative generation failed (seal, report and JSON unaffected):', hErr);
      }
      console.log('[VO-REPORT-DEBUG] Report pack created and stored');
      updateStep(7, 'complete');
    } else {
      console.log('[VO-REPORT-DEBUG] Report build skipped', {
        sealMode_is_forensic: sealMode === 'forensic',
        verum_report_exists: !!window.VerumReport,
        build_fn_exists: typeof window.VerumReport?.build === 'function'
      });
    }
  } catch (repErr) {
    console.error('[VO-REPORT-DEBUG] Report generation failed:', {
      error_message: repErr?.message,
      error_name: repErr?.name,
      stack_preview: repErr?.stack?.substring(0, 300)
    });
    reportPack = null;
    window._voReportPack = reportPack;
    updateStep(7, 'complete');
  }

  showResults(sha256, sha512, sealId, otsResult, sealedBytes, meta, password, senderEmail, chain, encryptedBytes, fraudResult);

  // Brain 9 recommendations on screen and as an unsealed file — never in the sealed report.
  voRenderBrain9Recommendations();

  // Opt-in anonymous pattern feedback — fire-and-forget, never blocks.
  shareAnonymousPatterns(fraudResult);
}

// Native share via the Web Share API. On a phone this opens the system share
// sheet (WhatsApp, email, Drive, …) with the sealed/protected file attached.
// Reads window._voShareBytes/_voShareName/_voShareType set by showResults.
// Hidden entirely where file sharing is unsupported, so desktop users just use
// the download button and nothing looks broken.
// Build a File from the share payload. window._voShareBytes may be a
// Uint8Array; copy it so the underlying ArrayBuffer is never detached by a
// previous share attempt.
function voShareFile() {
  if (!window._voShareBytes) return null;
  try {
    var copy = new Uint8Array(window._voShareBytes);
    return new File([copy], window._voShareName, { type: window._voShareType });
  } catch (e) { return null; }
}


// ---- One-file bundle save (store-only ZIP, no dependency) ------------------
// Saving the record used to fire one download per file, which trips the
// browser's "allow multiple downloads?" permission prompt — and that grant
// never persists in incognito, so the record-save looked broken every time.
// One archive means one download and no prompt. Store-only (no compression):
// the payloads are already-compressed PDFs, so deflate would buy nothing and
// cost a dependency. Timestamps are FIXED, never wall-clock, so the same
// bundle always produces the same archive bytes.
var VO_CRC_TABLE = (function () {
  var t = new Uint32Array(256);
  for (var n = 0; n < 256; n++) {
    var c = n;
    for (var k = 0; k < 8; k++) c = (c & 1) ? (0xEDB88320 ^ (c >>> 1)) : (c >>> 1);
    t[n] = c >>> 0;
  }
  return t;
})();
function voCrc32(bytes) {
  var c = 0xFFFFFFFF;
  for (var i = 0; i < bytes.length; i++) c = VO_CRC_TABLE[(c ^ bytes[i]) & 0xFF] ^ (c >>> 8);
  return (c ^ 0xFFFFFFFF) >>> 0;
}
function voZipBundle(entries) {
  var enc = new TextEncoder();
  var parts = [], central = [], offset = 0;
  var DOS_TIME = 0, DOS_DATE = 33; // fixed 1 Jan 1980 — deterministic, not a clock
  for (var i = 0; i < entries.length; i++) {
    var nameBytes = enc.encode(entries[i].name);
    var data = entries[i].bytes instanceof Uint8Array ? entries[i].bytes : new Uint8Array(entries[i].bytes);
    var crc = voCrc32(data);
    var lh = new Uint8Array(30 + nameBytes.length);
    var lv = new DataView(lh.buffer);
    lv.setUint32(0, 0x04034b50, true); lv.setUint16(4, 20, true); lv.setUint16(6, 0, true);
    lv.setUint16(8, 0, true); lv.setUint16(10, DOS_TIME, true); lv.setUint16(12, DOS_DATE, true);
    lv.setUint32(14, crc, true); lv.setUint32(18, data.length, true); lv.setUint32(22, data.length, true);
    lv.setUint16(26, nameBytes.length, true); lv.setUint16(28, 0, true);
    lh.set(nameBytes, 30);
    parts.push(lh, data);
    var ch = new Uint8Array(46 + nameBytes.length);
    var cv = new DataView(ch.buffer);
    cv.setUint32(0, 0x02014b50, true); cv.setUint16(4, 20, true); cv.setUint16(6, 20, true);
    cv.setUint16(8, 0, true); cv.setUint16(10, 0, true); cv.setUint16(12, DOS_TIME, true);
    cv.setUint16(14, DOS_DATE, true); cv.setUint32(16, crc, true);
    cv.setUint32(20, data.length, true); cv.setUint32(24, data.length, true);
    cv.setUint16(28, nameBytes.length, true); cv.setUint16(30, 0, true); cv.setUint16(32, 0, true);
    cv.setUint16(34, 0, true); cv.setUint16(36, 0, true); cv.setUint32(38, 0, true);
    cv.setUint32(42, offset, true);
    ch.set(nameBytes, 46);
    central.push(ch);
    offset += lh.length + data.length;
  }
  var cdSize = 0;
  for (var c2 = 0; c2 < central.length; c2++) cdSize += central[c2].length;
  var eocd = new Uint8Array(22);
  var ev = new DataView(eocd.buffer);
  ev.setUint32(0, 0x06054b50, true); ev.setUint16(4, 0, true); ev.setUint16(6, 0, true);
  ev.setUint16(8, entries.length, true); ev.setUint16(10, entries.length, true);
  ev.setUint32(12, cdSize, true); ev.setUint32(16, offset, true); ev.setUint16(20, 0, true);
  return new Blob(parts.concat(central, [eocd]), { type: 'application/zip' });
}

// Build the FULL share list — sealed/protected document + sealed forensic
// report + findings JSON — from window._voShareFiles. Each byte payload is
// copied so a previous share attempt can never leave a detached buffer.
function voShareFileList() {
  var out = [];
  var items = window._voShareFiles || [];
  for (var i = 0; i < items.length; i++) {
    try {
      var rawBytes = new Uint8Array(items[i].bytes);
      var fileObj = new File([rawBytes], items[i].name, { type: items[i].type });
      // Keep the bytes reachable synchronously: the one-file bundle save zips
      // them inside the click handler, where File.arrayBuffer() (async) would
      // lose the user-activation token the share sheet needs.
      fileObj.voBytes = rawBytes;
      out.push(fileObj);
    } catch (e) {}
  }
  if (!out.length) {
    var f = voShareFile();
    if (f) { try { f.voBytes = new Uint8Array(window._voShareBytes); } catch (eB) {} out.push(f); }
  }
  return out;
}

// Pick the largest shareable subset of the bundle. Chrome/Android restricts
// navigator.share files to an allowlist of MIME types — application/json is
// NOT on it, so a bundle that includes the findings JSON can fail canShare()
// as a whole and (previously) collapsed to a single file. We instead try, in
// order: the full bundle, then everything the device says it can share, then
// just the sealed document — so WhatsApp/email get the report too whenever
// the device allows it.
function voShareCandidates(files) {
  var out = [];
  if (!files.length) return out;
  var canShare = navigator.canShare ? function (fs) {
    try { return navigator.canShare({ files: fs }); } catch (e) { return false; }
  } : null;
  // 1) everything
  out.push(files.slice());
  // 2) drop the types the device can't share (keeps document + report, drops JSON)
  if (canShare) {
    var keep = files.filter(function (f) { return canShare([f]); });
    if (keep.length && keep.length < files.length) out.push(keep);
  }
  // 3) last resort: the sealed document alone
  if (files.length > 1) out.push([files[0]]);
  return out;
}

function addShareButton() {
  var old = document.getElementById('shareSealedBtn');
  if (old) old.remove();
  var hintOld = document.getElementById('shareHint');
  if (hintOld) hintOld.remove();
  // Show whenever there is anything sealed to hand over. We do NOT gate on
  // navigator.share: in-app browsers (WhatsApp/Gmail WebViews) often lack the
  // Web Share API entirely, which used to hide the button and make it look
  // broken. When sharing is unavailable the button downloads the bundle
  // instead, so there is always a working action.
  if (!window._voShareBytes) return;
  var grid = document.getElementById('downloadGrid');
  if (!grid) return;
  var canWebShare = typeof navigator.share === 'function';

  var btn = document.createElement('button');
  btn.id = 'shareSealedBtn';
  btn.type = 'button';
  btn.className = 'download-btn primary';
  btn.innerHTML = canWebShare
    ? '&#128228; Share to WhatsApp, email, …'
    : '&#11015; Save files to send (WhatsApp, email, …)';
  var hint = document.createElement('div');
  hint.id = 'shareHint';
  hint.style.cssText = 'font-size:12px;color:#8ea3b5;margin:6px 0 4px;line-height:1.5;';
  var bundleN = (window._voShareFiles || []).length;
  if (canWebShare) {
    hint.textContent = bundleN > 1
      ? 'Opens your phone’s share menu with the whole bundle attached (' + bundleN + ' files) — and saves a copy of each to your device for your records.'
      : 'Opens your phone’s share menu so you can send the file straight to WhatsApp, email or any app — and saves a copy to your device for your records.';
  } else {
    hint.textContent = bundleN > 1
      ? 'This browser can’t open a share menu (common inside WhatsApp/Gmail). Tapping saves all ' + bundleN + ' files so you can attach them — or open this page in Chrome/Safari for one-tap sharing.'
      : 'This browser can’t open a share menu (common inside WhatsApp/Gmail). Tapping saves the file so you can attach it — or open this page in Chrome/Safari for one-tap sharing.';
  }

  btn.addEventListener('click', function () {
    // navigator.share MUST be called synchronously in the click handler to keep
    // the user-activation token; build the Files first, no await before share.
    var files = voShareFileList();
    if (!files.length) { fallbackDownload('Could not prepare the file to share.'); return; }
    if (!canWebShare) { fallbackDownload('', files); return; }

    // Try progressively smaller shareable subsets; stop at the first the
    // device accepts. If canShare is unavailable we just attempt the full set.
    var candidates = voShareCandidates(files);
    var chosen = null;
    if (navigator.canShare) {
      for (var i = 0; i < candidates.length; i++) {
        try { if (navigator.canShare({ files: candidates[i] })) { chosen = candidates[i]; break; } } catch (e) {}
      }
    } else {
      chosen = files;
    }
    if (!chosen) {
      fallbackDownload('This browser can’t share files directly — the files have downloaded instead; attach them from your Downloads.', files);
      return;
    }
    var data = { files: chosen, title: window._voShareName, text: window._voShareText || 'This document is sealed with Verum Omnis. Verify it at https://verumglobal.foundation/verify.html' };
    // FOR THE USER'S RECORD: the share sheet hands copies to another app, and
    // some browsers (Samsung Internet among them) attach only part of the
    // bundle even after canShare() approved it — with no way to detect what
    // the target app actually received. So every share ALSO saves the full
    // bundle to the device. ORDER MATTERS: the saves are queued BEFORE the
    // share call — triggering them after it raced the native sheet, and on
    // Samsung Internet the download UI dismissed the sheet entirely (field
    // report: "downloads but no share sheet"). Queued first, the downloads
    // run in the background and the sheet opens on the same tap.
    saveFiles(files);
    var shared = null;
    try { shared = navigator.share(data); } catch (eSync) {
      hint.style.color = '#D4A843';
      hint.textContent = 'Sharing didn’t work on this device — the files are saved on your device; attach them from your Downloads.';
      return;
    }
    if (shared && shared.catch) shared.catch(function (err) {
      // AbortError / NotAllowedError = the user closed the share sheet. Ignore.
      if (err && (err.name === 'AbortError' || err.name === 'NotAllowedError')) return;
      hint.style.color = '#D4A843';
      hint.textContent = 'Sharing didn’t work on this device — the files are saved on your device; attach them from your Downloads.';
    });
  });

  // Save the bundle to the device in ONE download: several files at once trip
  // the browser's multiple-download prompt, which never persists in incognito.
  function saveFiles(list) {
    try {
      if (!list || !list.length) return;
      var a = document.createElement('a');
      if (list.length === 1) {
