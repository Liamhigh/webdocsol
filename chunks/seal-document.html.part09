    whatHappened += 'The first finding in the engine\'s order is ' + art(n0) + ' ' + n0 + ' ' + atWhere(s0) + ' - "' + quoteOf(s0) + '".';
    var who0 = actors.filter(function (a) { return firstWord(a) && new RegExp('\\b' + firstWord(a).replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '\\b', 'i').test(quoteOf(s0)); });
    if (who0.length) whatHappened += ' This directly concerns ' + joinList(who0) + '.';
    if (strongest[1]) {
      var n1 = nameOf(strongest[1].type).toLowerCase();
      whatHappened += ' The next is ' + art(n1) + ' ' + n1 + ' ' + atWhere(strongest[1]) + ' - "' + quoteOf(strongest[1]) + '"';
      if (strongest[2]) whatHappened += ', with ' + art(nameOf(strongest[2].type).toLowerCase()) + ' ' + nameOf(strongest[2].type).toLowerCase() + ' ' + atWhere(strongest[2]) + ' alongside it';
      whatHappened += '.';
    }
    if (counts.length) {
      var themes = counts.slice(0, 3).map(function (x) { return (CATLAB[x.cat] || x.cat).toLowerCase(); });
      whatHappened += ' Taken together, the findings fall under ' + joinList(themes) + '.';
    }
    if (actors.length) {
      var scored = actors.map(function (a) {
        var re = new RegExp('\\b' + firstWord(a).replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '\\b', 'i');
        var n = list.filter(function (f) { return f.type !== 'SERIAL' && !isDem(f) && re.test(String(f.evidence || '')); }).length;
        return { name: a, n: n };
      }).filter(function (s) { return s.n > 0; }).sort(function (a, b) { return b.n - a.n; });
      if (scored.length) whatHappened += ' By party, the flagged material most often names ' +
        joinList(scored.slice(0, 3).map(function (s) { return s.name + ' (' + s.n + ' finding' + (s.n === 1 ? '' : 's') + ')'; })) + '.';
    }
    // ("not a determination of guilt" and "could read" carried §15.2-banned
    // words, so the render gate dropped this sentence on every telling.)
    whatHappened += ' This account is built only from the findings the engine recorded; it is for an investigator or the court to weigh, the verdict on any named person is for the court, and nothing here is asserted beyond what the sealed document itself contains.';
  }

  // ---------- assemble ----------
  var out = '';
  if (whatHappened) out += 'WHAT HAPPENED\n\n' + whatHappened + SEP;
  out += 'SUMMARY\n\n' + summary;
  if (keyParts.length) out += SEP + 'KEY FINDINGS\n\n' + keyParts.join('\n\n');
  out += SEP + 'WHAT THE EVIDENCE SHOWS\n\n' + evidence;
  if (patterns) out += SEP + 'MULTI-STAGE PATTERNS\n\n' + patterns;
  // The seal shows integrity since sealing and the time; it never proves a
  // document authentic (CLAUDE.md non-negotiable 8).
  out += SEP + 'IMPORTANT LIMITS\n\nThe seal shows that the document has not changed since it was sealed, and when it was ' +
    'sealed; it does not show that the contents are true, or that the document was genuine before it was sealed. A court or ' +
    'investigator decides. Each finding is stated as fact, anchored to the record; the verdict on any named person is for the court.';
  return out;
}

// Build the AI narrator's document excerpt from the pages the findings actually
// anchor to, instead of the first N characters of the bundle. On a 148-page file
// the contradictions sit deep in the record, so a first-12k-chars excerpt showed
// the narrator none of the evidence and it wrote a generic summary. This gathers
// each finding's page(s) (parsing "Page 113", "p. 2 vs 138", "Page 1 vs Page 3"
// and f.page), adds an immediate neighbour of each for context, always includes
// page 1 for document identity (parties, letterhead, case name), tags every
// block with its page so the narrator's citations line up, and budgets the
// selected pages within the worker's excerpt cap. Falls back to the document
// head when no finding names a page (or page text is unavailable).
function voBuildNarrateExcerpt(textBlocks, findings, maxChars) {
  maxChars = maxChars || 12000;
  if (!Array.isArray(textBlocks) || !textBlocks.length) return '';
  var nPages = textBlocks.length;
  var want = {};
  var addPage = function (p) { if (p >= 1 && p <= nPages) want[p] = true; };
  var list = Array.isArray(findings) ? findings : [];
  var pageRe = /(?:page|p\.?)\s*(\d{1,4})/gi;
  var vsRe = /\bvs\.?\s*(?:page|p\.?\s*)?(\d{1,4})/gi;
  for (var i = 0; i < list.length; i++) {
    var f = list[i] || {};
    var loc = String(f.location || '');
    var m;
    pageRe.lastIndex = 0; while ((m = pageRe.exec(loc)) !== null) addPage(parseInt(m[1], 10));
    vsRe.lastIndex = 0;   while ((m = vsRe.exec(loc)) !== null) addPage(parseInt(m[1], 10));
    if (typeof f.page === 'number') addPage(f.page);
  }
  var anchored = Object.keys(want).map(Number);
  for (var a = 0; a < anchored.length; a++) { addPage(anchored[a] - 1); addPage(anchored[a] + 1); }
  addPage(1);  // document identity
  // Also pull in pages carrying a role/capacity claim or an account instruction,
  // even when no finding anchors to them. These are the two halves of a
  // role/capacity contradiction (e.g. "in my capacity as a director of X" deep in
  // an affidavit vs a payment routed to a differently-named account) — a finding
  // rarely anchors to the capacity page, so without this the narrator only ever
  // sees one half and cannot reason the contradiction. Strong capacity claims are
  // preferred and the count is capped so a bundle that says "trust account" on
  // many pages cannot flood the excerpt.
  var VO_CAPACITY_RE = /in (?:my|his|her) capacity as|capacity as (?:a |an )?(?:director|member|trustee|representative|agent)|on behalf of [A-Z]|personal (?:bank |trust )?account|trust account|nominated (?:bank )?account/i;
  var VO_CAPACITY_STRONG = /in (?:my|his|her) capacity as|capacity as (?:a |an )?(?:director|member|trustee)/i;
  var markerPages = [];
  for (var mp = 0; mp < nPages; mp++) {
    if (want[mp + 1]) continue;
    var mt = String(textBlocks[mp] || '');
    if (VO_CAPACITY_RE.test(mt)) markerPages.push({ page: mp + 1, strong: VO_CAPACITY_STRONG.test(mt) ? 1 : 0 });
  }
  markerPages.sort(function (x, y) { return (y.strong - x.strong) || (x.page - y.page); });
  for (var mq = 0; mq < markerPages.length && mq < 5; mq++) addPage(markerPages[mq].page);
  var ordered = Object.keys(want).map(Number).sort(function (x, y) { return x - y; });
  // Nothing useful selected (no finding page, no capacity/account marker) -> head.
  if (ordered.length <= 1) {
    var head = '';
    for (var h = 0; h < nPages && head.length < maxChars; h++) {
      head += (head ? '\n\n' : '') + '[Page ' + (h + 1) + '] ' + String(textBlocks[h] || '').replace(/\s+/g, ' ').trim();
    }
    return head.slice(0, maxChars);
  }
  var perPageCap = Math.max(600, Math.floor(maxChars / ordered.length));
  var out = [], used = 0;
  for (var k = 0; k < ordered.length && used < maxChars; k++) {
    var raw = String(textBlocks[ordered[k] - 1] || '').replace(/\s+/g, ' ').trim();
    if (!raw) continue;
    var block = '[Page ' + ordered[k] + '] ' + raw.slice(0, Math.min(perPageCap, maxChars - used));
    out.push(block);
    used += block.length + 2;
  }
  return out.join('\n\n').slice(0, maxChars);
}

async function aiNarrateReport(findings, score, verdict) {
  // Build the exact shape the worker's /api/v1/ai/narrate contract requires.
  // The old payload sent {findings, score, verdict} but the worker validates
  // findingsKept/confidence/documentName — so every narrate call 400'd and the
  // report silently fell back to no AI narrative. Ids are assigned F1, F2, ...
  // so the model's [F#] citations line up with the findings list.
  var list = Array.isArray(findings) ? findings.filter(Boolean) : [];
  // One numbering for every [F#] in both PDFs: the court-ready narrative's
  // list (engine findings by severity as F#, AI candidates as C#), then any
  // item that list leaves out (a serial pattern) as P#. Numbering the raw
  // engine order made the technical report's narrative call the lookalike
  // domain F2 while Findings in Detail called the signature finding F2.
  var hl = voHumanFindingList(list), inHl = [];
  var ordered = hl.findings.concat(hl.candidates);
  for (var oi = 0; oi < ordered.length; oi++) inHl.push(ordered[oi].f);
  // P#: engine findings without a number (by severity, as the technical
  // report lists them), then serial patterns.
  var rest = list.filter(function (f) { return inHl.indexOf(f) === -1; }).sort(function (a, b) {
    return ((a.type === 'SERIAL') - (b.type === 'SERIAL')) || ((b.severity || 0) - (a.severity || 0));
  });
  for (var ri = 0; ri < rest.length; ri++) ordered.push({ id: 'P' + (ri + 1), f: rest[ri] });
  var findingsKept = ordered.map(function (o) {
    var f = o.f;
    return {
      id: o.id,
      type: f.type || 'unknown',
      severity: f.severity,
      // Two-tier rule (1verum GHRP): deterministic engine findings vs the
      // candidates the AI review raised, pending verification. The narrator
      // must keep the tiers apart, so each finding carries its tier and its
      // ordinal severity (never a bare number alone). The tier is "ENGINE
      // FINDING", never "verified" (founder ruling, 5 October 2026: PD13's
      // three independent verifiers are not met).
      severityOrdinal: VO_SEV_ORDINAL[f.severity] || 'LOW',
      status: (f.source === 'ai') ? 'AI-RAISED CANDIDATE - PENDING VERIFICATION' : 'ENGINE FINDING',
      location: f.location || (f.page ? 'Page ' + f.page : ''),
      evidence: (f.evidence || f.description || '').toString()
    };
  });
  var metadata = {
    documentName: (typeof selectedFile !== 'undefined' && selectedFile && selectedFile.name) ? selectedFile.name : 'sealed document',
    pageCount: _pipelinePageCount || 0,
    score: score,
    confidence: verdict,
    findingsKept: findingsKept,
    findingsPruned: 0,
    generatedUtc: new Date().toISOString()
  };
  if (gpsCoords) { metadata.gps = gpsCoords.lat + ',' + gpsCoords.lng; if (gpsCoords.accuracy) metadata.gpsAccuracy = Math.round(gpsCoords.accuracy) + 'm'; }
  if (deviceInfo) { metadata.device = deviceInfo; }
  // User-entered case details are authoritative context for the narrator —
  // real case name, references, parties and jurisdiction, sent only when the
  // user typed them (they are already destined for the report cover).
  var caseInfo = voCaseDetails();
  if (caseInfo.caseName || caseInfo.caseRefs || caseInfo.parties || caseInfo.jurisdiction) {
    metadata.caseContext = caseInfo;
  }
  // Give the narrator the document's own words so it can name the real parties,
  // dates and amounts instead of writing from bare finding codes. Bounded and
  // sent only because the user consented to AI review (text -> their own
  // Cloudflare AI). Empty when extraction produced nothing -> findings-only.
  // Prefer an excerpt built AROUND the finding pages (so the narrator sees the
  // actual evidence, not just the opening pages); fall back to the head sample.
  var excerpt = '';
  try {
    if (_pipelineTextBlocks && _pipelineTextBlocks.length) excerpt = voBuildNarrateExcerpt(_pipelineTextBlocks, list, 12000);
  } catch (eEx) { excerpt = ''; }
  if (!excerpt && _pipelineTextSample) excerpt = String(_pipelineTextSample).slice(0, 12000);
  if (excerpt) { metadata.documentExcerpt = excerpt; }
  console.log('[VO-AI-NARRATE] Requesting AI narrative for', findingsKept.length, 'findings',
    metadata.documentExcerpt ? '(with ' + metadata.documentExcerpt.length + ' chars of document text)' : '(findings only)');
  // Narrate now runs on the fast 8B model server-side with a single 30 s AI
  // timeout (no slow 70B fallback). This client timeout sits just above that
  // (30 s + network/JSON margin) so it waits out a legitimately slow generation
  // but does not hang far past the point the server itself would have given up.
  window._voNarrateTemplate = false;
  var res = await aiApiPost('/api/v1/ai/narrate', metadata, 38000);
  // PROVENANCE: when the model failed, the Worker answers with its
  // deterministic template (model 'template-fallback'). That text is not the
  // AI narrator's writing and must never lead the report as such — the
  // annexure EB re-run printed the template as "Written by the AI narrator".
  if (res && typeof res === 'object' && (res.model === 'template-fallback' || res.format === 'template')) window._voNarrateTemplate = true;
  console.log('[VO-AI-NARRATE] Received response:', {
    is_object: typeof res === 'object',
    has_summary: !!res?.summary,
    has_findings: !!res?.findings,
    has_legacy_narrative: !!res?.narrative
  });
  if (!res || typeof res !== 'object') {
    console.warn('[VO-AI-NARRATE] Invalid response, returning null');
    return null;
  }

  var sections = [];

  // New plain-language format (preferred): uses simpler field names
  if (res.summary || res.findings) {
    if (res.summary) sections.push('SUMMARY\n\n' + res.summary);
    if (res.findings) sections.push('WHAT THE EVIDENCE SHOWS\n\n' + res.findings);
    if (res.contradictions) sections.push('CONTRADICTIONS AND INCONSISTENCIES\n\n' + res.contradictions);
    if (res.impact) sections.push('IMPACT ON PEOPLE\n\n' + res.impact);
    if (res.legalContext) sections.push('WHAT THE LAW SAYS\n\n' + res.legalContext);
    if (res.evidence) sections.push('KEY EVIDENCE AND NEXT STEPS\n\n' + res.evidence);
    if (res.seal) sections.push('SEAL AND VERIFICATION DETAILS\n\n' + res.seal);
    if (res.limits) sections.push('IMPORTANT LIMITS\n\n' + res.limits);
    if (sections.length > 0) return sections.join('\n\n' + '='.repeat(80) + '\n\n');
  }

  // Professional format (backward compatible): old field names
  if (res.executiveSummary && res.forensicNarrative) {
    sections = [];
    if (res.executiveSummary) sections.push('EXECUTIVE SUMMARY\n\n' + res.executiveSummary);
    if (res.forensicNarrative) sections.push('FORENSIC ANALYSIS\n\n' + res.forensicNarrative);
    if (res.credibilityAnalysis) sections.push('CREDIBILITY ASSESSMENT\n\n' + res.credibilityAnalysis);
    if (res.victimImpact) sections.push('VICTIM IMPACT\n\n' + res.victimImpact);
    if (res.legalAnalysis) sections.push('LEGAL ANALYSIS\n\n' + res.legalAnalysis);
    if (res.conclusionsMap) sections.push('CONCLUSIONS AND EVIDENCE MAP\n\n' + res.conclusionsMap);
    if (res.chainOfCustody) sections.push('CHAIN OF CUSTODY\n\n' + res.chainOfCustody);
    if (res.disclaimer) sections.push('DISCLAIMER\n\n' + res.disclaimer);
    return sections.join('\n\n' + '='.repeat(80) + '\n\n');
  }

  // Legacy format fallback
  if (res.narrative && typeof res.narrative === 'string' && res.narrative.trim()) return res.narrative;
  if (res.criticalEvidence && typeof res.criticalEvidence === 'string') {
    return (res.executiveSummary || '') + '\n\n' + res.criticalEvidence;
  }

  return null;
}

// ---- Court-ready narrative ("human report") — client orchestration --------
// One worker call per WRITER section (the engine renders the rest), so every
// request stays inside one model timeout and a failure costs one section, not
// the document. Section ids mirror worker/verum-rules.js HUMAN_SECTIONS and
// forensic-report.js HUMAN_REPORT_SECTIONS (tests pin all three). Part of
// "Seal document with forensic report" (no switch since 2026-09-07): the
// bounded sealed page text, findings JSON and technical-report text leave this
// device for the AI narrator.
var VO_HUMAN_SECTIONS = [
  'executive_summary', 'evidence_index', 'chronology', 'four_pillars',
  'contradictions_matrix', 'critical_evidence', 'counter_narratives',
  'sworn_statements', 'coercive_conduct', 'legal_framework', 'offence_matrix',
  'recommendations', 'court_ready_declaration', 'authentication', 'annexures'
];
var VO_HUMAN_WRITER_SECTIONS = [
  'executive_summary', 'chronology', 'four_pillars', 'critical_evidence',
  'counter_narratives', 'sworn_statements', 'coercive_conduct', 'legal_framework',
  'recommendations'
];
var VO_HUMAN_CRITICAL_BATCH = 8;      // findings per critical-evidence call
var VO_HUMAN_EXCERPT_CHARS = 24000;   // per-request focused excerpt cap (server caps at the same)
var VO_HUMAN_RECORD_CHARS = 196000;   // page-tagged sealed-bundle text shared by every writer section (Scout's 131k-token window; the Greensky 332-page rerun starved at 64k — 100 pages, 56 truncated)
var VO_HUMAN_FINDINGS_JSON_CHARS = 32000; // bounded machine-readable confirmation record
var VO_HUMAN_TECH_REPORT_CHARS = 32000;   // bounded sealed technical-report text (pre-overlay bytes)
var VO_HUMAN_TECH_REPORT_PAGES = 40;      // enough for the findings and methodology; provenance states if truncated
var VO_HUMAN_CALL_TIMEOUT_MS = 52000; // server: primary 30 s + 8B fallback 15 s, plus margin
var VO_HUMAN_TOTAL_BUDGET_MS = 5 * 60 * 1000; // whole-narrative ceiling: sections past it are skipped, never left hanging

function voHumanFirstPage(f) {
  if (!f) return 0;
  if (f.page && isFinite(f.page)) return parseInt(f.page, 10) || 0;
  var m = String(f.location || '').match(/(\d{1,4})/);
  return m ? parseInt(m[1], 10) : 0;
}
function voHumanPages(f) {
  var out = [];
  var re = /(\d{1,4})/g, m;
  var loc = String((f && f.location) || '');
  while ((m = re.exec(loc)) !== null) { var n = parseInt(m[1], 10); if (n > 0 && out.indexOf(n) < 0) out.push(n); }
  if (f && f.anchor && Array.isArray(f.anchor.where)) {
    for (var i = 0; i < f.anchor.where.length; i++) { var w = parseInt(f.anchor.where[i], 10); if (w > 0 && out.indexOf(w) < 0) out.push(w); }
  }
  return out.slice(0, 12);
}

// The ordered, id-stamped finding list the narrator and the PDF builder share:
// engine-verified, substantive, anchored, most serious first — the same filter
// the technical report's Sealed Findings section applies. Candidates (AI-raised,
// pending verification) get C# ids and travel separately.
function voHumanFindingList(findings) {
  var list = Array.isArray(findings) ? findings.filter(Boolean) : [];
  var cq = (window.VerumReport && window.VerumReport._cleanQuote) ? window.VerumReport._cleanQuote : function (s) { return String(s || ''); };
  // One predicate with the technical report's FINDINGS IN DETAIL
  // (VerumReport._humanNumberable), so [F#] means one finding in every section.
  var numberable = (window.VerumReport && window.VerumReport._humanNumberable) ? window.VerumReport._humanNumberable : null;
  var verified = list.filter(function (f) {
    if (numberable) return numberable(f);
    if (f.source === 'ai' || f.type === 'SERIAL') return false;
    if (/\[bundle context:/i.test(String(f.evidence || ''))) return false;
    return cq(String(f.evidence || '')).replace(/["'\s.,;:—-]/g, '').length > 0 && voHumanPages(f).length > 0;
  }).sort(function (a, b) { return (b.severity || 0) - (a.severity || 0); });
  var candidates = list.filter(function (f) { return f.source === 'ai'; });
  return {
    findings: verified.map(function (f, i) { return { id: 'F' + (i + 1), f: f }; }),
    candidates: candidates.map(function (f, i) { return { id: 'C' + (i + 1), f: f }; })
  };
}

// The pipeline records unread pages as {capped, noText, renderFailed,
// timedOut} page-number lists; the narrator wants one [{page, reason}] list
// so a gap can be stated per page (PD6). Accepts either shape.
function voHumanUnreadList(u) {
  if (!u || typeof u !== 'object') return [];
  if (Array.isArray(u)) return u.slice(0, 30);
  var out = [];
  var add = function (arr, reason) {
    if (!Array.isArray(arr)) return;
    for (var i = 0; i < arr.length; i++) { var n = parseInt(arr[i], 10); if (isFinite(n) && n > 0) out.push({ page: n, reason: reason }); }
  };
  add(u.noText, 'no text layer and no OCR text recovered');
  add(u.renderFailed, 'page could not be rendered for OCR');
  add(u.timedOut, 'OCR timed out on this page');
  add(u.capped, 'beyond the OCR page cap; not read');
  out.sort(function (a, b) { return a.page - b.page; });
  return out.slice(0, 30);
}

function voHumanPayloadFinding(item) {
  var f = item.f;
  var ct = (typeof voCtById === 'function') ? voCtById(f.type) : null;
  var nm = (window.VerumReport && window.VerumReport._narrativeMeaning) ? window.VerumReport._narrativeMeaning(f) : '';
  var cq = (window.VerumReport && window.VerumReport._cleanQuote) ? window.VerumReport._cleanQuote : function (s) { return String(s || ''); };
  var who = (f.anchor && Array.isArray(f.anchor.who)) ? f.anchor.who.map(function (w) { return (w && typeof w === 'object') ? w.name : w; }).filter(Boolean).slice(0, 6) : [];
  var law = (f.anchor && Array.isArray(f.anchor.law)) ? f.anchor.law.slice(0, 6) : [];
  return {
    id: item.id,
    type: f.type || 'unknown',
    // The label the reports print (what was measured), so the narrator never
    // writes "Registration Number Fake" over a format check.
    name: (window.VerumReport && window.VerumReport._findingName && ct) ? window.VerumReport._findingName(f) : ((ct && ct.name) ? ct.name : (f.serialName || f.category || 'finding')),
    severity: f.severity,
    location: f.location || (f.page ? 'Page ' + f.page : ''),
    page: voHumanFirstPage(f),
    pages: voHumanPages(f),
    evidence: String(f.evidence || f.rationale || f.description || '').slice(0, 800),
    quote: cq(String(f.evidence || '')).slice(0, 400),
    plain: String(nm || '').slice(0, 300),
    who: who,
    law: law,
    sworn: f.swornContext === true
  };
}

// The LEGAL FRAMEWORK narrator may name only law the B7 lanes confirmed.
// Pass the fixed {statute, section} shape through; anything else is dropped.
function voLawVerifiedForNarrative(lawCheck) {
  var out = [], seen = {};
  if (!lawCheck || !Array.isArray(lawCheck.results)) return out;
  for (var i = 0; i < lawCheck.results.length && out.length < 12; i++) {
    var r = lawCheck.results[i] || {};
    var statute = String(r.statute || '').trim().slice(0, 200);
    var section = String(r.section || '').trim().slice(0, 60);
    if (r.status !== 'VERIFIED' || statute.length < 4) continue;
    var key = (statute + '|' + section).toLowerCase();
    if (seen[key]) continue;
    seen[key] = true;
    out.push({ statute: statute, section: section });
  }
  return out;
}

// The narrator reads the sealed record, not only the finding metadata. Small
// bundles go across whole. Large bundles go across as a deterministic page set:
// page 1 for identity, every finding/candidate page with its neighbours, every
// timeline page, and the strongest capacity/account pages. The coverage object
// is part of the payload and is printed in the narrative provenance, so a
// truncated context can never masquerade as a full-bundle reading.
function voBuildSealedRecordContext(textBlocks, payloadFindings, timeline, maxChars) {
  maxChars = maxChars || VO_HUMAN_RECORD_CHARS;
  var blocks = Array.isArray(textBlocks) ? textBlocks : [];
  var totalPages = blocks.length;
  var emptyCoverage = {
    totalPages: totalPages, suppliedPages: [], suppliedPageCount: 0,
    omittedPages: [], omittedPageCount: totalPages, truncatedPages: [],
    truncatedPageCount: 0, fullTextSupplied: false, charCount: 0
  };
  if (!totalPages) return { text: '', coverage: emptyCoverage };

  var normBlocks = blocks.map(function (b) { return String(b || '').replace(/\s+/g, ' ').trim(); });
  var fullLen = 0;
  for (var fl = 0; fl < totalPages; fl++) if (normBlocks[fl]) fullLen += normBlocks[fl].length + 12;
  if (fullLen > 0 && fullLen <= maxChars) {
    var fullText = [];
    var fullPages = [];
    for (var ap = 0; ap < totalPages; ap++) {
      if (!normBlocks[ap]) continue;
      fullPages.push(ap + 1);
      fullText.push('[Page ' + (ap + 1) + '] ' + normBlocks[ap]);
    }
    return { text: fullText.join('\n\n'), coverage: {
      totalPages: totalPages, suppliedPages: fullPages, suppliedPageCount: fullPages.length,
      omittedPages: [], omittedPageCount: Math.max(0, totalPages - fullPages.length),
      truncatedPages: [], truncatedPageCount: 0, fullTextSupplied: fullPages.length === totalPages,
      charCount: fullText.join('\n\n').length
    } };
  }

  var priority = {};
  var mark = function (page, rank) {
    page = parseInt(page, 10);
    if (!isFinite(page) || page < 1 || page > totalPages) return;
    if (priority[page] === undefined || rank < priority[page]) priority[page] = rank;
  };
  mark(1, 0);
  var list = Array.isArray(payloadFindings) ? payloadFindings : [];
  for (var i = 0; i < list.length; i++) {
    var f = list[i] || {};
    var pages = Array.isArray(f.pages) && f.pages.length ? f.pages : [f.page];
    for (var j = 0; j < pages.length; j++) {
      var p = parseInt(pages[j], 10);
      if (!isFinite(p) || p < 1) continue;
      mark(p, 10 + i);
      mark(p - 1, 1000 + i);
      mark(p + 1, 1000 + i);
    }
  }
  if (Array.isArray(timeline)) {
    for (var t = 0; t < timeline.length; t++) mark(timeline[t] && timeline[t].page, 2000 + t);
  }
  var capacity = [];
  var capRe = /in (?:my|his|her) capacity as|capacity as (?:a |an )?(?:director|member|trustee|representative|agent)|on behalf of [A-Z]|personal (?:bank |trust )?account|trust account|nominated (?:bank )?account/i;
  for (var cp = 0; cp < totalPages; cp++) {
    if (priority[cp + 1] !== undefined) continue;
    if (capRe.test(normBlocks[cp])) capacity.push(cp + 1);
  }
  for (var cq = 0; cq < capacity.length && cq < 5; cq++) mark(capacity[cq], 3000 + cq);

  var selected = Object.keys(priority).map(Number).sort(function (a, b) {
    return (priority[a] - priority[b]) || (a - b);
  });
  // Two passes (Greensky rerun review fix 1): the pages the findings, quotes and
  // page 1 actually live on (rank < 1000) go across FULL — a truncated finding
  // page is exactly the quote the narrator needs and cannot see. Neighbours,
  // timeline and capacity pages then share what remains at a capped excerpt.
  var FULL_RANK = 1000;
  var core = selected.filter(function (p) { return priority[p] < FULL_RANK; });
  var coreLen = 0;
  for (var cl = 0; cl < core.length; cl++) coreLen += (normBlocks[core[cl] - 1] || '').length + 20;
  // If even the core cannot fit, the core itself is capped — but at a floor that
  // keeps a quoted sentence intact, never the old ~450-char shred.
  var perPageCap = Math.max(1200, Math.floor(maxChars / Math.max(1, selected.length)));
  var chosen = [], supplied = [], truncated = [], used = 0;
  for (var op = 0; op < selected.length && used < maxChars; op++) {
    var pageNo = selected[op];
    var raw = normBlocks[pageNo - 1];
    if (!raw) continue;
    var room = maxChars - used;
    var cap = (priority[pageNo] < FULL_RANK && coreLen <= maxChars * 0.8) ? Math.min(raw.length, room) : Math.min(perPageCap, room);
    if (cap < 120) break;
    var body = raw.length > cap ? raw.slice(0, cap) + ' [page text truncated here for the narrator context budget]' : raw;
    var block = '[Page ' + pageNo + '] ' + body;
    chosen.push({ page: pageNo, block: block });
    supplied.push(pageNo);
    if (raw.length > cap) truncated.push(pageNo);
    used += block.length + 2;
  }
  chosen.sort(function (a, b) { return a.page - b.page; });
  supplied.sort(function (a, b) { return a - b; });
  truncated.sort(function (a, b) { return a - b; });
  var out = chosen.map(function (x) { return x.block; });
  var suppliedSet = {};
  for (var sp = 0; sp < supplied.length; sp++) suppliedSet[supplied[sp]] = true;
  var omitted = [];
  for (var om = 1; om <= totalPages && omitted.length < 120; om++) if (!suppliedSet[om]) omitted.push(om);
  var omittedCount = totalPages - supplied.length;
  var text = out.join('\n\n');
  return { text: text, coverage: {
    totalPages: totalPages, suppliedPages: supplied, suppliedPageCount: supplied.length,
    omittedPages: omitted, omittedPageCount: omittedCount,
    truncatedPages: truncated, truncatedPageCount: truncated.length,
    fullTextSupplied: false, charCount: text.length
  } };
}

// Extract readable text from the technical report's PRE-SEAL bytes (the sealed
// overlay adds certificate text the narrator does not need). This is local
// pdf.js work; the bytes leave the device only inside the bounded narrator
// prompt after the technical report has already been sealed.
async function voTechnicalReportTextForNarrative(pdfBytes, maxChars, maxPages) {
  maxChars = maxChars || VO_HUMAN_TECH_REPORT_CHARS;
  maxPages = maxPages || VO_HUMAN_TECH_REPORT_PAGES;
  var none = { text: '', pageCount: 0, suppliedPages: 0, truncated: false, charCount: 0 };
  if (!pdfBytes || !(pdfBytes.byteLength || pdfBytes.length)) return none;
  var VO_PDFJS_CDN = 'https://unpkg.com/pdfjs-dist@3.11.174/build/';
  var pdfjsSrc = await voOcrLoadScript(
    ['/vendor/pdf.min.js', VO_PDFJS_CDN + 'pdf.min.js'],
    function () { return typeof pdfjsLib !== 'undefined'; }
  );
  try {
    pdfjsLib.GlobalWorkerOptions.workerSrc =
      (pdfjsSrc.indexOf('unpkg.com') !== -1) ? (VO_PDFJS_CDN + 'pdf.worker.min.js') : '/vendor/pdf.worker.min.js';
  } catch (eW) {}
  var pdf = await pdfjsLib.getDocument({ data: pdfBytes.slice ? pdfBytes.slice(0) : pdfBytes }).promise;
  var reportPageCount = pdf.numPages || 0;
  var out = [], used = 0, supplied = 0, truncated = reportPageCount > maxPages;
  var limit = Math.min(reportPageCount, maxPages);
  for (var p = 1; p <= limit && used < maxChars; p++) {
    var page = await pdf.getPage(p);
    var tc = await page.getTextContent();
    var raw = (tc.items || []).map(function (it) { return String((it && it.str) || ''); }).join(' ').replace(/\s+/g, ' ').trim();
    if (!raw) continue;
    var room = maxChars - used;
    var body = raw.length > room ? raw.slice(0, room) + ' [technical report text truncated here for the narrator context budget]' : raw;
    if (raw.length > room) truncated = true;
    out.push('[Report Page ' + p + '] ' + body);
    supplied++;
    used += body.length + 20;
  }
  try { await pdf.destroy(); } catch (eD) {}
  var text = out.join('\n\n');
  return { text: text, pageCount: reportPageCount, suppliedPages: supplied, truncated: truncated, charCount: text.length };
}

// Drive the writer sections one call at a time. Returns everything the PDF
// builder needs. Never throws for a failed section — that section simply
// records generated:false and the builder prints its deterministic twin.
async function aiHumanReport(findings, ctxIn) {
  // Hard ordering rule (founder, 2026-10-11): the narrator sees the record only
  // AFTER the technical report exists under seal. The caller passes that seal's
  // id/hash; without them no AI call is made and no narrative is claimed.
  if (!ctxIn || !ctxIn.technicalSealId || !ctxIn.technicalSha512) {
    var blocked = {};
    for (var bs = 0; bs < VO_HUMAN_WRITER_SECTIONS.length; bs++) blocked[VO_HUMAN_WRITER_SECTIONS[bs]] = { provenance: 'none', reason: 'seal_required' };
    return { sections: blocked, humanFindings: [], model: null, calls: 0, modelAttempts: 0, generated: 0, writerSections: VO_HUMAN_WRITER_SECTIONS.length, recordContext: null, generatedUtc: new Date().toISOString() };
  }
  var ids = voHumanFindingList(findings);
  var fp = ids.findings.map(voHumanPayloadFinding);
  var cp = ids.candidates.map(voHumanPayloadFinding);
  var caseInfo = voCaseDetails();
  var timeline = (ctxIn && ctxIn.timeline && Array.isArray(ctxIn.timeline.events))
    ? ctxIn.timeline.events.slice(0, 40).map(function (e) {
        return { date: String(e.date || ''), who: Array.isArray(e.who) ? e.who.slice(0, 2).join(', ') : String(e.who || ''), what: String(e.evidence || '').slice(0, 240), page: e.page || 0 };
      })
    : [];
  var unread = voHumanUnreadList(ctxIn && ctxIn.unreadPages);
  var lawVerified = voLawVerifiedForNarrative(ctxIn && ctxIn.lawCheck);
  var recordContext = voBuildSealedRecordContext(_pipelineTextBlocks, fp.concat(cp), timeline, VO_HUMAN_RECORD_CHARS);
  var findingsJsonText = String((ctxIn && ctxIn.findingsJsonText) || '').slice(0, VO_HUMAN_FINDINGS_JSON_CHARS);
  var technicalReport = (ctxIn && ctxIn.technicalReport && typeof ctxIn.technicalReport === 'object') ? {
    text: String(ctxIn.technicalReport.text || '').slice(0, VO_HUMAN_TECH_REPORT_CHARS),
    pageCount: parseInt(ctxIn.technicalReport.pageCount, 10) || 0,
    suppliedPages: parseInt(ctxIn.technicalReport.suppliedPages, 10) || 0,
    truncated: ctxIn.technicalReport.truncated === true,
    sealId: String((ctxIn && ctxIn.technicalSealId) || ''),
    sha512: String((ctxIn && ctxIn.technicalSha512) || '')
  } : null;
  var startedAt = Date.now();
  var sections = {};
  var model = null, calls = 0, generated = 0, modelAttempts = 0;
  var priorSummary = '';
  var rawList = ids.findings.map(function (x) { return x.f; });
  var progress = (ctxIn && typeof ctxIn.onProgress === 'function') ? ctxIn.onProgress : function () {};

  // Which findings a section needs (keeps each excerpt centred on the right pages).
  // null = nothing in the record engages the section; the PDF prints the
  // deterministic twin under its own words, so the call is not made.
  function subsetFor(section, batch) {
    if (section === 'critical_evidence') return batch;
    if (section === 'sworn_statements') { var sw = fp.filter(function (x) { return x.sworn; }); return sw.length ? sw : null; }
    if (section === 'coercive_conduct') {
      var co = fp.filter(function (x) { return /coerc|threat|intimidat|duress|silenc|pressur|extort|blackmail/i.test(x.evidence + ' ' + x.name); });
      return co.length ? co : null;
    }
    return fp.slice(0, 25);
  }
  function excerptFor(subset) {
    try {
      if (_pipelineTextBlocks && _pipelineTextBlocks.length) {
        var raw = subset.map(function (x) { var i = parseInt(x.id.slice(1), 10) - 1; return rawList[i]; }).filter(Boolean);
        return voBuildNarrateExcerpt(_pipelineTextBlocks, raw, VO_HUMAN_EXCERPT_CHARS);
      }
    } catch (e) {}
    return _pipelineTextSample ? String(_pipelineTextSample).slice(0, VO_HUMAN_EXCERPT_CHARS) : '';
  }
  async function callSection(section, subset) {
    var payload = {
      section: section,
      documentName: (typeof selectedFile !== 'undefined' && selectedFile && selectedFile.name) ? selectedFile.name : 'sealed document',
      pageCount: _pipelinePageCount || 0,
      findings: subset,
      candidates: cp,
      timeline: timeline,
      unreadPages: unread,
      excerpt: excerptFor(subset),
      sealedRecord: recordContext,
      findingsJson: findingsJsonText,
      technicalReport: technicalReport,
      priorSummary: priorSummary
    };
    if (caseInfo.caseName || caseInfo.caseRefs || caseInfo.parties || caseInfo.jurisdiction) payload.caseContext = caseInfo;
    if (section === 'legal_framework') payload.lawVerified = lawVerified;
    calls++;
    var res = await aiApiPost('/api/v1/ai/human-report', payload, VO_HUMAN_CALL_TIMEOUT_MS);
    if (!res || typeof res !== 'object' || res.contract !== 'human-v1') return { provenance: 'none', reason: 'invalid_response' };
    // attempts are model drafts inside the endpoint call (the worker can run
    // one bounded repair/expansion pass); calls stay section requests.
    var resAttempts = Math.max(1, Math.min(2, parseInt(res.attempts, 10) || 1));
    modelAttempts += resAttempts;
    var resDiscarded = Math.max(0, Math.min(2, parseInt(res.discardedDrafts, 10) || 0));
    var resDiscardedDropped = Math.max(0, parseInt(res.discardedDropped, 10) || 0);
    if (res.generated === true && res.machineGenerated === true && typeof res.text === 'string' && res.text.trim()) {
      generated++;
      if (!model) model = res.model || null;
      return { provenance: 'ai', text: res.text, plainTerms: res.plainTerms || {}, gate: res.gate || null, model: res.model || null,
        pageContradictions: Array.isArray(res.pageContradictions) ? res.pageContradictions.slice(0, 40).map(function (s) { return String(s || '').slice(0, 500); }).filter(Boolean) : [],
        attempts: resAttempts, discarded: resDiscarded, discardedDropped: resDiscardedDropped, repair: res.repair || null };
    }
    return { provenance: 'none', reason: res.reason || 'not_generated', gate: res.gate || null, model: res.model || null,
      attempts: resAttempts, discarded: resDiscarded, discardedDropped: resDiscardedDropped, repair: res.repair || null };
  }

  var total = VO_HUMAN_WRITER_SECTIONS.length + Math.max(0, Math.ceil(fp.length / VO_HUMAN_CRITICAL_BATCH) - 1);
  var step = 0;
  // Name the failure the way the report will print it. An HTML answer where
  // JSON was expected means the page was served by a host that has no API
  // (the 7 September Greensky run: www was the Pages project) — say so,
  // never "network".
  var failReason = function (e) {
    if (e && e.name === 'AbortError') return 'timeout';
    var m = String((e && e.message) || '');
    if ((e && e.name === 'SyntaxError') || /JSON|Unexpected token|returned HTTP 404|returned HTTP 405/.test(m)) return 'no_api_at_this_address';
    return 'network';
  };
  var overBudget = function () { return (Date.now() - startedAt) > VO_HUMAN_TOTAL_BUDGET_MS; };
  for (var s = 0; s < VO_HUMAN_WRITER_SECTIONS.length; s++) {
    var section = VO_HUMAN_WRITER_SECTIONS[s];
    if (overBudget()) { step++; sections[section] = { provenance: 'none', reason: 'time_budget' }; continue; }
    if (section === 'critical_evidence') {
      var merged = { provenance: 'none', reason: 'not_generated', text: '', plainTerms: {}, gate: { kept: 0, dropped: 0 }, pageContradictions: [], attempts: 0, discarded: 0, discardedDropped: 0 };
      var anyAi = false, texts = [];
      for (var b = 0; b < fp.length; b += VO_HUMAN_CRITICAL_BATCH) {
        step++; progress(step, total, section);
        if (overBudget()) { if (!anyAi && merged.reason !== 'gate_failed') merged.reason = 'time_budget'; continue; }
        var batch = fp.slice(b, b + VO_HUMAN_CRITICAL_BATCH);
        var r;
        // one failed batch never discards the batches already written
        try { r = await callSection(section, batch); }
        catch (bErr) { console.warn('[VO-HUMAN] batch failed:', section, b, bErr && bErr.message ? bErr.message : bErr); r = { provenance: 'none', reason: failReason(bErr) }; }
        if (r.provenance === 'ai') {
          anyAi = true;
          texts.push(r.text);
          Object.keys(r.plainTerms || {}).forEach(function (k) { merged.plainTerms[k] = r.plainTerms[k]; });
          (r.pageContradictions || []).forEach(function (s) { if (s && merged.pageContradictions.indexOf(s) < 0 && merged.pageContradictions.length < 40) merged.pageContradictions.push(s); });
          if (r.gate) { merged.gate.kept += r.gate.kept || 0; merged.gate.dropped += r.gate.dropped || 0; }
          merged.attempts += r.attempts || 1;
          merged.discarded += r.discarded || 0;
          merged.discardedDropped += r.discardedDropped || 0;
          merged.model = r.model;
        } else {
          // A batch the server's gate discarded whole is counted, so the
          // provenance record does not undercount the gate. With a repair pass
          // a section can have discarded two drafts before reporting failure.
          var disc = r.discarded || 0;
          if (r.reason === 'gate_failed') disc = Math.max(1, disc);
          merged.attempts += r.attempts || 0;
          merged.discarded += disc;
          merged.discardedDropped += (r.discardedDropped || 0) + (disc && !r.discardedDropped && r.gate ? (r.gate.dropped || 0) : 0);
          if (!merged.reason || merged.reason === 'not_generated') merged.reason = r.reason;
        }
      }
      if (anyAi) { merged.provenance = 'ai'; merged.text = texts.join('\n\n'); delete merged.reason; }
      sections[section] = merged;
      if (!fp.length) { step++; }
      continue;
    }
    step++; progress(step, total, section);
    var subset = subsetFor(section, null);
    if (!subset) { sections[section] = { provenance: 'none', reason: 'not_applicable' }; continue; }
    try {
      var one = await callSection(section, subset);
      sections[section] = one;
      if (section === 'executive_summary' && one.provenance === 'ai') priorSummary = String(one.text).slice(0, 1500);
    } catch (secErr) {
      console.warn('[VO-HUMAN] section failed:', section, secErr && secErr.message ? secErr.message : secErr);
      sections[section] = { provenance: 'none', reason: failReason(secErr) };
    }
  }
  return {
    sections: sections,
    humanFindings: ids.findings,
    model: model,
    calls: calls,
    modelAttempts: modelAttempts,
    generated: generated,
    writerSections: VO_HUMAN_WRITER_SECTIONS.length,
    recordContext: {
      totalPages: recordContext.coverage.totalPages,
      suppliedPageCount: recordContext.coverage.suppliedPageCount,
      truncatedPageCount: recordContext.coverage.truncatedPageCount,
      omittedPageCount: recordContext.coverage.omittedPageCount,
      fullTextSupplied: recordContext.coverage.fullTextSupplied === true,
      findingsJsonSupplied: findingsJsonText.length > 0,
      technicalReportSupplied: !!(technicalReport && technicalReport.text),
      technicalReportPageCount: technicalReport ? technicalReport.pageCount : 0,
      technicalReportSuppliedPages: technicalReport ? technicalReport.suppliedPages : 0,
      technicalReportTruncated: !!(technicalReport && technicalReport.truncated)
    },
    generatedUtc: new Date().toISOString()
  };
}

// B7 triple legal verification (founder ruling 2026-10-11): the candidate
// statutes the report will name are checked by the worker's
// /api/v1/ai/verify-law lanes (Workers AI + Mistral + DeepSeek, quorum 2/3)
// BEFORE the court-ready narrative renders. Only VERIFIED statutes are cited;
// DISPUTED/UNVERIFIED go to the report's exclusion annex with the
// contact-a-lawyer direction. The candidates are the same deterministic
// statutesForFinding provisions the Statutory Anchoring annex prints; the
// contextHash is the SHA-512 of the findings JSON, anchoring the check to the
// exact record the report seals. Returns null on ANY failure (offline, no API,
// timeout): the report then claims no lane verification and keeps the standing
// not-legal-advice disclaimer.
async function aiVerifyLaw(fraudRes, contextHash) {
  try {
    if (typeof window.VerumReport === 'undefined' || typeof window.VerumReport._statutesForFinding !== 'function' || typeof window.VerumReport._detectJurisdictions !== 'function') return null;
    var ci = voCaseDetails();
    var jur = window.VerumReport._detectJurisdictions({ findings: fraudRes, identity: { jurisdiction: ci.jurisdiction || '' } });
    var seen = {}, cands = [];
    var list = (fraudRes && Array.isArray(fraudRes.findings)) ? fraudRes.findings : [];
    for (var i = 0; i < list.length && cands.length < 12; i++) {
      var f = list[i];
      if (!f || f.source === 'ai') continue;   // candidates stay candidates: their law is not cited either
      var sfl;
      try { sfl = window.VerumReport._statutesForFinding(f, jur); } catch (e) { continue; }
      for (var k = 0; k < (sfl || []).length && cands.length < 12; k++) {
        var provs = (sfl[k] && sfl[k].provisions) || [];
        for (var p = 0; p < provs.length && cands.length < 12; p++) {
          var name = String(typeof provs[p] === 'string' ? provs[p] : '').trim();
          // "No specific statute asserted" and pure evidentiary pointers are
          // not citations — there is nothing for a lane to confirm.
          if (!name || /^evidentiary\b/i.test(name)) continue;
          var key = name.toLowerCase();
          if (seen[key]) continue;
          seen[key] = true;
          // "Companies Act 71 of 2008 - s76 (...); s214 (...)" splits into one
          // candidate per provision. A fragment that names no statute of its
          // own (a bare "s214/s215" section, a trailing "misrepresentation"
          // gloss) is a CONTINUATION of the previous statute, never a statute
          // name — sending it as one makes the lanes reject a word, which the
          // report would then print as a DISPUTED "law".
          var VO_LAW_NAME_RE = /act\b|law\b|code\b|common-law|decree|directive|gdpr|uncac|untoc|rico|\busc\b|penal|evidence law/i;
          var parts = name.split(/\s*;\s*/);
          var lastStatute = '';
          for (var q = 0; q < parts.length && cands.length < 12; q++) {
            var part = parts[q].trim();
            if (!part) continue;
            var m = /^(.+?)(?:\s+-\s+((?:ss?|ch(?:apter)?)\s?[0-9][^(]*|art(?:icle)?\.?\s?[0-9][^(]*)(\((.*)\))?)?$/i.exec(part);
            var head = (m && m[1] ? m[1] : part).trim();
            var statute, section, claim;
            if (VO_LAW_NAME_RE.test(head)) {
              statute = head.slice(0, 200);
              lastStatute = statute;
              section = (m && m[2] ? m[2] : '').trim().slice(0, 60);
              claim = (m && m[4] ? m[4] : 'candidate provision for the anchored findings').trim().slice(0, 200);
              // Uncodified law is named for the lanes (founder ruling 2026-10-11,
              // "broad"): common-law fraud IS the fraud law — the lane confirms
              // recognition in the jurisdiction, not a statute number.
              if (/^common[ -]law/i.test(statute)) claim = ('uncodified common-law crime or principle: ' + claim).slice(0, 200);
            } else if (lastStatute) {
              statute = lastStatute;
              var secM = /^((?:ss?|ch(?:apter)?)\s?\d+(?:\/s?\d+)?(?:-\d+)?[a-z]?|art(?:icle)?\.?\s?\d+)/i.exec(head);
              section = secM ? secM[0].trim().slice(0, 60) : '';
              claim = part.replace(/^(?:ss?|ch(?:apter)?)\s?\d+(?:\/s?\d+)?(?:-\d+)?[a-z]?\s*/i, '').replace(/^\(|\)$/g, '').trim().slice(0, 200) || 'candidate provision for the anchored findings';
            } else {
              continue;   // a fragment with no statute anywhere: nothing to verify
            }
            if (seen['~' + statute.toLowerCase() + '|' + section.toLowerCase()]) continue;
            seen['~' + statute.toLowerCase() + '|' + section.toLowerCase()] = true;
            cands.push({ statute: statute, section: section, claim: claim });
          }
        }
      }
    }
    if (!cands.length) return null;
    var payload = { jurisdiction: [jur.home].concat(jur.foreign).join('+'), candidates: cands };
    if (contextHash && /^[0-9a-f]{128}$/i.test(contextHash)) payload.contextHash = contextHash.toLowerCase();
    var res = await aiApiPost('/api/v1/ai/verify-law', payload, VO_HUMAN_CALL_TIMEOUT_MS);
    if (!res || res.ok !== true || !Array.isArray(res.results)) return null;
    // Pass through only the fields the report prints, sanitized to the fixed
    // vocabulary — the wire answer is data, never trusted prose.
    return {
      declaration: String(res.declaration || '').slice(0, 300),
      disclaimer: String(res.disclaimer || '').slice(0, 300),
      direction: res.direction ? String(res.direction).slice(0, 300) : null,
      results: res.results.slice(0, 12).map(function (r) {
        return {
          statute: String(r && r.statute || '').slice(0, 200),
          section: String(r && r.section || '').slice(0, 60),
          status: (r && (r.status === 'VERIFIED' || r.status === 'DISPUTED')) ? r.status : 'UNVERIFIED',
          lanes: Array.isArray(r && r.lanes) ? r.lanes.slice(0, 3).map(function (l) {
            return { lane: String(l && l.lane || '').slice(0, 4), verdict: (l && (l.verdict === 'CONFIRMS' || l.verdict === 'REJECTS')) ? l.verdict : 'NOT_RUN' };
          }) : []
        };
      })
    };
  } catch (e) {
    console.warn('[VO-LAW] verification unavailable (report unaffected):', e && e.message ? e.message : e);
    return null;
  }
}

// Classify: triage call made BEFORE/WHILE the engine runs. Returns a normalised
// { documentClass, confidence, aboutFraud, recommendedScope, model } or null on
// ANY failure (endpoint not deployed yet, timeout, malformed body). textSample is
// hard-capped at 4000 chars client-side and is only ever sent when AI review is on.
async function aiClassifyDocument(textSample, pageCount) {
  var pc = parseInt(pageCount, 10);
  if (!isFinite(pc) || pc < 0) pc = 0;
  var res = await aiApiPost('/api/v1/ai/classify', { textSample: String(textSample || '').slice(0, 4000), pageCount: pc }, 10000);
  if (!res || typeof res !== 'object') return null;
  var dc = (typeof res.documentClass === 'string' && res.documentClass.trim()) ? res.documentClass.trim().slice(0, 120) : null;
  if (dc) dc = dc.replace(/_/g, ' ').replace(/\b\w/g, function(ch) { return ch.toUpperCase(); }); // 'court_filing' -> 'Court Filing'
  var out = {
    documentClass: dc,
    confidence: (typeof res.confidence === 'string' && res.confidence.trim()) ? res.confidence.trim().slice(0, 40) : (isFinite(res.confidence) ? res.confidence : null),
    aboutFraud: res.aboutFraud === true,
    recommendedScope: (typeof res.recommendedScope === 'string') ? res.recommendedScope.slice(0, 60) : null,
    model: (typeof res.model === 'string') ? res.model.slice(0, 80) : null
  };
  if (!out.documentClass && !out.aboutFraud) return null; // nothing usable returned
  return out;
}

// Deterministic classification fallback. The AI classifier returned
// "Other (confidence: low)" on an obvious legal case file (an MOA, a SAPS case
// number, annexures, named parties) — a failed front page for the report.
// These rule-based signals run entirely on-device: they replace a missing or
// low-value AI answer, and cost nothing when the AI answer is good.
/* VO-RULE-CLASSIFY:START */
function voRuleClassify(sample) {
  var t = String(sample || '').toLowerCase();
  if (!t) return null;
  var signals = [
    /memorandum of association|articles of association|shareholders?'? agreement|founding statement/,
    /affidavit|deponent|commissioner of oaths|sworn statement/,
    /\bsaps\b|\bcas\s*\d|case\s+(?:no\.?|number)|court\s+file|\brakez\b/,
    /annexure|\bexhibit\s+[a-z0-9]/,
    /plaintiff|defendant|respondent|applicant|accused|complainant/,
    /attorney|advocate|counsel|law\s+firm|legal\s+practitioner/,
    /shareholder|director|fiduciary|resolution/,
    /agreement|contract|memorandum/
  ];
  var hits = 0;
  for (var i = 0; i < signals.length; i++) { if (signals[i].test(t)) hits++; }
  if (hits < 4) return null;
  return {
    documentClass: 'Legal Case File / Dispute Records',
    confidence: 'medium (rule-based)',
    aboutFraud: /\bfraud|forg(?:ed|ery)|fabricat/.test(t),
    recommendedScope: null,
    model: 'vo-rules-v1',
    ruleBased: true
  };
}
// Prefer the AI answer when it says something; fall back to the on-device
// rules when the AI is unavailable, empty, "Other", or low-confidence.
function voReconcileClassification(ai, sample) {
  var weak = !ai || !ai.documentClass ||
    /^other$/i.test(String(ai.documentClass).trim()) ||
    /^low$/i.test(String(ai.confidence == null ? '' : ai.confidence).trim());
  if (!weak) return ai;
  return voRuleClassify(sample) || ai;
}
/* VO-RULE-CLASSIFY:END */

// Serial-pattern label corroboration. A serial-pattern LABEL (e.g. "Advance Fee
// Fraud (419)") is displayed only when corroborated by >= 2 independent engine
// findings of severity >= 3 (the engine's upper severity tiers); otherwise the
// pattern is demoted to a muted "weak signals" note. When the AI classifier says
// the document is ABOUT fraud (court filing, complaint, etc.), labels are
// suppressed entirely. Findings themselves are always kept — only the labels move.
function getSerialLabelInfo(findings, suppressAll) {
  var serial = [], support = 0;
  var list = Array.isArray(findings) ? findings : [];
  for (var i = 0; i < list.length; i++) {
    var f = list[i] || {};
    if (f.type === 'SERIAL') { serial.push(f); continue; }
    var sev = parseInt(f.severity, 10);
    if (isFinite(sev) && sev >= 3) support++;
  }
  var info = { serial: serial, corroborated: [], weak: [], suppressed: suppressAll === true, supportCount: support };
  if (serial.length === 0) return info;
  if (!info.suppressed && support >= 2) info.corroborated = serial;
  else info.weak = serial;
  return info;
}
function serialNameOf(f) { return (f && (f.serialName || f.serialPattern)) || 'Serial pattern'; }

// A document with user-entered case details is a legal case file: a bundle
// ABOUT allegations. Its text naturally contains the vocabulary of the
// offences it describes ("compensation", "urgent", "payroll", "cash"), so
// keyword-matched serial-pattern LABELS ("419 Scam", "Money Laundering")
// reflect the subject matter, not the document's own conduct — exactly the
// aboutFraud rationale, extended to court bundles. Labels are suppressed;
// the underlying findings stay in the report as multi-stage indicators.
function voIsLegalCaseFile() {
  var ci = voCaseDetails();
  return !!(ci.caseName || ci.caseRefs || ci.parties || ci.jurisdiction);
}

// ==================== BUNDLE MODE (legal case files) ====================
// A compiled court bundle is many documents bound as one PDF. Detectors that
// assume ONE homogeneous document then misfire by design: internal page
// numbers repeat (CT27), common terms appear "defined" twice (CT08), both
// halves of every temporal word-pair occur somewhere in 500 pages (CT04),
// hundreds of addresses are normal (CT36), and per-document formalities /
// annexure references (CT35, CT31) span documents. Bundle mode demotes those
// STRUCTURAL indicators to severity 2 (Low) and recomputes the indicator
// score, so the report leads with the real contradictions (numerical, date,
// identity, financial) instead of 30 page-numbering notes. Nothing is
// removed: every finding stays in the report, marked as demoted, and the
// demotion itself is disclosed in the extraction notes (Prime Directive 6).
// CT35 is deliberately NOT here: since D23 was tightened it only fires on an
// EXPLICIT breach stated in the text ("never countersigned") — a substantive
// assertion in the record, not an artifact of compiling documents into a
// bundle. Demoting it buried the AllFuels no-counter-signature finding at LOW.
var VO_BUNDLE_STRUCTURAL = { CT04: 1, CT08: 1, CT27: 1, CT31: 1, CT36: 1 };

// A compiled bundle is recognisable from its own findings even when the user
// typed no case details: concatenating many documents makes internal page
// numbers repeat, so the CT27 "page number appears on multiple pages" detector
// fires several times. Combined with a large page count that is the signature
// of a bound bundle. Auto-detecting it means a 528-page evidence bundle sealed
// without case details still gets structural indicators demoted, instead of
// leading the report with 27 page-numbering "HIGH" findings.
function voLooksLikeBundle(result) {
  var pages = _pipelinePageCount | 0;
  if (pages < 50) return false;
  var dupPageNumbers = 0;
  var fs = result.findings;
  for (var i = 0; i < fs.length; i++) {
    if (fs[i] && fs[i].type === 'CT27' && /appears on multiple pages/i.test(String(fs[i].evidence || ''))) dupPageNumbers++;
  }
  return dupPageNumbers >= 3;
}

function applyBundleMode(result) {
  if (!result || result.scanFailed || !Array.isArray(result.findings)) return result;
  var autoBundle = voLooksLikeBundle(result);
  if (!voIsLegalCaseFile() && !autoBundle) return result;
  var demoted = 0;
  var findings = result.findings.map(function (f) {
    if (!f || f.type === 'SERIAL' || !VO_BUNDLE_STRUCTURAL[f.type]) return f;
    if ((f.severity | 0) <= 2) return f;
    var c = Object.assign({}, f);
    c.severity = 2;
    c.bundleDemoted = true;
    c.evidence = (c.evidence || '') + ' [bundle context: structural finding demoted — expected in a compiled multi-document case file]';
    demoted++;
    return c;
  });
  if (!demoted) return result;
  var total = 0;
  // Keep the recompute confidence-weighted, matching the engine's scoring —
  // an unweighted recompute here would silently undo the calibration.
  for (var i = 0; i < findings.length; i++) {
    var cw = (typeof findings[i].confidence === 'number') ? findings[i].confidence : 0.75;
    total += (findings[i].severity | 0) * cw;
  }
  var score = findings.length ? Math.round((total / (findings.length * 5)) * 100) : 0;
  var confidence = score >= 80 ? 'VERY_HIGH' : score >= 60 ? 'HIGH' :
                   score >= 40 ? 'MODERATE' : score >= 20 ? 'LOW' : 'CLEAN';
  return Object.assign({}, result, {
    findings: findings,
    overallScore: score,
    confidence: confidence,
    clean: score < 20,
    bundleMode: { applied: true, demoted: demoted, auto: autoBundle && !voIsLegalCaseFile() },
    summary: (typeof generateSummary === 'function') ? generateSummary(findings, score) : result.summary,
    extractionNotes: (((result.extractionNotes || '') + ' Bundle mode: this is a compiled multi-document case file (' +
      (voIsLegalCaseFile() ? 'case details supplied' : 'detected automatically from ' + (_pipelinePageCount | 0) + ' pages with repeated internal page numbers') + '), so ' + demoted +
      ' structural finding' + (demoted === 1 ? '' : 's') + ' (repeated internal page numbers, term/temporal-language repetition, address counts, per-document formalities and annexure references) ' +
      (demoted === 1 ? 'was' : 'were') + ' demoted to the end of the engine\'s order. Contradiction, date, identity and financial findings are unaffected.').trim())
  });
}

// UI-owned OCR progress reporter. Wall-clock time may not enter the analysis
// path (AGENTS.md: no Date.now() in analysis paths), but a 100+-page OCR run
// with no time estimate reads as hung — so the clock and the remaining-time
// arithmetic live HERE, in page UI code, and the rescue hook below reports
// pure counts only. Reset per run via voOcrProgressReset().
var _voOcrPaceT0 = null;
function voOcrProgressReset() { _voOcrPaceT0 = null; }
function voOcrProgress(pageIdx, done, total, workerCount) {
  var eta = '';
  if (_voOcrPaceT0 === null) _voOcrPaceT0 = Date.now();
  if (done >= 2) {
    var s = Math.round(((Date.now() - _voOcrPaceT0) / done) * (total - done) / 1000);
    if (s >= 90) eta = ', ~' + Math.round(s / 60) + ' min left';
    else if (s >= 5) eta = ', ~' + s + 's left';
  }
  updateStep('Fraud', 'processing', 'OCR page ' + (pageIdx + 1) + ' done (' + done + '/' + total +
    ', on-device, ' + workerCount + ' worker' + (workerCount === 1 ? '' : 's') + eta + ')...');
}

// ==================== OCR RESCUE (image-only pages) ====================
// Pages with no text layer (scanned exhibits, photographed emails) are
// invisible to every detector — and they are often the critical evidence.
// This helper OCRs the worst offenders ON-DEVICE with vendored tesseract.js:
// no cloud call, nothing leaves the browser, consistent with the privacy
// model. Called by runForensicEngine via the voOcrRescuePages hook; any
// failure is disclosed in the extraction notes and the scan continues.
var VO_OCR_MAX_PAGES = 200;     // cap: OCR is ~seconds/page on-device. Raised from
                                // 15 so scanned legal bundles (e.g. 171 image-only
                                // pages) are actually read; the progress UI shows
                                // per-page status, and anything beyond the cap is
                                // still disclosed in the extraction notes.
// DRIFT-LOCK: this must stay >= the CT26 near-empty threshold in
// forensic-engine-page.js (lens[i] < 40). It was 30 while CT26 flagged < 40, so
// pages carrying 30-39 chars were reported as "near-empty ... most likely
// image-only pages not captured by OCR" while OCR never even attempted them —
// the engine named a gap it had chosen not to close. The Greensky rerun
