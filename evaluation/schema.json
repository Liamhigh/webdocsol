{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verumglobal.foundation/schemas/development-evaluation-v1.json",
  "title": "Verum Omnis development evaluation input",
  "description": "B9 development/CI evaluation only. UTF-16 code-unit offsets; never a production findings schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest", "cases"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "manifest": { "$ref": "#/$defs/EvaluationManifest" },
    "cases": { "type": "array", "items": { "$ref": "#/$defs/EvaluationCase" } }
  },
  "$defs": {
    "EvaluationManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "dataset_revision", "dataset_sha512", "dataset_license", "evaluator_revision", "engine_commit", "ruleset", "options", "reference_time", "code_version"],
      "properties": {
        "dataset_id": { "type": "string", "minLength": 1 },
        "dataset_revision": { "type": "string", "minLength": 1, "description": "Pinned upstream revision or explicit synthetic-fixture revision." },
        "dataset_sha512": { "type": "string", "pattern": "^[0-9a-f]{128}$" },
        "dataset_license": { "type": "string", "minLength": 1 },
        "evaluator_revision": { "type": "string", "minLength": 1 },
        "engine_commit": { "type": "string", "minLength": 1 },
        "ruleset": { "type": "string", "minLength": 1 },
        "options": { "type": "object", "description": "Complete deterministic evaluation options; no rollout sampling or telemetry." },
        "reference_time": { "type": "string", "minLength": 1 },
        "code_version": { "type": "string", "minLength": 1 }
      }
    },
    "EvaluationCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "document_id", "source_text", "expected_contradictions", "actual_findings"],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "document_id": { "type": "string", "minLength": 1 },
        "source_text": { "type": "string", "description": "Original text, preserved exactly. Actual anchor offsets address this string." },
        "normalization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "normalized_text", "normalized_to_original"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "description": "Recorded transformation; trimming is not implicit." },
            "normalized_text": { "type": "string", "description": "Dataset-normalized text. Expected offsets address this string." },
            "normalized_to_original": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "integer", "minimum": 0 },
              "description": "Monotonic source boundary for every normalized UTF-16 boundary, including the final boundary."
            }
          }
        },
        "expected_contradictions": { "type": "array", "items": { "$ref": "#/$defs/ExpectedContradiction" } },
        "actual_findings": { "type": "array", "items": { "$ref": "#/$defs/ActualFinding" } },
        "exclusion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason"],
          "properties": { "reason": { "type": "string", "minLength": 1 } },
          "description": "Excluded cases remain visible in coverage and never silently disappear."
        }
      }
    },
    "ExpectedContradiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contradiction_id", "rule_id", "scope", "evidence_spans"],
      "properties": {
        "contradiction_id": { "type": "string", "minLength": 1 },
        "rule_id": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1, "description": "Dataset scope label; cross-dataset mappings belong in adapters." },
        "pair_mode": { "enum": ["ordered", "unordered"], "default": "ordered" },
        "evidence_spans": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ExpectedEvidenceSpan" } }
      }
    },
    "ExpectedEvidenceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["span_id", "start", "end", "quote", "page"],
      "properties": {
        "span_id": { "type": "string", "minLength": 1 },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 },
        "quote": { "type": "string", "description": "Exact untrimmed normalized_text.slice(start, end)." },
        "page": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }], "description": "Null unless a genuine, separately audited page mapping exists." }
      }
    },
    "ActualFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "rule_id", "scope", "anchors"],
      "properties": {
        "finding_id": { "type": "string", "minLength": 1 },
        "rule_id": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "anchors": { "type": "array", "items": { "$ref": "#/$defs/ActualEvidenceAnchor" } }
      }
    },
    "ActualEvidenceAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_id", "start", "end", "quote", "page"],
      "properties": {
        "anchor_id": { "type": "string", "minLength": 1 },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 },
        "quote": { "type": "string", "description": "Exact untrimmed source_text.slice(start, end)." },
        "page": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] }
      }
    }
  }
}
