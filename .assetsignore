# Files in the repo root that are NOT part of the public website.
# Workers Static Assets uploads everything in [assets] directory ("./")
# except what this file matches (gitignore syntax).
.git
.github/
.gitignore
.assetsignore
worker/
tests/
node_modules/
package.json
package-lock.json
wrangler.toml
*.md
# Brand source assets (app icon, banners) and the portable sealing spec's
# page snapshots are repository material, not site files.
brand/
seal-module/
# Test fixtures live in the repo for the suite, not for serving at the domain.
# No site page references them (tests/site-serving.test.mjs checks every page).
greensky-ocr-verify.pdf
forensic_test_document.pdf
